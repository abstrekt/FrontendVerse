opened" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="590" y="430" width="196" height="26" as="geometry"/></mxCell><mxCell id="t-49" value="A deploy invalidates only the chunks that changed — that is the point of the split." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="416" y="462" width="380" height="20" as="geometry"/></mxCell><mxCell id="b-50" value="Dev and production are two different pipelines: the dev server skips bundling, minification and tree shaking entirely. That is why &amp;quot;works in dev, broken in the build&amp;quot; is nearly always a side effect that tree shaking removed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="500" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>