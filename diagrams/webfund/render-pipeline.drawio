ell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="338" y="174" as="sourcePoint"/><mxPoint x="376" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="&lt;b&gt;Render tree&lt;/b&gt;&lt;br/&gt;only what is visible&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;display:none&lt;/span&gt; → absent&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;visibility:hidden&lt;/span&gt; → present" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="380" y="96" width="150" height="100" as="geometry"/></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="532" y="146" as="sourcePoint"/><mxPoint x="558" y="146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-14" value="&lt;b&gt;Layout&lt;/b&gt;&lt;br/&gt;geometry in&lt;br/&gt;real pixels&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;%&lt;/span&gt; → px" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="562" y="96" width="112" height="100" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676" y="146" as="sourcePoint"/><mxPoint x="700" y="146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="&lt;b&gt;Paint&lt;/b&gt;&lt;br/&gt;fill in&lt;br/&gt;pixels,&lt;br/&gt;per layer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="704" y="96" width="92" height="100" as="geometry"/></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="198" as="sourcePoint"/><mxPoint x="750" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-18" value="&lt;b&gt;Composite&lt;/b&gt; — assemble the layers, on the GPU where it can" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="380" y="218" width="416" height="34" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="268" as="sourcePoint"/><mxPoint x="796" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-20" value="2 · What re-runs when you change one property" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="278" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-21" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;width&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;top&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;font-size&lt;/span&gt;&lt;br/&gt;adding a node" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="306" width="210" height="38" as="geometry"/></mxCell><mxCell id="b-22" value="Layout" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="306" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-23" value="Paint" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="306" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-24" value="Composite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="620" y="306" width="174" height="38" as="geometry"/></mxCell><mxCell id="t-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;color&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;background&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;box-shadow&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="350" width="210" height="38" as="geometry"/></mxCell><mxCell id="b-26" value="skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="350" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-27" value="Paint" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="350" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-28" value="Composite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="620" y="350" width="174" height="38" as="geometry"/></mxCell><mxCell id="t-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;transform&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;opacity&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="394" width="210" height="38" as="geometry"/></mxCell><mxCell id="b-30" value="skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="394" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-31" value="skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="394" width="174" height="38" as="geometry"/></mxCell><mxCell id="b-32" value="Composite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="620" y="394" width="174" height="38" as="geometry"/></mxCell><mxCell id="t-33" value="Sixty frames a second is 16.7 ms per frame. A layout pass over a large tree does not fit in it; a composite does." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="444" width="772" height="14" as="geometry"/></mxCell><mxCell id="b-34" value="&lt;b&gt;The preload scanner&lt;/b&gt; races ahead while the parser is blocked and starts downloading anything it can see — but it only reads &lt;i&gt;markup&lt;/i&gt;. A font named inside a stylesheet, or a chunk imported by JavaScript, is invisible to it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="468" width="772" height="40" as="geometry"/></mxCell><mxCell id="b-35" value="CSS blocks the paint and a synchronous script blocks the parse — and a script that reads layout ends up blocked on the CSS too. Animate &lt;span style=&quot;font-family: Courier New&quot;&gt;transform&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;opacity&lt;/span&gt; because they skip the two expensive stages entirely." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="518" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>