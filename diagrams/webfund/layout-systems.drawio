<mxfile host="app.diagrams.net" type="device"><diagram name="Flow, flex and grid — the same content, three systems" id="Flow, flex and grid — the same content, three systems"><mxGraphModel dx="820" dy="580" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="580" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Flow, flex and grid — the same six boxes, three systems" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The question that decides it: do the items in the other direction have to line up?" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Flow" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A0B8;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="82" width="252" height="262" as="geometry"/></mxCell><mxCell id="b-4" value="heading" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="118" width="224" height="46" as="geometry"/></mxCell><mxCell id="b-5" value="paragraph" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="172" width="224" height="30" as="geometry"/></mxCell><mxCell id="b-6" value="paragraph" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="206" width="224" height="30" as="geometry"/></mxCell><mxCell id="b-7" value="figure" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="240" width="224" height="38" as="geometry"/></mxCell><mxCell id="t-8" value="Blocks stack, inline content flows, margins collapse. Still the right answer for a document." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="296" width="224" height="38" as="geometry"/></mxCell><mxCell id="p-9" value="Flex — one axis" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="284" y="82" width="252" height="262" as="geometry"/></mxCell><mxCell id="b-10" value="item 1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="298" y="118" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-11" value="item 2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="376" y="118" width="54" height="34" as="geometry"/></mxCell><mxCell id="b-12" value="item 3" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="438" y="118" width="92" height="34" as="geometry"/></mxCell><mxCell id="b-13" value="item 4" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="298" y="162" width="92" height="34" as="geometry"/></mxCell><mxCell id="b-14" value="item 5" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="398" y="162" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-15" value="item 6" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="476" y="162" width="54" height="34" as="geometry"/></mxCell><mxCell id="t-16" value="Items size themselves, then the leftover space is distributed. Row two does &lt;b&gt;not&lt;/b&gt; line up with row one." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="298" y="206" width="224" height="30" as="geometry"/></mxCell><mxCell id="t-17" value="A toolbar, a chip list, a card footer — anything that is one row or one column." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="298" y="296" width="224" height="38" as="geometry"/></mxCell><mxCell id="p-18" value="Grid — two axes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="544" y="82" width="252" height="262" as="geometry"/></mxCell><mxCell id="b-19" value="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="558" y="118" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-20" value="2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="634" y="118" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-21" value="3" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="710" y="118" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-22" value="4" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="558" y="162" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-23" value="5" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="634" y="162" width="70" height="34" as="geometry"/></mxCell><mxCell id="b-24" value="6" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="710" y="162" width="70" height="34" as="geometry"/></mxCell><mxCell id="t-25" value="You declare the tracks; items land in them. Columns line up &lt;b&gt;across&lt;/b&gt; rows, which is the whole point." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="558" y="206" width="224" height="30" as="geometry"/></mxCell><mxCell id="t-26" value="A page shell, a form with aligned columns, a gallery. &lt;span style=&quot;font-family: Courier New&quot;&gt;repeat(auto-fill, minmax(220px, 1fr))&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="558" y="296" width="224" height="38" as="geometry"/></mxCell><mxCell id="a-27" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="358" as="sourcePoint"/><mxPoint x="796" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-28" value="Choosing, and the two escapes people never find" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="368" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-29" value="Other direction must align?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="392" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-30" value="yes → grid · no → flex" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="420" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-31" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;gap&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="392" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-32" value="in both. Margin hacks are over" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="420" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-33" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;min-width: 0&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="392" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-34" value="why flex text will not truncate" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="420" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-35" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;minmax(0, 1fr)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="392" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-36" value="the grid version of the same fix" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="420" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-37" value="Modern defaults worth adopting now: &lt;b&gt;container queries&lt;/b&gt; (a component responds to its own width), &lt;b&gt;logical properties&lt;/b&gt; (&lt;span style=&quot;font-family: Courier New&quot;&gt;margin-inline&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;padding-block&lt;/span&gt; — they flip in RTL), and &lt;span style=&quot;font-family: Courier New&quot;&gt;clamp()&lt;/span&gt; instead of three breakpoints." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="458" width="772" height="34" as="geometry"/></mxCell><mxCell id="b-38" value="Nesting is the normal case, not a compromise: a grid page shell whose header is a flex row. Reach for grid when alignment crosses both axes, flex when it does not, and let flow keep doing what it already does well." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="502" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>