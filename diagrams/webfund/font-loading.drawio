" y="96" width="178" height="44" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="118" as="sourcePoint"/><mxPoint x="616" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-12" value="round trip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="540" y="142" width="136" height="14" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;inter.woff2&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="618" y="96" width="178" height="44" as="geometry"/></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="168" as="sourcePoint"/><mxPoint x="700" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-15" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;link rel=&amp;quot;preload&amp;quot; as=&amp;quot;font&amp;quot; crossorigin&amp;gt;&lt;/span&gt; — starts the request with the HTML, skipping the chain" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="100" y="172" width="600" height="16" as="geometry"/></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="200" as="sourcePoint"/><mxPoint x="796" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="2 · What the user sees while it loads" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="210" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-18" value="FOIT — &lt;span style=&quot;font-family: Courier New&quot;&gt;font-display: block&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="234" width="252" height="186" as="geometry"/></mxCell><mxCell id="t-19" value="0 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="270" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-20" value="(invisible)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="86" y="270" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-21" value="600 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="308" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-22" value="(invisible)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="86" y="308" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-23" value="900 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="346" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-24" value="Headline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="86" y="346" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-25" value="Nothing is readable for up to three seconds. The layout is right; the words are missing." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="384" width="228" height="32" as="geometry"/></mxCell><mxCell id="p-26" value="FOUT — &lt;span style=&quot;font-family: Courier New&quot;&gt;swap&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="284" y="234" width="252" height="186" as="geometry"/></mxCell><mxCell id="t-27" value="0 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="270" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-28" value="Headline — fallback" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="346" y="270" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-29" value="600 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="308" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-30" value="Headline — fallback" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="346" y="308" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-31" value="900 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="346" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-32" value="Headline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="346" y="346" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-33" value="Readable immediately, but the fallback has different metrics — so everything below it jumps on the swap." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="384" width="228" height="32" as="geometry"/></mxCell><mxCell id="p-34" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;swap&lt;/span&gt; + metric-matched fallback" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="544" y="234" width="252" height="186" as="geometry"/></mxCell><mxCell id="t-35" value="0 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="556" y="270" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-36" value="Headline — matched" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="270" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-37" value="600 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="556" y="308" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-38" value="Headline — matched" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="308" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-39" value="900 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="556" y="346" width="44" height="30" as="geometry"/></mxCell><mxCell id="b-40" value="Headline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="346" width="176" height="30" as="geometry"/></mxCell><mxCell id="t-41" value="Same box, different glyphs. Readable at once and nothing moves — &lt;span style=&quot;font-family: Courier New&quot;&gt;size-adjust&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;ascent-override&lt;/span&gt; do this." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="556" y="384" width="228" height="32" as="geometry"/></mxCell><mxCell id="a-42" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="436" as="sourcePoint"/><mxPoint x="796" y="436" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-43" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;block&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="448" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-44" value="~3 s invisible" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="476" width="150" height="30" as="geometry"/></mxCell><mxCell id="pl-45" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;swap&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="182" y="448" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-46" value="fallback, swap forever" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="182" y="476" width="150" height="30" as="geometry"/></mxCell><mxCell id="pl-47" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;fallback&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="340" y="448" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-48" value="100 ms, then give up" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="340" y="476" width="150" height="30" as="geometry"/></mxCell><mxCell id="pl-49" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;optional&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="498" y="448" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-50" value="only if cached — zero shift" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="476" width="150" height="30" as="geometry"/></mxCell><mxCell id="pl-51" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;auto&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="656" y="448" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-52" value="browser default = FOIT" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="656" y="476" width="150" height="30" as="geometry"/></mxCell><mxCell id="b-53" value="Self-host, subset, &lt;span style=&quot;font-family: Courier New&quot;&gt;woff2&lt;/span&gt; only, &lt;span style=&quot;font-family: Courier New&quot;&gt;preload&lt;/span&gt; with &lt;span style=&quot;font-family: Courier New&quot;&gt;crossorigin&lt;/span&gt;, and &lt;span style=&quot;font-family: Courier New&quot;&gt;font-display: swap&lt;/span&gt; behind a metric-matched fallback. That combination gives readable text on the first paint with no layout shift — which is the whole problem." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="518" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>