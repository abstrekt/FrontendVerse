"main thread" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="170" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-13" value="parser STOPPED — blank screen" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="168" width="242.25" height="24" as="geometry"/></mxCell><mxCell id="b-14" value="execute" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="392.25" y="168" width="64.59999999999997" height="24" as="geometry"/></mxCell><mxCell id="b-15" value="parse the rest" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="456.84999999999997" y="168" width="258.40000000000003" height="24" as="geometry"/></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715.25" y="196" as="sourcePoint"/><mxPoint x="715.25" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="DOMContentLoaded" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="655.25" y="196" width="120" height="14" as="geometry"/></mxCell><mxCell id="t-18" value="The parser stops for the whole round trip &lt;i&gt;and&lt;/i&gt; the execution. Every millisecond of that is nothing on screen." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="110" width="646" height="14" as="geometry"/></mxCell><mxCell id="t-19" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;script async&amp;gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=10;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="232" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-20" value="network" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="256" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-21" value="download, in parallel" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="254" width="242.25" height="22" as="geometry"/></mxCell><mxCell id="t-22" value="main thread" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="282" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-23" value="parse HTML" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="280" width="242.25" height="24" as="geometry"/></mxCell><mxCell id="b-24" value="execute (interrupts)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="392.25" y="280" width="64.59999999999997" height="24" as="geometry"/></mxCell><mxCell id="b-25" value="parse the rest" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="456.84999999999997" y="280" width="193.80000000000013" height="24" as="geometry"/></mxCell><mxCell id="a-26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650.6500000000001" y="308" as="sourcePoint"/><mxPoint x="650.6500000000001" y="282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-27" value="DOMContentLoaded" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="590.6500000000001" y="308" width="120" height="14" as="geometry"/></mxCell><mxCell id="t-28" value="Downloads in parallel, but runs the instant it lands — mid-document, and in whatever order the network returns." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="222" width="646" height="14" as="geometry"/></mxCell><mxCell id="t-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;script defer&amp;gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="344" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-30" value="network" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="368" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-31" value="download, in parallel" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="366" width="242.25" height="22" as="geometry"/></mxCell><mxCell id="t-32" value="main thread" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="394" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-33" value="parse HTML — never interrupted" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="392" width="452.20000000000005" height="24" as="geometry"/></mxCell><mxCell id="b-34" value="execute, in order" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="602.2" y="392" width="64.60000000000002" height="24" as="geometry"/></mxCell><mxCell id="a-35" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="666.8000000000001" y="420" as="sourcePoint"/><mxPoint x="666.8000000000001" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-36" value="DOMContentLoaded" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606.8000000000001" y="420" width="120" height="14" as="geometry"/></mxCell><mxCell id="t-37" value="Parallel download, uninterrupted parse, execution in order with the whole DOM available. The default for your own code." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="334" width="646" height="14" as="geometry"/></mxCell><mxCell id="b-38" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;defer&lt;/span&gt; for your own code — parallel download, in-document-order execution, DOM guaranteed. &lt;span style=&quot;font-family: Courier New&quot;&gt;async&lt;/span&gt; only for a third party that touches nothing of yours. A plain &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;script&amp;gt;&lt;/span&gt; in the head is a blank screen for the length of a round trip." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="452" width="772" height="46" as="geometry"/></mxCell><mxCell id="t-39" value="Inline scripts always block, attribute or not. &lt;span style=&quot;font-family: Courier New&quot;&gt;type=&amp;quot;module&amp;quot;&lt;/span&gt; is deferred by default — even inline — and fetched with CORS." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="512" width="772" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>