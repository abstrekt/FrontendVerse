<mxfile host="app.diagrams.net" type="device"><diagram name="Script loading — blocking, async and defer" id="Script loading — blocking, async and defer"><mxGraphModel dx="820" dy="570" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="570" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Script loading — blocking, &lt;span style=&quot;font-family: Courier New&quot;&gt;async&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;defer&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Same file, same size, three very different first paints" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="a-3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="88" as="sourcePoint"/><mxPoint x="796" y="88" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-4" value="0 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="120" y="68" width="60" height="14" as="geometry"/></mxCell><mxCell id="t-5" value="200 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAli