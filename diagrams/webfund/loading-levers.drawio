<mxfile host="app.diagrams.net" type="device"><diagram name="loading, fetchpriority and preload — three levers" id="loading, fetchpriority and preload — three levers"><mxGraphModel dx="820" dy="604" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="604" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="loading, fetchpriority, preload — three levers, three questions" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="When the request starts, how urgent it is once queued, and how early the browser finds out it exists" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Each one answers a different question" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-4" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;loading&lt;/span&gt; — The Doorman" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="94" width="244" height="170" as="geometry"/></mxCell><mxCell id="t-5" value="&lt;b&gt;WHEN&lt;/b&gt; does the fetch start?" style="html=1;whiteSpace=wrap;strokeCo