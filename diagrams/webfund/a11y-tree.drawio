ily: Courier New&quot;&gt;&amp;lt;label&amp;gt;&lt;/span&gt; · &lt;span style=&quot;font-family: Courier New&quot;&gt;aria-label&lt;/span&gt; · &lt;span style=&quot;font-family: Courier New&quot;&gt;alt&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="380" width="178" height="34" as="geometry"/></mxCell><mxCell id="b-28" value="State" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="352" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;disabled&lt;/span&gt; · &lt;span style=&quot;font-family: Courier New&quot;&gt;checked&lt;/span&gt; · &lt;span style=&quot;font-family: Courier New&quot;&gt;aria-expanded&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="380" width="178" height="34" as="geometry"/></mxCell><mxCell id="b-30" value="Value" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="352" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-31" value="the control's current value" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="380" width="178" height="34" as="geometry"/></mxCell><mxCell id="a-32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="422" as="sourcePoint"/><mxPoint x="796" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-33" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;button&amp;gt;Save&amp;lt;/button&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;role · focusable · Enter and Space · disabled state · focus ring · submits a form" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="434" width="372" height="74" as="geometry"/></mxCell><mxCell id="b-34" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;div onclick&amp;gt;Save&amp;lt;/div&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;role &lt;span style=&quot;font-family: Courier New&quot;&gt;generic&lt;/span&gt; · not focusable · no keyboard · no state · invisible to a screen reader" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="434" width="372" height="74" as="geometry"/></mxCell><mxCell id="b-35" value="The accessible name wins over the visible text: &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;button aria-label=&amp;quot;Submit form&amp;quot;&amp;gt;Save&amp;lt;/button&amp;gt;&lt;/span&gt; cannot be activated by a voice-control user saying &amp;quot;click Save&amp;quot;. Keep the two the same, and prefer the native element to any amount of ARIA." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="518" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>