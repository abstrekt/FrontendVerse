<mxfile host="app.diagrams.net" type="device"><diagram name="A metrics dashboard — one range, one clock, twelve widgets" id="A metrics dashboard — one range, one clock, twelve widgets"><mxGraphModel dx="820" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="620" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="A metrics dashboard — one range, one clock, twelve widgets" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Every widget owning its own time range and its own timer is the design that does not scale" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Owned by the dashboard, not the widget" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="74" width="772" height="92" as="geometry"/></mxCell><mxCell id="b-4" value="timeRange" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="104" width="172" height="26" as="geometry"/></mxCell><mxCell id="t-5" value="last 6h · absolute on zoom" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalA