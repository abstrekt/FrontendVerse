dle;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="431" width="348" height="16" as="geometry"/></mxCell><mxCell id="t-41" value="— Opening a modal re-renders subscribers across the app" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="448" width="348" height="16" as="geometry"/></mxCell><mxCell id="p-42" value="Each kind in its own home" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="356" width="380" height="118" as="geometry"/></mxCell><mxCell id="t-43" value="useQuery([&amp;quot;products&amp;quot;])" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="432" y="386" width="172" height="18" as="geometry"/></mxCell><mxCell id="t-44" value="refetches, dedupes, knows staleness" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="386" width="176" height="18" as="geometry"/></mxCell><mxCell id="t-45" value="useSearchParams()" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="432" y="406" width="172" height="18" as="geometry"/></mxCell><mxCell id="t-46" value="the link is the state" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y=