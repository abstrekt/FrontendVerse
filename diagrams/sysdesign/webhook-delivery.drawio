<mxfile host="app.diagrams.net" type="device"><diagram name="Webhooks — a reverse API call, server to server" id="Webhooks — a reverse API call, server to server"><mxGraphModel dx="820" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="600" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Webhooks — a reverse API call, server to server" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The browser cannot receive one: it has no public URL for anybody to POST to" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Webhook — the sender initiates" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="76" width="380" height="186" as="geometry"/></mxCell><mxCell id="b-4" value="Stripe&lt;br/&gt;(Server A)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="112" width="128" height="40" as="geometry"/></mxCell><mxCell id="b-5" value="Your API&lt;br/&gt;(Server B)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="256" y="112" width="128" height="40" as="geometry"/></mxCell><mxCell id="a-6" value="POST /hooks" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="174" y="126" as="sourcePoint"/><mxPoint x="254" y="126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-7" value="200 OK" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="254" y="142" as="sourcePoint"/><mxPoint x="174" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-8" value="One short-lived HTTPS request per event. Nothing is held open in between — zero idle cost on either side." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="162" width="340" height="30" as="geometry"/></mxCell><mxCell id="pl-9" value="Server B must be publicly reachable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="196" width="340" height="22" as="geometry"/></mxCell><mxCell id="t-10" value="Which is exactly why a browser cannot be Server B: it sits behind NAT with no inbound address." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="44" y="222" width="340" height="30" as="geometry"/></mxCell><mxCell id="p-11" value="Streaming — the receiver initiates" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="76" width="380" height="186" as="geometry"/></mxCell><mxCell id="b-12" value="Browser&lt;br/&gt;(client)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="436" y="112" width="128" height="40" as="geometry"/></mxCell><mxCell id="b-13" value="Your API&lt;br/&gt;(server)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="648" y="112" width="128" height="40" as="geometry"/></mxCell><mxCell id="a-14" value="opens outward" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0EA5E9;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="120" as="sourcePoint"/><mxPoint x="646" y="120" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-15" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="566" y="132" width="80" height="10" as="geometry"/></mxCell><mxCell id="a-16" value="events pushed" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="150" as="sourcePoint"/><mxPoint x="566" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="One long-lived connection, opened by the client. It works from anywhere an outbound request works — so, everywhere." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="436" y="162" width="340" height="30" as="geometry"/></mxCell><mxCell id="pl-18" value="Nothing needs a public address" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="196" width="340" height="22" as="geometry"/></mxCell><mxCell id="t-19" value="The cost is the connection itself: heartbeats, reconnects, and state parked per client." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="436" y="222" width="340" height="30" as="geometry"/></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="280" as="sourcePoint"/><mxPoint x="796" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-21" value="What a production receiver actually does" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="292" width="500" height="16" as="geometry"/></mxCell><mxCell id="b-22" value="Verify signature" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="318" width="180" height="28" as="geometry"/></mxCell><mxCell id="t-23" value="HMAC over the raw body + timestamp, or anyone can POST" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="348" width="180" height="30" as="geometry"/></mxCell><mxCell id="a-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206" y="332" as="sourcePoint"/><mxPoint x="218" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-25" value="Dedupe on event id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="318" width="180" height="28" as="geometry"/></mxCell><mxCell id="t-26" value="At-least-once delivery means you will see repeats" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="220" y="348" width="180" height="30" as="geometry"/></mxCell><mxCell id="a-27" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="332" as="sourcePoint"/><mxPoint x="414" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-28" value="Enqueue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="318" width="180" height="28" as="geometry"/></mxCell><mxCell id="t-29" value="Hand to a queue and return immediately — never process inline" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="348" width="180" height="30" as="geometry"/></mxCell><mxCell id="a-30" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="332" as="sourcePoint"/><mxPoint x="610" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-31" value="200 fast" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="612" y="318" width="180" height="28" as="geometry"/></mxCell><mxCell id="t-32" value="Slow ACK = the sender retries an event you already have" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="348" width="180" height="30" as="geometry"/></mxCell><mxCell id="t-33" value="And what the sender does when you are down" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="392" width="500" height="16" as="geometry"/></mxCell><mxCell id="b-34" value="try 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-35" value="now" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="24" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="126" y="430" as="sourcePoint"/><mxPoint x="134" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-37" value="try 2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="136" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-38" value="+10s" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="136" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="238" y="430" as="sourcePoint"/><mxPoint x="246" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-40" value="try 3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-41" value="+2m" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="248" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-42" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="430" as="sourcePoint"/><mxPoint x="358" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-43" value="try 4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="360" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-44" value="+15m" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="360" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-45" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462" y="430" as="sourcePoint"/><mxPoint x="470" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-46" value="try 5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="472" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-47" value="+2h" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="472" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-48" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="574" y="430" as="sourcePoint"/><mxPoint x="582" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-49" value="try 6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="584" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-50" value="+12h" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="584" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="a-51" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="686" y="430" as="sourcePoint"/><mxPoint x="694" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-52" value="dead letter" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="696" y="418" width="100" height="24" as="geometry"/></mxCell><mxCell id="t-53" value="give up" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="696" y="444" width="100" height="14" as="geometry"/></mxCell><mxCell id="t-54" value="Exponential backoff, because the receiver being down is the common case — and because a burst of events must not become a burst of retries on top of it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="464" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-55" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="492" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-56" value="sender" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="488" width="44.599999999999994" height="18" as="geometry"/></mxCell><mxCell id="b-57" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="98.6" y="492" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-58" value="receiver" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="115.6" y="488" width="56.8" height="18" as="geometry"/></mxCell><mxCell id="b-59" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="185.39999999999998" y="492" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-60" value="the part people skip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="202.39999999999998" y="488" width="130" height="18" as="geometry"/></mxCell><mxCell id="b-61" value="A webhook is push where the receiver has an address; a stream is push where it does not. That single difference decides everything else — who reconnects, who retries, and whether idle costs anything." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="520" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>