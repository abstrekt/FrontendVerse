s="geometry"><mxPoint x="318" y="196" as="sourcePoint"/><mxPoint x="318" y="221" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="reac" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#D97706;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="278" y="220" width="80" height="14" as="geometry"/></mxCell><mxCell id="a-18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.4" y="196" as="sourcePoint"/><mxPoint x="347.4" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-19" value="re" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="307.4" y="233" width="80" height="14" as="geometry"/></mxCell><mxCell id="t-20" value="responses land" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="200" width="120" height="16" as="geometry"/></mxCell><mxCell id="b-21" value="The box now shows results for &amp;quot;re&amp;quot; while the input says &amp;quot;reac&amp;quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;shadow=0" vertex="1" parent="1"><mxGeometry x="400" y="190" width="210" height="46" as="geometry"/></mxCell><mxCell id="a-22" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="250" as="sourcePoint"/><mxPoint x="796" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-23" value="Debounce, cancel, and refuse anything stale" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="260" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-24" value="type &amp;quot;reac&amp;quot;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="24" y="288" width="120" height="22" as="geometry"/></mxCell><mxCell id="b-25" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="288" width="40" height="22" as="geometry"/></mxCell><mxCell id="b-26" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200.4" y="288" width="40" height="22" as="geometry"/></mxCell><mxCell id="b-27" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="250.8" y="288" width="40" height="22" as="geometry"/></mxCell><mxCell id="t-28" value="debounced — never sent" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="312" width="200" height="14" as="geometry"/></mxCell><mxCell id="b-29" value="GET ?q=reac" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="250.8" y="340" width="62.99999999999994" height="22" as="geometry"/></mxCell><mxCell id="t-30" value="one request" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="340" width="120" height="22" as="geometry"/></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="313.79999999999995" y="351" as="sourcePoint"/><mxPoint x="329.79999999999995" y="351" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-32" value="seq matches — render" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="335.79999999999995" y="341" width="130" height="20" as="geometry"/></mxCell><mxCell id="b-33" value="in flight" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="372" width="50.400000000000006" height="22" as="geometry"/></mxCell><mxCell id="t-34" value="older request" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="372" width="120" height="22" as="geometry"/></mxCell><mxCell id="pl-35" value="AbortController.abort()" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="206.4" y="373" width="150" height="20" as="geometry"/></mxCell><mxCell id="b-36" value="Three defences, and you want all three: debounce so a fast typist sends one request, not six · abort the previous request so it cannot resolve · tag each request with a sequence number and drop any response older than the newest one rendered. Abort alone is not enough — a response already in flight can still land." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="404" width="772" height="44" as="geometry"/></mxCell><mxCell id="b-37" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#0EA5E9;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="464" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-38" value="request in flight" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="460" width="111.69999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-39" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="165.7" y="464" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-40" value="stale — must not render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="182.7" y="460" width="148.29999999999998" height="18" as="geometry"/></mxCell><mxCell id="b-41" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="344" y="464" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-42" value="current — safe to render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="361" y="460" width="154.39999999999998" height="18" as="geometry"/></mxCell><mxCell id="b-43" value="This bug never reproduces on a fast connection, which is why it ships. The interviewer is listening for whether you reach for cancellation and a sequence guard unprompted — that is the whole signal in an autocomplete question." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="490" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>