<mxfile host="app.diagrams.net" type="device"><diagram name="A multiplayer chat — one id, four states, one cursor" id="A multiplayer chat — one id, four states, one cursor"><mxGraphModel dx="820" dy="574" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="574" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="A multiplayer chat — one id, four states, one cursor" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The client invents the id, the server invents the order, and neither trusts the clock" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The send path" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="400" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="Compose" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="92" width="148" height="32" as="geometry"/></mxCell><mxCell id="t-5" value="player hits Enter" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="126" width="148" height="26" as="geometry"/></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="174" y="108" as="sourcePoint"/><mxPoint x="178" y="108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-7" value="Append locally" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="180" y="92" width="148" height="32" as="geometry"/></mxCell><mxCell id="t-8" value="id = uuid() state = pending" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="180" y="126" width="148" height="26" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="108" as="sourcePoint"/><mxPoint x="334" y="108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-10" value="ws.send" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="336" y="92" width="148" height="32" as="geometry"/></mxCell><mxCell id="t-11" value="one frame, no request/response" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="336" y="126" width="148" height="26" as="geometry"/></mxCell><mxCell id="a-12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="108" as="sourcePoint"/><mxPoint x="490" y="108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-13" value="Server assigns" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="492" y="92" width="148" height="32" as="geometry"/></mxCell><mxCell id="t-14" value="seq + serverTs per channel" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="492" y="126" width="148" height="26" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="108" as="sourcePoint"/><mxPoint x="646" y="108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="Ack → reconcile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="648" y="92" width="148" height="32" as="geometry"/></mxCell><mxCell id="t-17" value="match on the id the client made" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="648" y="126" width="148" height="26" as="geometry"/></mxCell><mxCell id="t-18" value="The message is on screen before the socket is touched — the ack only ever confirms or corrects it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="154" width="772" height="14" as="geometry"/></mxCell><mxCell id="t-19" value="2 · What a message can be" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="182" width="400" height="16" as="geometry"/></mxCell><mxCell id="b-20" value="pending" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="80" y="208" width="120" height="34" as="geometry"/></mxCell><mxCell id="b-21" value="sent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="264" y="208" width="120" height="34" as="geometry"/></mxCell><mxCell id="b-22" value="acked" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="448" y="208" width="120" height="34" as="geometry"/></mxCell><mxCell id="b-23" value="failed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="264" y="288" width="120" height="34" as="geometry"/></mxCell><mxCell id="a-24" value="ws.send" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="202" y="225" as="sourcePoint"/><mxPoint x="262" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-25" value="ack {id, seq}" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="386" y="225" as="sourcePoint"/><mxPoint x="446" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-26" value="timeout / close" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324" y="244" as="sourcePoint"/><mxPoint x="324" y="286" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-27" value="retry — same id" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="305" as="sourcePoint"/><mxPoint x="140" y="244" as="targetPoint"/><Array as="points"><mxPoint x="140" y="305"/></Array></mxGeometry></mxCell><mxCell id="pl-28" value="Server dedupes on that id" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="596" y="205" width="200" height="22" as="geometry"/></mxCell><mxCell id="t-29" value="So a retry after a lost ack is free: the second copy is recognised and answered, not posted twice." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="230" width="200" height="56" as="geometry"/></mxCell><mxCell id="pl-30" value="Order is the server’s seq" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="596" y="292" width="200" height="22" as="geometry"/></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="340" as="sourcePoint"/><mxPoint x="796" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-32" value="3 · Reconnect — from a cursor, never from &amp;quot;now&amp;quot;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="352" width="400" height="16" as="geometry"/></mxCell><mxCell id="b-33" value="101" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-34" value="102" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="76" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-35" value="103" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="128" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-36" value="104" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="180" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-37" value="105" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-38" value="106" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="284" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-39" value="107" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="336" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-40" value="108" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="388" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="b-41" value="109" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="378" width="46" height="26" as="geometry"/></mxCell><mxCell id="t-42" value="seen — lastSeq = 104" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="406" width="208" height="14" as="geometry"/></mxCell><mxCell id="t-43" value="published while offline" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="232" y="406" width="156" height="14" as="geometry"/></mxCell><mxCell id="t-44" value="arrive live again" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="388" y="406" width="120" height="14" as="geometry"/></mxCell><mxCell id="a-45" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="391" as="sourcePoint"/><mxPoint x="540" y="391" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-46" value="reconnect → subscribe(since: 104)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="546" y="374" width="250" height="34" as="geometry"/></mxCell><mxCell id="t-47" value="server replays 105–107, then resumes" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="546" y="410" width="250" height="14" as="geometry"/></mxCell><mxCell id="t-48" value="Resume from &amp;quot;now&amp;quot; and 105–107 are lost in silence — no error, no gap, just three messages the player never sees. A sequence number per channel is what makes the gap detectable at all." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="430" width="772" height="28" as="geometry"/></mxCell><mxCell id="b-49" value="Client-generated id, server-generated order. The id makes retries idempotent so the network can be as unreliable as it likes; the seq makes gaps detectable so a reconnect can be correct rather than hopeful." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="466" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>