gn=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="376" y="120" width="200" height="26" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="578" y="133" as="sourcePoint"/><mxPoint x="606" y="133" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="&lt;b&gt;Shield&lt;/b&gt;&lt;br/&gt;PoP" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="610" y="110" width="92" height="46" as="geometry"/></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="704" y="133" as="sourcePoint"/><mxPoint x="722" y="133" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-14" value="Origin" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="726" y="110" width="70" height="46" as="geometry"/></mxCell><mxCell id="t-15" value="Without an origin shield, a cold cache in 200 PoPs is 200 requests to your origin for the same file. With it — plus request coalescing — the origin sees one." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="158" width="772" height="26" as="geometry"/></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="192" as="sourcePoint"/><mxPoint x="796" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="2 · The cache key decides your hit rate" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="202" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-18" value="A key that destroys the hit rate" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="226" width="380" height="178" as="geometry"/></mxCell><mxCell id="b-19" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;?utm_source=twitter&lt;/span&gt; in the key" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="262" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-20" value="every campaign link is a new object" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="286" width="352" height="16" as="geometry"/></mxCell><mxCell id="b-21" value="all cookies in the key" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="306" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-22" value="an analytics cookie makes every user unique" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="330" width="352" height="16" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Vary: User-Agent&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="350" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-24" value="thousands of variants of one file" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="374" width="352" height="16" as="geometry"/></mxCell><mxCell id="p-25" value="A key that works" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="226" width="380" height="178" as="geometry"/></mxCell><mxCell id="b-26" value="strip marketing params before the key" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="262" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-27" value="one object per real URL" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="286" width="352" height="16" as="geometry"/></mxCell><mxCell id="b-28" value="ignore every cookie except the ones that change the body" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="306" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-29" value="anonymous HTML stays cacheable" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="330" width="352" height="16" as="geometry"/></mxCell><mxCell id="b-30" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Vary: Accept-Encoding&lt;/span&gt; only" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="350" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-31" value="two variants: brotli and gzip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="374" width="352" height="16" as="geometry"/></mxCell><mxCell id="a-32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="416" as="sourcePoint"/><mxPoint x="796" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-33" value="3 · Two audiences, two headers — and four ways to invalidate" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="426" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-34" value="max-age → the browser   ·   s-maxage → the CDN" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="450" width="380" height="26" as="geometry"/></mxCell><mxCell id="t-35" value="Hashed asset: &lt;span style=&quot;font-family: Courier New&quot;&gt;max-age=31536000, immutable&lt;/span&gt;. HTML: &lt;span style=&quot;font-family: Courier New&quot;&gt;max-age=0, s-maxage=60, stale-while-revalidate=600&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="478" width="380" height="30" as="geometry"/></mxCell><mxCell id="b-36" value="1 · Versioned URL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="450" width="88" height="26" as="geometry"/></mxCell><mxCell id="t-37" value="nothing to invalidate" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="478" width="88" height="30" as="geometry"/></mxCell><mxCell id="b-38" value="2 · Surrogate key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="512" y="450" width="88" height="26" as="geometry"/></mxCell><mxCell id="t-39" value="purge by tag" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="512" y="478" width="88" height="30" as="geometry"/></mxCell><mxCell id="b-40" value="3 · Short TTL + SWR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="450" width="88" height="26" as="geometry"/></mxCell><mxCell id="t-41" value="stale for a minute" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="478" width="88" height="30" as="geometry"/></mxCell><mxCell id="b-42" value="4 · Purge" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="704" y="450" width="88" height="26" as="geometry"/></mxCell><mxCell id="t-43" value="the emergency lever" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="704" y="478" width="88" height="30" as="geometry"/></mxCell><mxCell id="b-44" value="The two sentences that score: &amp;quot;static assets never reach a pod, they are immutable at the edge&amp;quot;, and &amp;quot;I invalidate by changing the URL, not by purging&amp;quot; — because a global purge is both slow to propagate and a thundering herd against the origin." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="518" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>