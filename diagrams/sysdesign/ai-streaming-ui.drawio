<mxfile host="app.diagrams.net" type="device"><diagram name="Streaming UI for a model call" id="Streaming UI for a model call"><mxGraphModel dx="820" dy="604" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="604" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Streaming UI for a model call" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Total time is roughly fixed; time to &lt;i&gt;first token&lt;/i&gt; is the entire perceived difference" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The same 8-second answer, two ways" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-4" value="Await the whole&lt;br/&gt;response" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="100" width="120" height="20" as="geometry"/></mxCell><mxCell id="b-5" value="spinner — nothing to read" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="96" width="613.6999999999999" height="28" as="geometry"/></mxCell><mxCell id="b-6" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="763.6999999999999" y="96" width="32.30000000000007" height="28" as="geometry"/></mxCell><mxCell id="t-7" value="Eight seconds of a spinner, then a wall of text. Users reload, or leave." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="126" width="646" height="14" as="geometry"/></mxCell><mxCell id="t-8" value="Stream the&lt;br/&gt;tokens" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="158" width="120" height="20" as="geometry"/></mxCell><mxCell id="b-9" value="queued" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="154" width="32.30000000000001" height="28" as="geometry"/></mxCell><mxCell id="b-10" value="text arriving, readable from the first word" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182.3" y="154" width="613.7" height="28" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="182.3" y="200" as="sourcePoint"/><mxPoint x="182.3" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-12" value="first token — 400 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="112.30000000000001" y="200" width="140" height="14" as="geometry"/></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="226" as="sourcePoint"/><mxPoint x="796" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-14" value="2 · The seven states — &amp;quot;loading&amp;quot; and &amp;quot;done&amp;quot; are not enough" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="236" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-15" value="Queued" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="262" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-16" value="thinking indicator" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="290" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-17" value="Streaming" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="262" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-18" value="partial text + Stop" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="290" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-19" value="Tool running" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="262" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-20" value="&amp;quot;Searching…&amp;quot;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="290" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-21" value="Complete" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="262" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-22" value="copy · retry · feedback" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="290" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-23" value="Stopped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="324" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-24" value="keep the partial text" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="352" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-25" value="Failed mid-stream" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="324" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-26" value="retry without losing it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="352" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-27" value="Refused / empty" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="324" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-28" value="a real message" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="352" width="178" height="26" as="geometry"/></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="392" as="sourcePoint"/><mxPoint x="796" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-30" value="3 · The rendering trap" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="402" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-31" value="Re-parse markdown on every token" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="426" width="380" height="104" as="geometry"/></mxCell><mxCell id="b-32" value="O(n²) — token 900 re-parses 900 tokens" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="458" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-33" value="The tab janks by the third paragraph, and the whole transcript re-renders with every chunk." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="486" width="352" height="34" as="geometry"/></mxCell><mxCell id="p-34" value="Append text, parse on a throttle" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="426" width="380" height="104" as="geometry"/></mxCell><mxCell id="b-35" value="plain text while streaming · parse every ~100 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="458" width="352" height="24" as="geometry"/></mxCell><mxCell id="t-36" value="Memoise completed messages, virtualise long conversations, and never flash a half-streamed code fence." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="486" width="352" height="34" as="geometry"/></mxCell><mxCell id="b-37" value="Cancellation is a feature, not an edge case: abort the fetch &lt;i&gt;and&lt;/i&gt; tell the server, or you keep paying for tokens nobody will read. And the API key never leaves your server — a key in the bundle is a public key." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="544" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>