8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="338" as="sourcePoint"/><mxPoint x="796" y="338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-66" value="From bytes to a number" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="352" width="468" height="152" as="geometry"/></mxCell><mxCell id="b-67" value="Mbps  =  (Δbytes summed over every stream × 8) ÷ (Δt × 1,000,000)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="384" width="428" height="34" as="geometry"/></mxCell><mxCell id="b-68" value="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="426" width="18" height="18" as="geometry"/></mxCell><mxCell id="t-69" value="One slice is ~200ms of bytes across all sockets — an instantaneous reading, not the answer." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="70" y="426" width="400" height="18" as="geometry"/></mxCell><mxCell id="b-70" value="2" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="450" width="18" height="18" as="geometry"/></mxCell><mxCell id="t-71" value="Throw away the first 1–2s: slow start has not opened the congestion window yet." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="70" y="450" width="400" height="18" as="geometry"/></mxCell><mxCell id="b-72" value="3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="474" width="18" height="18" as="geometry"/></mxCell><mxCell id="t-73" value="Trim the tails — report the middle 60–80%, or an 80–90th percentile slice." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="70" y="474" width="400" height="18" as="geometry"/></mxCell><mxCell id="p-74" value="Why parallel streams" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="508" y="352" width="288" height="152" as="geometry"/></mxCell><mxCell id="t-75" value="A single TCP stream grows its congestion window exponentially from a tiny initial size, and any loss halves it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="524" y="382" width="256" height="44" as="geometry"/></mxCell><mxCell id="pl-76" value="one stream → under-reports a fast link" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="524" y="428" width="256" height="22" as="geometry"/></mxCell><mxCell id="pl-77" value="eight streams → saturate it in ~1s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="524" y="456" width="256" height="22" as="geometry"/></mxCell><mxCell id="t-78" value="The same reason browsers once sharded domains." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="524" y="480" width="256" height="18" as="geometry"/></mxCell><mxCell id="b-79" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="518" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-80" value="warm-up, discarded" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="514" width="117.8" height="18" as="geometry"/></mxCell><mxCell id="b-81" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="171.8" y="518" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-82" value="outlier, trimmed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="188.8" y="514" width="105.6" height="18" as="geometry"/></mxCell><mxCell id="b-83" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="307.4" y="518" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-84" value="counted toward the reported number" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="324.4" y="514" width="215.39999999999998" height="18" as="geometry"/></mxCell><mxCell id="b-85" value="The measurement is easy; the statistics are the product. Anyone can divide bytes by seconds — the design work is opening enough streams to reach line rate, ignoring the ramp, and trimming the tails so the number means sustained capacity rather than one lucky 200ms." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="546" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>