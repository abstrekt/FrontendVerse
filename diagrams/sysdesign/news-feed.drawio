<mxfile host="app.diagrams.net" type="device"><diagram name="News feed — request split, virtualization, cursor pagination" id="News feed — request split, virtualization, cursor pagination"><mxGraphModel dx="820" dy="654" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="654" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="News feed — three separate problems wearing one screen" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The request shape, the list size, and what happens when the list moves under you" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The request — personalisation is what makes it uncacheable" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-4" value="One personalised response" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="92" width="372" height="124" as="geometry"/></mxCell><mxCell id="b-5" value="GET /feed  →  ranked posts + my likes + my saves" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="124" width="340" height="30" as="geometry"/></mxCell><mxCell id="t-6" value="Personal, so no shared cache may hold it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="158" width="340" height="14" as="geometry"/></mxCell><mxCell id="pl-7" value="origin · ~250 ms" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="178" width="150" height="22" as="geometry"/></mxCell><mxCell id="t-8" value="every request, every user" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="200" y="178" width="180" height="22" as="geometry"/></mxCell><mxCell id="p-9" value="Split by who it belongs to" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="424" y="92" width="372" height="124" as="geometry"/></mxCell><mxCell id="b-10" value="GET /feed      ranked post ids — same for a cohort" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="124" width="340" height="24" as="geometry"/></mxCell><mxCell id="b-11" value="GET /me/overlay   my likes, my saves — tiny" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="152" width="340" height="24" as="geometry"/></mxCell><mxCell id="pl-12" value="edge · ~30 ms" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="440" y="182" width="104" height="22" as="geometry"/></mxCell><mxCell id="pl-13" value="origin · ~80 ms" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="552" y="182" width="116" height="22" as="geometry"/></mxCell><mxCell id="t-14" value="and it can arrive&lt;br/&gt;after first paint" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="676" y="182" width="104" height="22" as="geometry"/></mxCell><mxCell id="t-15" value="2 · The list — 10,000 posts is 80,000 DOM nodes" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="228" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-16" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="252" width="150" height="150" as="geometry"/></mxCell><mxCell id="t-17" value="10,000 items" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9