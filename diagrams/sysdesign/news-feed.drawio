"geometry"/></mxCell><mxCell id="t-30" value="in memory" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="404" width="150" height="14" as="geometry"/></mxCell><mxCell id="a-31" value="window" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="330" as="sourcePoint"/><mxPoint x="214" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-32" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="252" width="176" height="150" as="geometry"/></mxCell><mxCell id="t-33" value="~30 rendered" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="220" y="256" width="176" height="14" as="geometry"/></mxCell><mxCell id="b-34" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="276" width="152" height="26" as="geometry"/></mxCell><mxCell id="b-35" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="306" width="152" height="26" as="geometry"/></mxCell><mxCell id="b-36" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="336" width="152" height="26" as="geometry"/></mxCell><mxCell id="b-37" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="366" width="152" height="26" as="geometry"/></mxCell><mxCell id="t-38" value="in the DOM" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="220" y="404" width="176" height="14" as="geometry"/></mxCell><mxCell id="b-39" value="Virtualization renders only the visible window plus a small overscan, and reuses those nodes as you scroll.&lt;br/&gt;&lt;br/&gt;The cost you take on: every row needs a known height (or you measure and cache it), scroll restoration becomes your problem, and Ctrl+F stops finding anything off screen.&lt;br/&gt;&lt;br/&gt;The accessibility cost is the one people miss — the list needs aria-setsize and aria-posinset, or a screen reader is told there are 30 posts." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="252" width="384" height="150" as="geometry"/></mxCell><mxCell id="t-40" value="3 · Pagination — the list mutates while you read it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="428" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-41" value="Offset — page 2 after a new post arrives" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="450" width="372" height="116" as="geometry"/></mxCell><mxCell id="b-42" value="P9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-43" value="P8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="88" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-44" value="P7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="136" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="t-45" value="page 1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="190" y="482" width="60" height="26" as="geometry"/></mxCell><mxCell id="t-46" value="P10 posted →" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="250" y="476" width="132" height="16" as="geometry"/></mxCell><mxCell id="b-47" value="P7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-48" value="P6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="88" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-49" value="P5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="136" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="t-50" value="page 2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="190" y="520" width="60" height="26" as="geometry"/></mxCell><mxCell id="t-51" value="P7 shown twice.&lt;br/&gt;Something else is lost." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="250" y="520" width="132" height="26" as="geometry"/></mxCell><mxCell id="p-52" value="Cursor — page 2 asks &amp;quot;after P7&amp;quot;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="424" y="450" width="372" height="116" as="geometry"/></mxCell><mxCell id="b-53" value="P9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-54" value="P8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="488" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-55" value="P7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="536" y="482" width="44" height="26" as="geometry"/></mxCell><mxCell id="t-56" value="nextCursor = P7" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="590" y="482" width="190" height="26" as="geometry"/></mxCell><mxCell id="b-57" value="P6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-58" value="P5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="488" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="b-59" value="P4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="536" y="520" width="44" height="26" as="geometry"/></mxCell><mxCell id="t-60" value="Stable under insertion.&lt;br/&gt;New posts go to a banner." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="590" y="520" width="190" height="26" as="geometry"/></mxCell><mxCell id="b-61" value="Answer all three or the design is incomplete: split the response so the bulk of it can be cached, virtualize because the DOM is the real limit, and use a cursor because the feed mutates under the reader. Offset pagination on a live feed is a correctness bug, not a style choice." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="580" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>