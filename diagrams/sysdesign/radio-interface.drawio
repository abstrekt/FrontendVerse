<mxfile host="app.diagrams.net" type="device"><diagram name="I — two contracts, and only one of them is the API" id="I — two contracts, and only one of them is the API"><mxGraphModel dx="820" dy="556" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="556" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="I — two contracts, and only one of them is the API" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The component contract is the half that makes it a frontend interview" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="1 · Network — client ↔ server" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="76" width="380" height="226" as="geometry"/></mxCell><mxCell id="b-4" value="GET /feed?cursor=eyJ…&amp;amp;limit=20" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="110" width="340" height="26" as="geometry"/></mxCell><mxCell id="a-5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="214" y="138" as="sourcePoint"/><mxPoint x="214" y="154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-6" value="{ items: Post[],&lt;br/&gt;  nextCursor: string | null }" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="158" width="340" height="40" as="geometry"/></mxCell><mxCell id="pl-7" value="Cursor, not offset — an insert shifts every offset page" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="208" width="340" height="20" as="geometry"/></mxCell><mxCell id="pl-8" value="One error shape, every endpoint" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="234" width="340" height="20" as="geometry"/></mxCell><mxCell id="pl-9" value="Never a mutation behind a GET" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="260" width="340" height="20" as="geometry"/></mxCell><mxCell id="p-10" value="2 · Component — your code ↔ your code" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="76" width="380" height="226" as="geometry"/></mxCell><mxCell id="b-11" value="&amp;lt;Feed&lt;br/&gt;  items={posts}&lt;br/&gt;  state=&amp;quot;loading&amp;quot; | &amp;quot;ready&amp;quot; | &amp;quot;error&amp;quot; | &amp;quot;empty&amp;quot;&lt;br/&gt;  onLoadMore={() =&amp;gt; void}&lt;br/&gt;  onLike={(id: string) =&amp;gt; void}&lt;br/&gt;/&amp;gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="436" y="110" width="340" height="88" as="geometry"/></mxCell><mxCell id="pl-12" value="Data down as props, intent up as callbacks" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="208" width="340" height="20" as="geometry"/></mxCell><mxCell id="pl-13" value="One &lt;span style=&quot;font-family: Courier New&quot;&gt;state&lt;/span&gt; union, not three booleans" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="234" width="340" height="20" as="geometry"/></mxCell><mxCell id="pl-14" value="The component fetches nothing — the caller owns it" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="260" width="340" height="20" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="320" as="sourcePoint"/><mxPoint x="796" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-16" value="Neither contract is invented here — both fall out of the two stages above" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="332" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-17" value="D — the data model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="84" y="360" width="260" height="28" as="geometry"/></mxCell><mxCell id="t-18" value="decides the response shape" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="84" y="390" width="260" height="14" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="214" y="356" as="sourcePoint"/><mxPoint x="214" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-20" value="A — the architecture" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="476" y="360" width="260" height="28" as="geometry"/></mxCell><mxCell id="t-21" value="decides the component props" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="476" y="390" width="260" height="14" as="geometry"/></mxCell><mxCell id="a-22" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="356" as="sourcePoint"/><mxPoint x="606" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-23" value="Which is the point of the order: by the time you reach I, both contracts are mostly transcription. Designing an API before you know what data crosses the boundary is where the guessing happens." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="412" width="772" height="28" as="geometry"/></mxCell><mxCell id="b-24" value="Name both. A candidate who only specifies the network contract has described a backend feature with a UI attached; the props and callbacks between your own components are the frontend design." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="470" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>