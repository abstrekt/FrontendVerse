=0" vertex="1" parent="1"><mxGeometry x="250" y="222" width="200" height="38" as="geometry"/></mxCell><mxCell id="t-12" value="tokens · a11y solved once" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="260" width="200" height="13" as="geometry"/></mxCell><mxCell id="t-13" value="cache · dedupe · mutations" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="250" y="260" width="200" height="13" as="geometry"/></mxCell><mxCell id="b-14" value="Service worker" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="286" width="130" height="32" as="geometry"/></mxCell><mxCell id="b-15" value="IndexedDB" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="178" y="286" width="130" height="32" as="geometry"/></mxCell><mxCell id="b-16" value="Web Worker" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="316" y="286" width="130" height="32" as="geometry"/></mxCell><mxCell id="t-17" value="platform — offline shell, local data, work off the main thread" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="318" width="410" height="14" as="geometry"/></mxCell><mxCell id="b-18" value="One main thread renders, runs your JS, and handles input. Everything above competes for it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="340" width="410" height="44" as="geometry"/></mxCell><mxCell id="p-19" value="The path to the data" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="482" y="74" width="314" height="330" as="geometry"/></mxCell><mxCell id="b-20" value="CDN edge" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="108" width="282" height="40" as="geometry"/></mxCell><mxCell id="t-21" value="static assets + anything cacheable" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="148" width="230" height="13" as="geometry"/></mxCell><mxCell id="b-22" value="BFF" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="182" width="282" height="40" as="geometry"/></mxCell><mxCell id="t-23" value="one request in, four out — joined on a fast link" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="222" width="282" height="13" as="geometry"/></mxCell><mxCell id="b-24" value="posts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="262" width="88" height="32" as="geometry"/></mxCell><mxCell id="b-25" value="users" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="594" y="262" width="88" height="32" as="geometry"/></mxCell><mxCell id="b-26" value="search" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="690" y="262" width="88" height="32" as="geometry"/></mxCell><mxCell id="t-27" value="services you do not own" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="294" width="282" height="13" as="geometry"/></mxCell><mxCell id="a-28" value="miss" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="764" y="150" as="sourcePoint"/><mxPoint x="764" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="238" as="sourcePoint"/><mxPoint x="542" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-30" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="639" y="238" as="sourcePoint"/><mxPoint x="639" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735" y="238" as="sourcePoint"/><mxPoint x="735" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-32" value="Every hop here is latency the user pays. The whole client-side design above exists to make this path shorter, rarer, or invisible." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="316" width="282" height="68" as="geometry"/></mxCell><mxCell id="a-33" value="fetch" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.8;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="241" as="sourcePoint"/><mxPoint x="496" y="128" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-34" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="416" as="sourcePoint"/><mxPoint x="796" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-35" value="Cross-cutting — these do not sit in a layer, they cut through all of them" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="422" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-36" value="Observability" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="444" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-37" value="RUM, errors, traces" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="474" width="178" height="13" as="geometry"/></mxCell><mxCell id="b-38" value="i18n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="444" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-39" value="locale bundles, RTL" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="474" width="178" height="13" as="geometry"/></mxCell><mxCell id="b-40" value="Feature flags" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="444" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-41" value="release ≠ deploy" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="474" width="178" height="13" as="geometry"/></mxCell><mxCell id="b-42" value="Security" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="444" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-43" value="CSP, sanitising, auth" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="474" width="178" height="13" as="geometry"/></mxCell><mxCell id="b-44" value="Draw this, then delete what the problem does not need. A dashboard behind a login has no CDN story and no SEO; a marketing site has no data layer worth the name. The boxes you remove, out loud, are worth as much as the ones you keep." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="498" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>