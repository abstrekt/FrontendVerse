<mxfile host="app.diagrams.net" type="device"><diagram name="Adaptive bitrate — the quality-selection loop" id="Adaptive bitrate — the quality-selection loop"><mxGraphModel dx="820" dy="592" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="592" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Adaptive bitrate — the loop that keeps playback from stalling" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Estimate the bandwidth, pick the next segment’s quality, watch the buffer, repeat" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The same content, encoded once per rung" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="1080p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="94" width="110" height="26" as="geometry"/></mxCell><mxCell id="t-5" value="5 Mbps" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="140" y="94" width="90" height="26" as="geometry"/></mxCell><mxCell id="b-6" value="720p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="124" width="110" height="26" as="geometry"/></mxCell><mxCell id="t-7" value="2.5 Mbps" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="140" y="124" width="90" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="480p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="154" width="110" height="26" as="geometry"/></mxCell><mxCell id="t-9" value="1 Mbps" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="140" y="154" width="90" height="26" as="geometry"/></mxCell><mxCell id="b-10" value="240p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="184" width="110" height="26" as="geometry"/></mxCell><mxCell id="t-11" value="400 kbps" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="140" y="184" width="90" height="26" as="geometry"/></mxCell><mxCell id="t-12" value="The manifest lists every rung. The player may switch between them at any segment boundary, because each segment starts with a keyframe." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="94" width="250" height="116" as="geometry"/></mxCell><mxCell id="b-13" value="Segments are 2–6 seconds. Shorter means faster reaction to a bandwidth change and more requests; longer means better compression and slower recovery. 4s is the usual compromise." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="500" y="94" width="296" height="116" as="geometry"/></mxCell><mxCell id="t-14" value="2 · Bandwidth drops at segment 4 — what the player does" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="224" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-15" value="1080p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-16" value="1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="150" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-17" value="1080p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="206" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-18" value="2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="206" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-19" value="1080p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="262" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-20" value="3" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="262" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-21" value="480p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="318" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-22" value="4" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="318" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-23" value="480p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="374" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-24" value="5" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="374" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-25" value="720p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-26" value="6" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="430" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="b-27" value="1080p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="486" y="250" width="52" height="30" as="geometry"/></mxCell><mxCell id="t-28" value="7" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="486" y="281" width="52" height="13" as="geometry"/></mxCell><mxCell id="t-29" value="segment fetched" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="250" width="120" height="30" as="geometry"/></mxCell><mxCell id="t-30" value="measured" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="302" width="120" height="26" as="geometry"/></mxCell><mxCell id="b-31" value="5.4" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-32" value="5.1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="206" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-33" value="5.3" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="262" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-34" value="0.9" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="318" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-35" value="1.1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="374" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-36" value="2.8" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="b-37" value="5.2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="486" y="302" width="52" height="24" as="geometry"/></mxCell><mxCell id="t-38" value="Mbps" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="550" y="302" width="60" height="24" as="geometry"/></mxCell><mxCell id="b-39" value="Step down fast, step up slowly — one good segment is not evidence." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="334" width="232" height="34" as="geometry"/></mxCell><mxCell id="t-40" value="3 · The buffer is the real signal" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="380" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-41" value="panic — drop quality now" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="404" width="140" height="30" as="geometry"/></mxCell><mxCell id="t-42" value="&amp;lt; 5 s" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="24" y="435" width="140" height="13" as="geometry"/></mxCell><mxCell id="b-43" value="steady — hold" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="170" y="404" width="250" height="30" as="geometry"/></mxCell><mxCell id="t-44" value="5–20 s" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="170" y="435" width="250" height="13" as="geometry"/></mxCell><mxCell id="b-45" value="healthy — try stepping up" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="426" y="404" width="250" height="30" as="geometry"/></mxCell><mxCell id="t-46" value="&amp;gt; 20 s" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="426" y="435" width="250" height="13" as="geometry"/></mxCell><mxCell id="b-47" value="Bandwidth estimates lag and lie — a CDN burst reads as a fast link right before a stall. Buffer level is ground truth: it already reflects everything that actually happened. Use bandwidth to choose, and the buffer to overrule." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="458" width="772" height="40" as="geometry"/></mxCell><mxCell id="b-48" value="Never hand-roll ABR — hls.js or Shaka. What the interviewer wants is that you know the loop exists, that you step down fast and up slowly, and that a stall is far worse for a viewer than a lower resolution they will probably not notice." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="508" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>