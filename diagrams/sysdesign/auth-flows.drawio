ed=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="422" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-37" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="194" y="433" as="sourcePoint"/><mxPoint x="212" y="433" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-38" value="POST /refresh" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="216" y="422" width="164" height="22" as="geometry"/></mxCell><mxCell id="t-39" value="Four refreshes. Rotation invalidates three of them — and logs the user out." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="448" width="340" height="14" as="geometry"/></mxCell><mxCell id="p-40" value="One in-flight refresh, shared" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="424" y="310" width="372" height="150" as="geometry"/></mxCell><mxCell id="b-41" value="request 1 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="344" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-42" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="355" as="sourcePoint"/><mxPoint x="612" y="381" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-43" value="request 2 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="370" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-44" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="381" as="sourcePoint"/><mxPoint x="612" y="381" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-45" value="request 3 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="396" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-46" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="407" as="sourcePoint"/><mxPoint x="612" y="381" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-47" value="request 4 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="422" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-48" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="433" as="sourcePoint"/><mxPoint x="612" y="381" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-49" value="POST /refresh" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="616" y="370" width="164" height="22" as="geometry"/></mxCell><mxCell id="t-50" value="all four await the&lt;br/&gt;same promise" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="394" width="164" height="26" as="geometry"/></mxCell><mxCell id="t-51" value="One refresh, one rotation, four requests replayed with the new token." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="440" y="448" width="340" height="14" as="geometry"/></mxCell><mxCell id="a-52" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="474" as="sourcePoint"/><mxPoint x="796" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-53" value="Rules that are not negotiable" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="482" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-54" value="PKCE, always" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="506" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-55" value="The implicit flow is deprecated" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="536" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-56" value="Validate on the server" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="506" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-57" value="A client check is a UX hint" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="536" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-58" value="Rotate refresh tokens" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="506" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-59" value="And detect reuse as theft" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="536" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-60" value="Sync logout across tabs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="506" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-61" value="BroadcastChannel or storage" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="536" width="178" height="26" as="geometry"/></mxCell><mxCell id="b-62" value="Everything the client does with auth is convenience. The only thing that actually protects a resource is the server checking the token on every request — so say &amp;quot;the client hides the button, the server enforces the rule&amp;quot; out loud, because that is the sentence being listened for." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="570" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>