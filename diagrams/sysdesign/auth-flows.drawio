<mxfile host="app.diagrams.net" type="device"><diagram name="Frontend auth — token storage and silent refresh" id="Frontend auth — token storage and silent refresh"><mxGraphModel dx="820" dy="628" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="628" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Frontend auth — where the token lives decides everything else" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The storage choice is the design; the flow is mostly the same either way" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Two real options, and one that keeps being chosen anyway" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-4" value="localStorage" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="94" width="256" height="178" as="geometry"/></mxCell><mxCell id="t-5" value="XSS" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="128" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-6" value="Readable by any script on the page — one bad dependency is total compromise" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="142" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-7" value="CSRF" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="178" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-8" value="Immune — not sent automatically" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="192" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-9" value="Verdict" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="228" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-10" value="Do not. The XSS exposure is not worth the CSRF convenience." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="242" width="228" height="34" as="geometry"/></mxCell><mxCell id="p-11" value="httpOnly cookie" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="282" y="94" width="256" height="178" as="geometry"/></mxCell><mxCell id="t-12" value="XSS" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="296" y="128" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-13" value="Unreadable by JavaScript, by construction" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="142" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-14" value="CSRF" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="296" y="178" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-15" value="Needs SameSite=Lax/Strict, plus a token for cross-site POSTs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="192" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-16" value="Verdict" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="296" y="228" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-17" value="The default. Pair with SameSite and Secure." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="242" width="228" height="34" as="geometry"/></mxCell><mxCell id="p-18" value="In memory only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="540" y="94" width="256" height="178" as="geometry"/></mxCell><mxCell id="t-19" value="XSS" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="554" y="128" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-20" value="Readable, but gone on reload — a much smaller window" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="142" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-21" value="CSRF" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="554" y="178" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-22" value="Immune" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="192" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-23" value="Verdict" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="554" y="228" width="64" height="14" as="geometry"/></mxCell><mxCell id="t-24" value="Good for the access token, with a refresh cookie behind it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="242" width="228" height="34" as="geometry"/></mxCell><mxCell id="t-25" value="2 · Silent refresh — and the stampede it causes if you get it wrong" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="286" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-26" value="Refresh per failed request" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="310" width="372" height="150" as="geometry"/></mxCell><mxCell id="b-27" value="request 1 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="344" width="150" height="22" as="geometry"/></mxCell><mxCell id="a-28" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="194" y="355" as="sourcePoint"/><mxPoint x="212" y="355" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-29" value="POST /refresh" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="216" y="344" width="164" height="22" as="geometry"/></mxCell><mxCell id="b-30" value="request 2 → 401" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=mid