<mxfile host="app.diagrams.net" type="device"><diagram name="Accessibility is a tree the browser derives from your markup" id="Accessibility is a tree the browser derives from your markup"><mxGraphModel dx="820" dy="530" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="530" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Accessibility is a tree the browser derives from your markup" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The same click handler, two elements — and everything downstream differs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="A div with a click handler" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="88" width="380" height="230" as="geometry"/></mxCell><mxCell id="b-4" value="&amp;lt;div onclick=&amp;quot;save()&amp;quot;&amp;gt;Save&amp;lt;/div&amp;gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="120" width="340" height="26" as="geometry"/></mxCell><mxCell id="a-5" value="derives" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="214" y="150" as="sourcePoint"/><mxPoint x="214" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-6" value="role: generic&lt;br/&gt;name: (none)&lt;br/&gt;focusable: no" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="172" width="340" height="46" as="geometry"/></mxCell><mxCell id="pl-7" value="tabindex=&amp;quot;0&amp;quot; — by hand" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="228" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-8" value="keydown for Enter AND Space" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="250" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-9" value="role=&amp;quot;button&amp;quot; — a promise you now owe" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="272" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-10" value="OS high-contrast mode: nothing" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="294" width="340" height="18" as="geometry"/></mxCell><mxCell id="p-11" value="The native button" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="88" width="380" height="230" as="geometry"/></mxCell><mxCell id="b-12" value="&amp;lt;button onclick=&amp;quot;save()&amp;quot;&amp;gt;Save&amp;lt;/button&amp;gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="436" y="120" width="340" height="26" as="geometry"/></mxCell><mxCell id="a-13" value="derives" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="150" as="sourcePoint"/><mxPoint x="606" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-14" value="role: button&lt;br/&gt;name: &amp;quot;Save&amp;quot;&lt;br/&gt;focusable: yes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="436" y="172" width="340" height="46" as="geometry"/></mxCell><mxCell id="pl-15" value="in the tab order already" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="228" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-16" value="Enter and Space already work" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="250" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-17" value="announced as a button" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="272" width="340" height="18" as="geometry"/></mxCell><mxCell id="pl-18" value="honours OS high contrast" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="294" width="340" height="18" as="geometry"/></mxCell><mxCell id="t-19" value="Assistive technology never sees your DOM. It sees this tree — so the element you pick is the API." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="322" width="772" height="14" as="geometry"/></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="346" as="sourcePoint"/><mxPoint x="796" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-21" value="Four architecture decisions, and what each one costs you" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="358" width="500" height="16" as="geometry"/></mxCell><mxCell id="b-22" value="Custom dropdown" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="384" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-23" value="you now own the whole combobox ARIA pattern" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="412" width="180" height="28" as="geometry"/></mxCell><mxCell id="b-24" value="Virtualized list" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="384" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-25" value="the tree misreports its size unless you set it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="220" y="412" width="180" height="28" as="geometry"/></mxCell><mxCell id="b-26" value="Canvas rendering" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="384" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-27" value="opaque — needs a parallel DOM tree" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="412" width="180" height="28" as="geometry"/></mxCell><mxCell id="b-28" value="Client-side routing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="612" y="384" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-29" value="nothing announces the change; you must" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="412" width="180" height="28" as="geometry"/></mxCell><mxCell id="b-30" value="None of those four is a styling choice — each one changes the component tree, and focus behaviour retrofitted onto a tree that already exists is most of a rewrite. That is why this belongs in the architecture stage, not the last minute." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="450" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>