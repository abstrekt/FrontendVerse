<mxfile host="app.diagrams.net" type="device"><diagram name="Multi-stage build — the toolchain does not ship" id="Multi-stage build — the toolchain does not ship"><mxGraphModel dx="820" dy="690" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="690" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Multi-stage build — the toolchain does not ship" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="One Dockerfile, two stages: what builds the app and what runs it are different machines" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Two stages, and only one of them is pushed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-4" value="Stage 1 · builder — &lt;span style=&quot;font-family: Courier New&quot;&gt;node:20-alpine&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="94" width="340" height="186" as="geometry"/></mxCell><mxCell id="b-5" value="the whole source tree, tests and configs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="128" width="312" height="26" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;node_modules&lt;/span&gt; — dev &lt;i&gt;and&lt;/i&gt; prod, ≈480 MB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="158" width="312" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="vite / tsc / eslint, the toolchain" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="188" width="312" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;dist/&lt;/span&gt; — the only useful output" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="218" width="312" height="26" as="geometry"/></mxCell><mxCell id="t-9" value="≈1.2 GB, discarded when the build ends. Never pushed, never run." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="250" width="312" height="26" as="geometry"/></mxCell><mxCell id="t-10" value="COPY&lt;br/&gt;--from=builder&lt;br/&gt;/app/dist" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="366" y="122" width="88" height="40" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="368" y="176" as="sourcePoint"/><mxPoint x="452" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-12" value="Stage 2 · runtime — &lt;span style=&quot;font-family: Courier New&quot;&gt;nginx:alpine&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="456" y="94" width="340" height="186" as="geometry"/></mxCell><mxCell id="b-13" value="nginx and its config" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="470" y="128" width="312" height="26" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;dist/&lt;/span&gt; — the hashed assets" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="470" y="158" width="312" height="26" as="geometry"/></mxCell><mxCell id="b-15" value="nothing else: no node, no npm, no source" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="470" y="188" width="312" height="26" as="geometry"/></mxCell><mxCell id="t-16" value="≈25 MB. This is what goes to the registry and runs in the cluster — a smaller image is a faster pull, a faster scale-up and a smaller attack surface." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="220" width="312" height="44" as="geometry"/></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="292" as="sourcePoint"/><mxPoint x="796" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-18" value="2 · Layer order decides your rebuild time — one source edit, twice" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="302" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-19" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;COPY . .&lt;/span&gt; before &lt;span style=&quot;font-family: Courier New&quot;&gt;npm ci&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="326" width="400" height="14" as="geometry"/></mxCell><mxCell id="b-20" value="FROM node:20-alpine&lt;br/&gt;cached" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="344" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-21" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="366" as="sourcePoint"/><mxPoint x="181" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-22" value="COPY . .&lt;br/&gt;invalidated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182" y="344" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="333" y="366" as="sourcePoint"/><mxPoint x="339" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-24" value="RUN npm ci&lt;br/&gt;re-runs — 90 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="344" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-25" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="491" y="366" as="sourcePoint"/><mxPoint x="497" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-26" value="RUN npm run build&lt;br/&gt;re-runs — 14 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="344" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-27" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="649" y="366" as="sourcePoint"/><mxPoint x="655" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-28" value="total ≈ 110 s&lt;br/&gt;every commit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="656" y="344" width="150" height="44" as="geometry"/></mxCell><mxCell id="t-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;COPY package*.json&lt;/span&gt; first" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="406" width="400" height="14" as="geometry"/></mxCell><mxCell id="b-30" value="FROM node:20-alpine&lt;br/&gt;cached" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="424" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="446" as="sourcePoint"/><mxPoint x="181" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-32" value="COPY package*.json&lt;br/&gt;+ RUN npm ci&lt;br/&gt;cached — 0 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182" y="424" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="333" y="446" as="sourcePoint"/><mxPoint x="339" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-34" value="COPY . .&lt;br/&gt;invalidated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="424" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-35" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="491" y="446" as="sourcePoint"/><mxPoint x="497" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-36" value="RUN npm run build&lt;br/&gt;re-runs — 14 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="424" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-37" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="649" y="446" as="sourcePoint"/><mxPoint x="655" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-38" value="total ≈ 16 s&lt;br/&gt;every commit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="656" y="424" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="488" as="sourcePoint"/><mxPoint x="796" y="488" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-40" value="3 · The frontend-specific trap: config baked into the bundle" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="498" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-41" value="Baked at build time" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="522" width="372" height="110" as="geometry"/></mxCell><mxCell id="b-42" value="ENV VITE_API_URL=https://api.prod.example.com" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="556" width="344" height="26" as="geometry"/></mxCell><mxCell id="t-43" value="A different image per environment, so staging never tested the artefact production runs. Any config change is a rebuild." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="586" width="344" height="34" as="geometry"/></mxCell><mxCell id="p-44" value="Fetched at runtime" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="424" y="522" width="372" height="110" as="geometry"/></mxCell><mxCell id="b-45" value="fetch(&amp;quot;/config.json&amp;quot;) on boot  ·  ConfigMap" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="438" y="556" width="344" height="26" as="geometry"/></mxCell><mxCell id="t-46" value="One image, promoted unchanged from staging to production. Only the mounted config differs." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="438" y="586" width="344" height="34" as="geometry"/></mxCell><mxCell id="b-47" value="Build once, run anywhere is not a slogan here — it is the reason the image must contain no environment. Say &amp;quot;the builder stage is thrown away and config is mounted, so the bytes that passed staging are the bytes in production.&amp;quot;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="646" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>