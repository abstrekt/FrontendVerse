tyle="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;shadow=0" vertex="1" parent="1"><mxGeometry x="614" y="122" width="182" height="88" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="268" as="sourcePoint"/><mxPoint x="796" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-20" value="Parallelised — tell the browser everything up front" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="278" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-21" value="HTML (streamed)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="302" width="162" height="24" as="geometry"/></mxCell><mxCell id="b-22" value="document" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="190" y="302" width="43.199999999999996" height="24" as="geometry"/></mxCell><mxCell id="t-23" value="CSS (critical inline)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="330" width="162" height="24" as="geometry"/></mxCell><mxCell id="b-24" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="190" y="330" width="6" height="24" as="geometry"/></mxCell><mxCell id="t-25" value="inlined — zero requests" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="202" y="330" width="220" height="24" as="geometry"/></mxCell><mxCell id="t-26" value="font (preload)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="358" width="162" height="24" as="geometry"/></mxCell><mxCell id="b-27" value="Inter.woff2" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="204.4" y="358" width="72" height="24" as="geometry"/></mxCell><mxCell id="t-28" value="hero (preload)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="386" width="162" height="24" as="geometry"/></mxCell><mxCell id="b-29" value="hero.avif" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="204.4" y="386" width="100.8" height="24" as="geometry"/></mxCell><mxCell id="t-30" value="API (server-rendered)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=