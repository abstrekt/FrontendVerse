nded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;shadow=0" vertex="1" parent="1"><mxGeometry x="415.2" y="302" width="248" height="74" as="geometry"/></mxCell><mxCell id="a-37" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="476" as="sourcePoint"/><mxPoint x="796" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-38" value="The five levers, in order of impact" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="484" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-39" value="Inline critical CSS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="508" width="144" height="30" as="geometry"/></mxCell><mxCell id="t-40" value="removes a blocking round trip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="538" width="144" height="26" as="geometry"/></mxCell><mxCell id="b-41" value="Preload the LCP image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="179" y="508" width="144" height="30" as="geometry"/></mxCell><mxCell id="t-42" value="found at parse, not after JSON" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="179" y="538" width="144" height="26" as="geometry"/></mxCell><mxCell id="b-43" value="defer / async the JS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="334" y="508" width="144" height="30" as="geometry"/></mxCell><mxCell id="t-44" value="stops blocking the parser" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="334" y="538" width="144" height="26" as="geometry"/></mxCell><mxCell id="b-45" value="Render data on the server" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="489" y="508" width="144" height="30" as="geometry"/></mxCell><mxCell id="t-46" value="removes a whole round trip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="489" y="538" width="144" height="26" as="geometry"/></mxCell><mxCell id="b-47" value="preconnect third parties" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="644" y="508" width="144" height="30" as="geometry"/></mxCell><mxCell id="t-48" value="DNS + TLS paid early" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="644" y="538" width="144" height="26" as="geometry"/></mxCell><mxCell id="b-49" value="Waterfalls are about DEPENDENCY, not bandwidth. Before optimising a single byte, ask what the browser could not know it needed yet — that question finds more milliseconds than compression ever will." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="568" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>