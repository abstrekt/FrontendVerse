<mxfile host="app.diagrams.net" type="device"><diagram name="Checkout — cart, payment and order boundaries" id="Checkout — cart, payment and order boundaries"><mxGraphModel dx="820" dy="584" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="584" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Checkout — three boundaries, three different rules" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="What the client may own, what it must never touch, and what must never happen twice" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Cart — the client may own it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="74" width="256" height="300" as="geometry"/></mxCell><mxCell id="b-4" value="Optimistic add and remove" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="110" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-5" value="The count updates before the server answers" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="138" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-6" value="Persist locally" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="176" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-7" value="A guest cart survives a reload; merge it on sign-in" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="204" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-8" value="Re-price on load" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="242" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-9" value="Never trust a stored price — the server decides" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="270" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-10" value="The cart is a wish, not a contract. Availability and price are only true at the moment the order is placed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="308" width="228" height="54" as="geometry"/></mxCell><mxCell id="p-11" value="Payment — you must not touch it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="282" y="74" width="256" height="300" as="geometry"/></mxCell><mxCell id="b-12" value="Hosted fields in an iframe" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="110" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-13" value="Stripe / Adyen own the card inputs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="138" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-14" value="Card data never reaches you" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="176" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-15" value="That is what keeps you out of PCI scope" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="204" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-16" value="You receive a token" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="242" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-17" value="Charge the token, never the number" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="270" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-18" value="Styling is limited and you cannot read the fields. That is the point — a card field you can read is a card field an XSS can read." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="308" width="228" height="54" as="geometry"/></mxCell><mxCell id="p-19" value="Order — it must happen once" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="540" y="74" width="256" height="300" as="geometry"/></mxCell><mxCell id="b-20" value="Idempotency key per intent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="110" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-21" value="Generated once, reused on every retry" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="138" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-22" value="Disable submit while pending" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="176" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-23" value="Necessary, and nowhere near sufficient" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="204" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-24" value="Reconcile, do not re-submit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="242" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-25" value="On an unclear failure, GET the order" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="554" y="270" width="228" height="30" as="geometry"/></mxCell><mxCell id="b-26" value="A dropped response is indistinguishable from a failure. Without a key, a retry double-charges — and the customer sees it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="308" width="228" height="54" as="geometry"/></mxCell><mxCell id="a-27" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=blockThin;startFill=1;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="224" as="sourcePoint"/><mxPoint x="278" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-28" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=blockThin;startFill=1;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="224" as="sourcePoint"/><mxPoint x="536" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="388" as="sourcePoint"/><mxPoint x="796" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-30" value="The state everyone forgets: payment succeeded, the response never arrived" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="396" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-31" value="Submit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="420" width="142" height="42" as="geometry"/></mxCell><mxCell id="a-32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="441" as="sourcePoint"/><mxPoint x="180" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-33" value="Charged" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182" y="420" width="142" height="42" as="geometry"/></mxCell><mxCell id="a-34" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="326" y="441" as="sourcePoint"/><mxPoint x="338" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-35" value="Response lost" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="420" width="142" height="42" as="geometry"/></mxCell><mxCell id="a-36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="484" y="441" as="sourcePoint"/><mxPoint x="496" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-37" value="User retries" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="420" width="142" height="42" as="geometry"/></mxCell><mxCell id="a-38" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="441" as="sourcePoint"/><mxPoint x="654" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-39" value="Key matches —&lt;br/&gt;same order returned" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="656" y="420" width="142" height="42" as="geometry"/></mxCell><mxCell id="b-40" value="Say the words &amp;quot;idempotency key&amp;quot; before you are asked. The double-charge is the failure this whole question is built around, and a disabled button does not prevent it — the second attempt comes from a refresh, a back button, or a phone that lost signal at exactly the wrong moment." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="478" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>