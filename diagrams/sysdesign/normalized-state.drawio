ticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="436" y="240" width="344" height="16" as="geometry"/></mxCell><mxCell id="pl-24" value="O(1)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="436" y="262" width="92" height="22" as="geometry"/></mxCell><mxCell id="t-25" value="and O(1) to delete" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="538" y="262" width="242" height="22" as="geometry"/></mxCell><mxCell id="t-26" value="2 · Why both halves" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="312" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;byId&lt;/span&gt; — the lookup&lt;br/&gt;An update is a spread of one entry, so nothing else in the store changes identity. Object key order is not something to render from." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="332" width="380" height="62" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;allIds&lt;/span&gt; — the order&lt;br/&gt;The list renders by mapping this array, so order is explicit. A sorted or filtered view is a second id array, never a re-sorted &lt;span style=&quot;font-family: Courier New&quot;&gt;byId&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="332" width="380" height="62" as="geometry"/></mxCell><mxCell id="t-29" value="3 · One copy, many readers" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="404" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-30" value="Entities reference each other by id, never by copy" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="424" width="772" height="100" as="geometry"/></mxCell><mxCell id="b-31" value="posts.byId[&amp;quot;p9&amp;quot;]&lt;br/&gt;{ id: &amp;quot;p9&amp;quot;, authorId: &amp;quot;u2&amp;quot; }" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="456" width="212" height="46" as="geometry"/></mxCell><mxCell id="a-32" value="authorId" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="479" as="sourcePoint"/><mxPoint x="336" y="479" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-33" value="users.byId[&amp;quot;u2&amp;quot;]&lt;br/&gt;{ name: &amp;quot;Bob&amp;quot; }" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="456" width="180" height="46" as="geometry"/></mxCell><mxCell id="a-34" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="479" as="sourcePoint"/><mxPoint x="590" y="479" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-35" value="post header" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="594" y="444" width="182" height="20" as="geometry"/></mxCell><mxCell id="b-36" value="comment list" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="594" y="468" width="182" height="20" as="geometry"/></mxCell><mxCell id="b-37" value="@mention chip" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="594" y="492" width="182" height="20" as="geometry"/></mxCell><mxCell id="t-38" value="4 · The same pattern, renamed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="534" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-39" value="Redux Toolkit's &lt;span style=&quot;font-family: Courier New&quot;&gt;createEntityAdapter&lt;/span&gt; calls the two halves &lt;b&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;entities&lt;/span&gt;&lt;/b&gt; and &lt;b&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;ids&lt;/span&gt;&lt;/b&gt; — the identical shape, plus &lt;span style=&quot;font-family: Courier New&quot;&gt;upsertOne&lt;/span&gt; / &lt;span style=&quot;font-family: Courier New&quot;&gt;removeMany&lt;/span&gt; / &lt;span style=&quot;font-family: Courier New&quot;&gt;getSelectors&lt;/span&gt; and a &lt;span style=&quot;font-family: Courier New&quot;&gt;sortComparer&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="554" width="772" height="38" as="geometry"/></mxCell><mxCell id="b-40" value="The dictionary answers &amp;quot;give me this one&amp;quot;; the array answers &amp;quot;in what order&amp;quot; — neither does the other job. And deleting an entity leaves its id behind in every array that referenced it, so decide on a cascade before you need one." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="606" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>