"108" height="14" as="geometry"/></mxCell><mxCell id="t-12" value="compare every id until one matches" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="240" width="344" height="16" as="geometry"/></mxCell><mxCell id="pl-13" value="O(n)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="262" width="92" height="22" as="geometry"/></mxCell><mxCell id="t-14" value="and O(n) again to delete" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="146" y="262" width="242" height="22" as="geometry"/></mxCell><mxCell id="p-15" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;byId&lt;/span&gt; + &lt;span style=&quot;font-family: Courier New&quot;&gt;allIds&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="90" width="380" height="212" as="geometry"/></mxCell><mxCell id="b-16" value="byId:   { u1: {…}, u2: {…}, u3: {…} }&lt;br/&gt;allIds: [&amp;quot;u1&amp;quot;, &amp;quot;u2&amp;quot;, &amp;quot;u3&amp;quot;]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="122" width="352" height="38" as="geometry"/></mxCell><mxCell id="b-17" value="u1&lt;br/&gt;Alice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;f