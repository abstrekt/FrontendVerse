<mxfile host="app.diagrams.net" type="device"><diagram name="Chat — message lifecycle, ordering and the reconnect gap" id="Chat — message lifecycle, ordering and the reconnect gap"><mxGraphModel dx="820" dy="616" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="616" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Chat — one message, and the gap you cannot see" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Optimistic send, server ordering, and what a two-minute disconnect does to both" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Four states, and the user must be able to tell them apart" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="sending" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="94" width="180" height="42" as="geometry"/></mxCell><mxCell id="pl-5" value="○" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="166" y="100" width="30" height="18" as="geometry"/></mxCell><mxCell id="t-6" value="local id only" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="136" width="180" height="14" as="geometry"/></mxCell><mxCell id="a-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206" y="115" as="sourcePoint"/><mxPoint x="218" y="115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-8" value="sent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="94" width="180" height="42" as="geometry"/></mxCell><mxCell id="pl-9" value="✓" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="362" y="100" width="30" height="18" as="geometry"/></mxCell><mxCell id="t-10" value="server has it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="220" y="136" width="180" height="14" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="115" as="sourcePoint"/><mxPoint x="414" y="115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="delivered" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="94" width="180" height="42" as="geometry"/></mxCell><mxCell id="pl-13" value="✓✓" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="558" y="100" width="30" height="18" as="geometry"/></mxCell><mxCell id="t-14" value="on their device" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="136" width="180" height="14" as="geometry"/></mxCell><mxCell id="a-15" value="or" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.3;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="115" as="sourcePoint"/><mxPoint x="610" y="115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="failed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="612" y="94" width="180" height="42" as="geometry"/></mxCell><mxCell id="pl-17" value="!" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="754" y="100" width="30" height="18" as="geometry"/></mxCell><mxCell id="t-18" value="retry or discard" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="136" width="180" height="14" as="geometry"/></mxCell><mxCell id="b-19" value="A message with no visible state is the bug users report as &amp;quot;it didn't send&amp;quot;. Render sending in a subdued style, and never let a failure look identical to a success." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="156" width="772" height="34" as="geometry"/></mxCell><mxCell id="t-20" value="2 · Two ids, because the client must render before the server answers" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="202" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-21" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="226" width="372" height="100" as="geometry"/></mxCell><mxCell id="t-22" value="client" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="232" width="344" height="14" as="geometry"/></mxCell><mxCell id="b-23" value="id: &amp;quot;tmp-8f3a&amp;quot;   ·   status: sending" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="252" width="344" height="26" as="geometry"/></mxCell><mxCell id="t-24" value="Rendered instantly with a client id. The idempotency key is&lt;br/&gt;this same id, so a retry cannot create a duplicate." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="282" width="344" height="36" as="geometry"/></mxCell><mxCell id="a-25" value="ack" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=9;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="276" as="sourcePoint"/><mxPoint x="420" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-26" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="226" width="372" height="100" as="geometry"/></mxCell><mxCell id="t-27" value="after the server answers" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="438" y="232" width="344" height="14" as="geometry"/></mxCell><mxCell id="b-28" value="id: &amp;quot;m-1042&amp;quot;   ·   seq: 1042   ·   status: sent" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="438" y="252" width="344" height="26" as="geometry"/></mxCell><mxCell id="t-29" value="Reconcile by client id, not by position. Order by the server&lt;br/&gt;sequence — client clocks disagree and cannot be trusted." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="438" y="282" width="344" height="36" as="geometry"/></mxCell><mxCell id="t-30" value="3 · The gap — what &amp;quot;reconnected&amp;quot; has to mean" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="338" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-31" value="Resume from &amp;quot;now&amp;quot;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="360" width="372" height="128" as="geometry"/></mxCell><mxCell id="b-32" value="1040" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-33" value="1041" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="104" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-34" value="1042 – 1045" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#7A1414;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="168" y="396" width="124" height="28" as="geometry"/></mxCell><mxCell id="b-35" value="1046" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="t-36" value="Messages 1042–1045 arrived while the socket was down.&lt;br/&gt;Nothing errors. The conversation is simply missing four&lt;br/&gt;messages and nobody is told." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="432" width="344" height="46" as="geometry"/></mxCell><mxCell id="p-37" value="Resume from the last seq you hold" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="424" y="360" width="372" height="128" as="geometry"/></mxCell><mxCell id="b-38" value="1040" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="440" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-39" value="1041" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="504" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-40" value="1042" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="568" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-41" value="1043" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="632" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="b-42" value="…" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="696" y="396" width="60" height="28" as="geometry"/></mxCell><mxCell id="t-43" value="GET /messages?after=1041 on reconnect, then replay the&lt;br/&gt;outbox. Idempotency keys make the replay safe even if the&lt;br/&gt;server already received some of it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="440" y="432" width="344" height="46" as="geometry"/></mxCell><mxCell id="b-44" value="The socket is a day of work; reconnect, resume-from-cursor, idempotent replay and message ordering are the quarter. Every one of those is a follow-up question, and &amp;quot;resume from now&amp;quot; is the wrong answer to all of them — it loses messages silently, which is the worst failure a chat app can have." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="502" width="772" height="46" as="geometry"/></mxCell><mxCell id="b-45" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="566" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-46" value="not yet acknowledged" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="562" width="130" height="18" as="geometry"/></mxCell><mxCell id="b-47" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="184" y="566" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-48" value="confirmed by the server" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="201" y="562" width="148.29999999999998" height="18" as="geometry"/></mxCell><mxCell id="b-49" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="362.29999999999995" y="566" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-50" value="silently lost" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="379.29999999999995" y="562" width="87.3" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>