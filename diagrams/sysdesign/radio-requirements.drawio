<mxfile host="app.diagrams.net" type="device"><diagram name="R — two lists and a cut line" id="R — two lists and a cut line"><mxGraphModel dx="820" dy="516" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="516" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="R — two lists and a cut line" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The stage is graded on the split and on the cut, not on the length of the lists" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Functional — what a user can DO" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="76" width="256" height="250" as="geometry"/></mxCell><mxCell id="b-4" value="Read the feed, newest first" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="108" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-5" value="Scroll for more, forever" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="142" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-6" value="Like a post, see the count move" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="176" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-7" value="Open a post and read replies" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="210" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-8" value="Verbs. If it has no verb it is not a functional requirement." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="38" y="284" width="228" height="34" as="geometry"/></mxCell><mxCell id="p-9" value="Non-functional — what it must BE" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="282" y="76" width="256" height="250" as="geometry"/></mxCell><mxCell id="b-10" value="p75 LCP &amp;lt; 2.5s on 4G / mid Android" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="108" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-11" value="INP &amp;lt; 200ms · CLS &amp;lt; 0.1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="142" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-12" value="WCAG 2.1 AA, keyboard + SR tested" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="176" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-13" value="Reads work offline from cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="210" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-14" value="12 locales, Arabic and Hebrew RTL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="296" y="244" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-15" value="Numbers. &amp;quot;Fast&amp;quot; is not a requirement; a p75 target is." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="296" y="284" width="228" height="34" as="geometry"/></mxCell><mxCell id="p-16" value="Out of scope — say it out loud" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="540" y="76" width="256" height="250" as="geometry"/></mxCell><mxCell id="b-17" value="Posting and editing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="108" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-18" value="Moderation and reporting" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="142" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-19" value="Notifications" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="176" width="228" height="28" as="geometry"/></mxCell><mxCell id="b-20" value="Direct messages" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="210" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-21" value="One sentence here buys you the rest of the interview." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="554" y="284" width="228" height="34" as="geometry"/></mxCell><mxCell id="a-22" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="344" as="sourcePoint"/><mxPoint x="796" y="344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-23" value="&amp;quot;I’ll design the feed read path and leave posting, moderation and notifications out — say if you’d rather I covered those instead.&amp;quot;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="358" width="772" height="44" as="geometry"/></mxCell><mxCell id="t-24" value="That sentence is the cut line. Without it, every later stage is a guess about a product nobody agreed on." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="406" width="772" height="14" as="geometry"/></mxCell><mxCell id="b-25" value="Interviewers grade the split and the cut, not the length. Functional gets verbs, non-functional gets numbers, and out-of-scope gets said out loud rather than assumed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="430" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>