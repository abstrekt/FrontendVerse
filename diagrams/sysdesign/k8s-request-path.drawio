<mxfile host="app.diagrams.net" type="device"><diagram name="Kubernetes for a frontend — the objects on the request path" id="Kubernetes for a frontend — the objects on the request path"><mxGraphModel dx="820" dy="608" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="608" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Kubernetes for a frontend — the objects on the request path" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Most of your traffic should never reach a pod at all" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Where each kind of request actually stops" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-4" value="A hashed asset — &lt;span style=&quot;font-family: Courier New&quot;&gt;GET /assets/app.8f3a2b.js&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="88" width="500" height="14" as="geometry"/></mxCell><mxCell id="b-5" value="Browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="106" width="120" height="44" as="geometry"/></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="146" y="128" as="sourcePoint"/><mxPoint x="184" y="128" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-7" value="CDN / edge" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="186" y="106" width="140" height="44" as="geometry"/></mxCell><mxCell id="b-8" value="Stops here. Immutable, hashed, cached at the edge — the cluster never sees it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="368" y="106" width="428" height="44" as="geometry"/></mxCell><mxCell id="t-9" value="The document and the API — &lt;span style=&quot;font-family: Courier New&quot;&gt;GET /&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;/api/*&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5145E5;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="168" width="500" height="14" as="geometry"/></mxCell><mxCell id="b-10" value="Browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="186" width="120" height="44" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="146" y="208" as="sourcePoint"/><mxPoint x="184" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="CDN / edge" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="186" y="186" width="140" height="44" as="geometry"/></mxCell><mxCell id="t-13" value="passes through, or caches the HTML briefly" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="178" y="232" width="156" height="34" as="geometry"/></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="328" y="208" as="sourcePoint"/><mxPoint x="366" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-15" value="&lt;b&gt;Ingress&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="368" y="186" width="140" height="44" as="geometry"/></mxCell><mxCell id="t-16" value="TLS, host and path routing, weights" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="360" y="232" width="156" height="34" as="geometry"/></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="208" as="sourcePoint"/><mxPoint x="548" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-18" value="&lt;b&gt;Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="550" y="186" width="120" height="44" as="geometry"/></mxCell><mxCell id="t-19" value="one stable name, load-balances the pods" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="542" y="232" width="136" height="34" as="geometry"/></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="208" as="sourcePoint"/><mxPoint x="710" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-21" value="&lt;b&gt;Pods&lt;/b&gt;&lt;br/&gt;×3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="712" y="186" width="84" height="44" as="geometry"/></mxCell><mxCell id="t-22" value="your container, replicated" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="704" y="232" width="100" height="34" as="geometry"/></mxCell><mxCell id="a-23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="276" as="sourcePoint"/><mxPoint x="796" y="276" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-24" value="2 · The five objects you must be able to name and draw" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="286" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-25" value="Deployment" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="310" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-26" value="The desired state: this image, this many replicas. Owns the rollout." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="342" width="150" height="46" as="geometry"/></mxCell><mxCell id="b-27" value="ReplicaSet → Pod" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182" y="310" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-28" value="What the Deployment creates. A pod is one running container set." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="182" y="342" width="150" height="46" as="geometry"/></mxCell><mxCell id="b-29" value="Service" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="310" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-30" value="A stable DNS name and virtual IP in front of pods that come and go." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="340" y="342" width="150" height="46" as="geometry"/></mxCell><mxCell id="b-31" value="Ingress" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="310" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-32" value="The HTTP door in: TLS termination, host/path rules, traffic splits." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="342" width="150" height="46" as="geometry"/></mxCell><mxCell id="b-33" value="ConfigMap / Secret" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="656" y="310" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-34" value="Environment, mounted at runtime. The same image, configured per cluster." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="656" y="342" width="150" height="46" as="geometry"/></mxCell><mxCell id="a-35" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="396" as="sourcePoint"/><mxPoint x="796" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-36" value="3 · The three probes — and the one that makes a rollout safe" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="406" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-37" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;startupProbe&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="430" width="252" height="28" as="geometry"/></mxCell><mxCell id="t-38" value="Gives a slow boot time to finish before the other two start judging it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="462" width="252" height="34" as="geometry"/></mxCell><mxCell id="b-39" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;readinessProbe&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="284" y="430" width="252" height="28" as="geometry"/></mxCell><mxCell id="t-40" value="Fails → the Service stops sending traffic. The pod keeps running." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="284" y="462" width="252" height="34" as="geometry"/></mxCell><mxCell id="b-41" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;livenessProbe&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="544" y="430" width="252" height="28" as="geometry"/></mxCell><mxCell id="t-42" value="Fails → the container is killed and restarted. Wrong tool for a slow boot." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="544" y="462" width="252" height="34" as="geometry"/></mxCell><mxCell id="b-43" value="No readiness probe → the rollout marks a pod ready the moment it starts, and sends real traffic to a process still building its first render." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="500" width="772" height="30" as="geometry"/></mxCell><mxCell id="b-44" value="What a frontend owes this platform is small and concrete: an image that starts fast, a readiness endpoint that tells the truth, config read at runtime, and assets served from the CDN rather than from a pod." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="542" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>