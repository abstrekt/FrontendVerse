<mxfile host="app.diagrams.net" type="device"><diagram name="Dashboard — independent widget queries" id="Dashboard — independent widget queries"><mxGraphModel dx="820" dy="572" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="572" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Dashboard — one slow query should not hold the page hostage" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Six widgets, one of them slow. The layout decides whether the reader waits for all six." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="One request for everything" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-4" value="GET /dashboard" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="24" y="96" width="120" height="26" as="geometry"/></mxCell><mxCell id="b-5" value="blocked on the slowest query — the cohort retention table" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="96" width="384" height="26" as="geometry"/></mxCell><mxCell id="t-6" value="everything appears at once" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="542" y="96" width="190" height="26" as="geometry"/></mxCell><mxCell id="t-7" value="the reader sees" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="142" width="120" height="20" as="geometry"/></mxCell><mxCell id="b-8" value="a page of spinners" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="140" width="384" height="20" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="178" as="sourcePoint"/><mxPoint x="796" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-10" value="One query per widget, rendered as each lands" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="188" width="772" height="16" as="geometry"/></mxCell><mxCell id="t-11" value="Active users" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="214" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-12" value="180 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="214" width="28.8" height="24" as="geometry"/></mxCell><mxCell id="b-13" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182.8" y="214" width="10" height="24" as="geometry"/></mxCell><mxCell id="t-14" value="Revenue today" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="244" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-15" value="240 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="244" width="38.4" height="24" as="geometry"/></mxCell><mxCell id="b-16" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="192.4" y="244" width="10" height="24" as="geometry"/></mxCell><mxCell id="t-17" value="Signups" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="274" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-18" value="320 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="274" width="51.2" height="24" as="geometry"/></mxCell><mxCell id="b-19" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="205.2" y="274" width="10" height="24" as="geometry"/></mxCell><mxCell id="t-20" value="Top pages" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="304" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-21" value="620 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="304" width="99.2" height="24" as="geometry"/></mxCell><mxCell id="b-22" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="253.2" y="304" width="10" height="24" as="geometry"/></mxCell><mxCell id="t-23" value="Error rate" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="334" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-24" value="780 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="334" width="124.8" height="24" as="geometry"/></mxCell><mxCell id="b-25" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="278.8" y="334" width="10" height="24" as="geometry"/></mxCell><mxCell id="t-26" value="Cohort retention" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="364" width="120" height="24" as="geometry"/></mxCell><mxCell id="b-27" value="2400 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="364" width="384" height="24" as="geometry"/></mxCell><mxCell id="b-28" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="538" y="364" width="10" height="24" as="geometry"/></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="178.8" y="398" as="sourcePoint"/><mxPoint x="178.8" y="386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-30" value="first widget usable at 180 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="186.8" y="392" width="220" height="14" as="geometry"/></mxCell><mxCell id="b-31" value="Each widget owns its own query, its own skeleton, and its own error boundary. A failing widget shows a retry in its own card; the other five are unaffected." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="556" y="214" width="208" height="150" as="geometry"/></mxCell><mxCell id="a-32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="420" as="sourcePoint"/><mxPoint x="796" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-33" value="Reserve the space, or independent loading costs you the layout" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="432" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-34" value="Skeletons sized to the real content — the grid never moves as widgets land" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="456" width="372" height="46" as="geometry"/></mxCell><mxCell id="b-35" value="Spinners in auto-height cards — six separate layout shifts, and a CLS failure" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="456" width="372" height="46" as="geometry"/></mxCell><mxCell id="b-36" value="Independent widgets is the easy half. The half people miss is that six things arriving at six different times is six chances to reflow the page — so every widget gets a fixed-height skeleton before it gets a query." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="512" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>