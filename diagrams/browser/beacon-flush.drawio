<mxfile host="app.diagrams.net" type="device"><diagram name="Shipping RUM data — the flush that survives the page going away" id="Shipping RUM data — the flush that survives the page going away"><mxGraphModel dx="820" dy="596" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="596" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Shipping RUM data — the flush that survives the page going away" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Collect into an array, flush once on &lt;span style=&quot;font-family: Courier New&quot;&gt;visibilitychange&lt;/span&gt;, hand the request to the browser" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Collect — one array, not one request per entry" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="72" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="PerformanceObserver" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="94" width="168" height="32" as="geometry"/></mxCell><mxCell id="a-5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="110" as="sourcePoint"/><mxPoint x="226" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-6" value="callback(list)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="230" y="94" width="150" height="32" as="geometry"/></mxCell><mxCell id="a-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="384" y="110" as="sourcePoint"/><mxPoint x="414" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-8" value="metrics[] — LCP · CLS · INP · your own marks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="418" y="94" width="378" height="32" as="geometry"/></mxCell><mxCell id="t-9" value="push and return — the callback runs on the main thread you are trying to measure" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="130" width="772" height="14" as="geometry"/></mxCell><mxCell id="t-10" value="2 · Flush — the lifecycle event that actually fires" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="156" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-11" value="visible" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="178" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-12" value="hidden — tab or app switch" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="228" y="178" width="190" height="30" as="geometry"/></mxCell><mxCell id="b-13" value="frozen / bfcache" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="442" y="178" width="156" height="30" as="geometry"/></mxCell><mxCell id="b-14" value="terminated" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="622" y="178" width="174" height="30" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="198" y="193" as="sourcePoint"/><mxPoint x="224" y="193" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="422" y="193" as="sourcePoint"/><mxPoint x="438" y="193" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="602" y="193" as="sourcePoint"/><mxPoint x="618" y="193" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-18" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;unload&lt;/span&gt; / &lt;span style=&quot;font-family: Courier New&quot;&gt;beforeunload&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="224" width="236" height="26" as="geometry"/></mxCell><mxCell id="t-19" value="Unreliable on mobile — a swiped-away tab often never fires it. Registering either handler also disqualifies the page from the back/forward cache." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="274" y="221" width="522" height="34" as="geometry"/></mxCell><mxCell id="pl-20" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;fetch()&lt;/span&gt; in the handler" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="270" width="236" height="26" as="geometry"/></mxCell><mxCell id="t-21" value="The document is being torn down, so the browser cancels the in-flight request. &lt;span style=&quot;font-family: Courier New&quot;&gt;keepalive: true&lt;/span&gt; is the escape hatch, and it shares the same 64KB budget." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="274" y="267" width="522" height="34" as="geometry"/></mxCell><mxCell id="pl-22" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;visibilitychange&lt;/span&gt; → &lt;span style=&quot;font-family: Courier New&quot;&gt;sendBeacon&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="316" width="236" height="26" as="geometry"/></mxCell><mxCell id="t-23" value="Fires on every hide, including the ones that end in termination. The browser takes ownership of the request and sends it after the page is gone." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="274" y="313" width="522" height="34" as="geometry"/></mxCell><mxCell id="a-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="376" as="sourcePoint"/><mxPoint x="796" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-25" value="3 · What &lt;span style=&quot;font-family: Courier New&quot;&gt;sendBeacon&lt;/span&gt; will not do for you" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="388" width="772" height="116" as="geometry"/></mxCell><mxCell id="pl-26" value="returns &lt;span style=&quot;font-family: Courier New&quot;&gt;true&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="420" width="108" height="22" as="geometry"/></mxCell><mxCell id="t-27" value="— queued, not delivered" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="160" y="420" width="250" height="22" as="geometry"/></mxCell><mxCell id="pl-28" value="no response" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="428" y="420" width="108" height="22" as="geometry"/></mxCell><mxCell id="t-29" value="— fire and forget, nothing to read" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="544" y="420" width="250" height="22" as="geometry"/></mxCell><mxCell id="pl-30" value="~64KB cap" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="458" width="108" height="22" as="geometry"/></mxCell><mxCell id="t-31" value="— over it, it returns &lt;span style=&quot;font-family: Courier New&quot;&gt;false&lt;/span&gt; and sends nothing" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="160" y="458" width="250" height="22" as="geometry"/></mxCell><mxCell id="pl-32" value="text/plain" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="428" y="458" width="108" height="22" as="geometry"/></mxCell><mxCell id="t-33" value="— wrap the JSON in a Blob to set the type; CORS still applies" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="544" y="458" width="250" height="22" as="geometry"/></mxCell><mxCell id="b-34" value="Buffer in memory, flush once when the page is hidden, and let the browser own the send. A &lt;span style=&quot;font-family: Courier New&quot;&gt;fetch()&lt;/span&gt; on the way out is cancelled; an &lt;span style=&quot;font-family: Courier New&quot;&gt;unload&lt;/span&gt; handler costs you the bfcache." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="522" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>