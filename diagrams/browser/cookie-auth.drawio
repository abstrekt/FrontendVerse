<mxfile host="app.diagrams.net" type="device"><diagram name="Cookie auth — the round trip, the attributes, the two attacks" id="Cookie auth — the round trip, the attributes, the two attacks"><mxGraphModel dx="820" dy="622" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="622" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Cookie auth — the browser does the carrying" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Log in once; every later request is authenticated without a line of JavaScript" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The round trip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;1 · Login&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;POST /login&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="96" width="144" height="66" as="geometry"/></mxCell><mxCell id="t-5" value="Credentials leave the client exactly once, over HTTPS." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="166" width="144" height="34" as="geometry"/></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="129" as="sourcePoint"/><mxPoint x="181" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-7" value="&lt;b&gt;2 · Verify&lt;/b&gt;&lt;br/&gt;server checks the password" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="183" y="96" width="144" height="66" as="geometry"/></mxCell><mxCell id="t-8" value="A session id or a signed JWT is minted server-side." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="183" y="166" width="144" height="34" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="329" y="129" as="sourcePoint"/><mxPoint x="340" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-10" value="&lt;b&gt;3 · &lt;span style=&quot;font-family: Courier New&quot;&gt;Set-Cookie:&lt;/span&gt;&lt;/b&gt;&lt;br/&gt;response header" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="342" y="96" width="144" height="66" as="geometry"/></mxCell><mxCell id="t-11" value="The only way to set &lt;span style=&quot;font-family: Courier New&quot;&gt;HttpOnly&lt;/span&gt; — JS cannot." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="342" y="166" width="144" height="34" as="geometry"/></mxCell><mxCell id="a-12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="488" y="129" as="sourcePoint"/><mxPoint x="499" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-13" value="&lt;b&gt;4 · Stored&lt;/b&gt;&lt;br/&gt;the browser cookie jar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="501" y="96" width="144" height="66" as="geometry"/></mxCell><mxCell id="t-14" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;document.cookie&lt;/span&gt; never shows it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="501" y="166" width="144" height="34" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="647" y="129" as="sourcePoint"/><mxPoint x="658" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="&lt;b&gt;5 · Every request&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;Cookie: auth_token=…&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="660" y="96" width="144" height="66" as="geometry"/></mxCell><mxCell id="t-17" value="Attached automatically, to matching Domain + Path." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="660" y="166" width="144" height="34" as="geometry"/></mxCell><mxCell id="a-18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="208" as="sourcePoint"/><mxPoint x="796" y="208" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-19" value="2 · The attributes — each one closes a specific door" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="218" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-20" value="Set-Cookie: auth_token=…; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=604800" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="242" width="772" height="30" as="geometry"/></mxCell><mxCell id="b-21" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;HttpOnly&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="286" width="150" height="30" as="geometry"/></mxCell><mxCell id="t-22" value="JavaScript cannot read it. An XSS payload gets nothing." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="320" width="150" height="44" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Secure&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="182" y="286" width="150" height="30" as="geometry"/></mxCell><mxCell id="t-24" value="HTTPS only — nothing to intercept in plaintext." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="182" y="320" width="150" height="44" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;SameSite=Lax&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="286" width="150" height="30" as="geometry"/></mxCell><mxCell id="t-26" value="Withheld on cross-site POSTs. This is the CSRF fix." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="340" y="320" width="150" height="44" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Path=/&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="498" y="286" width="150" height="30" as="geometry"/></mxCell><mxCell id="t-28" value="Which URLs the cookie rides along with." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="498" y="320" width="150" height="44" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Max-Age&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="656" y="286" width="150" height="30" as="geometry"/></mxCell><mxCell id="t-30" value="Seconds until the browser drops it on its own." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="656" y="320" width="150" height="44" as="geometry"/></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="372" as="sourcePoint"/><mxPoint x="796" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-32" value="3 · The two attacks — and why the trade is worth it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="382" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-33" value="XSS — a script is running on your page" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="406" width="380" height="148" as="geometry"/></mxCell><mxCell id="b-34" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage.getItem(&amp;quot;t&amp;quot;)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="442" width="186" height="26" as="geometry"/></mxCell><mxCell id="a-35" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228" y="455" as="sourcePoint"/><mxPoint x="244" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-36" value="stolen" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="442" width="142" height="26" as="geometry"/></mxCell><mxCell id="b-37" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;HttpOnly&lt;/span&gt; cookie" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="476" width="186" height="26" as="geometry"/></mxCell><mxCell id="a-38" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228" y="489" as="sourcePoint"/><mxPoint x="244" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-39" value="unreadable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="248" y="476" width="142" height="26" as="geometry"/></mxCell><mxCell id="t-40" value="One compromised dependency reads every key in &lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt;. It cannot read the cookie, because the browser will not hand it over." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="512" width="352" height="34" as="geometry"/></mxCell><mxCell id="p-41" value="CSRF — &lt;span style=&quot;font-family: Courier New&quot;&gt;evil.com&lt;/span&gt; posts to your API" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="406" width="380" height="148" as="geometry"/></mxCell><mxCell id="b-42" value="cookie, no &lt;span style=&quot;font-family: Courier New&quot;&gt;SameSite&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="442" width="186" height="26" as="geometry"/></mxCell><mxCell id="a-43" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="455" as="sourcePoint"/><mxPoint x="636" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-44" value="rides along" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="640" y="442" width="142" height="26" as="geometry"/></mxCell><mxCell id="b-45" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;SameSite=Lax&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="476" width="186" height="26" as="geometry"/></mxCell><mxCell id="a-46" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="489" as="sourcePoint"/><mxPoint x="636" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-47" value="withheld" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="640" y="476" width="142" height="26" as="geometry"/></mxCell><mxCell id="t-48" value="The cookie’s own weakness: it is attached automatically, so a forged cross-site request is authenticated too. &lt;span style=&quot;font-family: Courier New&quot;&gt;SameSite&lt;/span&gt; is the answer." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="512" width="352" height="34" as="geometry"/></mxCell><mxCell id="b-49" value="An &lt;span style=&quot;font-family: Courier New&quot;&gt;HttpOnly&lt;/span&gt; cookie trades an attack you cannot fully prevent (XSS reading a token) for one you close with a single attribute (&lt;span style=&quot;font-family: Courier New&quot;&gt;SameSite&lt;/span&gt;). That is the whole argument for putting the session in a cookie and the theme in &lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="566" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>