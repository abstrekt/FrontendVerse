<mxfile host="app.diagrams.net" type="device"><diagram name="IntersectionObserver — root, rootMargin, threshold" id="IntersectionObserver — root, rootMargin, threshold"><mxGraphModel dx="820" dy="690" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="690" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="IntersectionObserver — let the browser watch visibility for you" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="No scroll listener, no forced layout: the callback runs only when a threshold is crossed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · The work moves off your scroll handler" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-4" value="Legacy — The Nervous Checker" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="94" width="378" height="134" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;scroll&lt;/span&gt; fires ~60×/s → your handler runs&lt;br/&gt;&lt;span style=&quot;font-family: Courier New&quot;&gt;getBoundingClientRect()&lt;/span&gt; → &lt;b&gt;forced layout&lt;/b&gt; each time&lt;br/&gt;all on the &lt;b&gt;main thread&lt;/b&gt;, even when nothing changed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="128" width="350" height="86" as="geometry"/></mxCell><mxCell id="p-6" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;IntersectionObserver&lt;/span&gt; — The Lookout" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="94" width="378" height="134" as="geometry"/></mxCell><mxCell id="b-7" value="browser computes intersections &lt;b&gt;during its own rendering&lt;/b&gt;&lt;br/&gt;no per-pixel work in your code&lt;br/&gt;callback &lt;b&gt;batched&lt;/b&gt;, only when a threshold is crossed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="432" y="128" width="350" height="86" as="geometry"/></mxCell><mxCell id="a-8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="242" as="sourcePoint"/><mxPoint x="796" y="242" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-9" value="2 · &lt;span style=&quot;font-family: Courier New&quot;&gt;root&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;rootMargin&lt;/span&gt; and what counts as intersecting" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="250" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-10" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;root&lt;/span&gt; — the viewport (&lt;span style=&quot;font-family: Courier New&quot;&gt;null&lt;/span&gt;)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="60" y="278" width="220" height="146" as="geometry"/></mxCell><mxCell id="b-11" value="target &lt;b&gt;A&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="90" y="322" width="160" height="40" as="geometry"/></mxCell><mxCell id="b-12" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="60" y="430" width="220" height="50" as="geometry"/></mxCell><mxCell id="b-13" value="target &lt;b&gt;B&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="90" y="440" width="160" height="30" as="geometry"/></mxCell><mxCell id="b-14" value="target &lt;b&gt;C&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="90" y="500" width="160" height="30" as="geometry"/></mxCell><mxCell id="t-15" value="&lt;b&gt;A&lt;/b&gt; — inside the root. &lt;span style=&quot;font-family: Courier New&quot;&gt;isIntersecting: true&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;intersectionRatio: 1&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="322" width="496" height="40" as="geometry"/></mxCell><mxCell id="t-16" value="&lt;b&gt;B&lt;/b&gt; — still offscreen, but inside &lt;span style=&quot;font-family: Courier New&quot;&gt;rootMargin: &amp;quot;0px 0px 50px 0px&amp;quot;&lt;/span&gt;, which grows the root 50px downward. Counts as intersecting → &lt;b&gt;load it early&lt;/b&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="430" width="496" height="50" as="geometry"/></mxCell><mxCell id="t-17" value="&lt;b&gt;C&lt;/b&gt; — outside root + margin. No callback, zero cost." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="500" width="496" height="30" as="geometry"/></mxCell><mxCell id="a-18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="546" as="sourcePoint"/><mxPoint x="796" y="546" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-19" value="3 · &lt;span style=&quot;font-family: Courier New&quot;&gt;threshold: [0, 0.25, 0.5, 0.75, 1]&lt;/span&gt; — one callback per crossing" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="554" width="772" height="16" as="geometry"/></mxCell><mxCell id="pl-20" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;0&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="580" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-21" value="first pixel visible" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="606" width="150" height="16" as="geometry"/></mxCell><mxCell id="a-22" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="592" as="sourcePoint"/><mxPoint x="181" y="592" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-23" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;0.25&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="182" y="580" width="150" height="24" as="geometry"/></mxCell><mxCell id="t-24" value="a quarter in" style="html=1;whiteSpace=wrap;strokeColor=none;