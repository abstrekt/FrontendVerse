<mxfile host="app.diagrams.net" type="device"><diagram name="The life of a request — DNS, TCP, TLS, TTFB" id="The life of a request — DNS, TCP, TLS, TTFB"><mxGraphModel dx="820" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="560" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="The life of a request" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Three round trips of setup before your request is even sent — on mobile, that is most of the wait" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · A cold request, 180 ms round trip" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;DNS&lt;/b&gt;&lt;br/&gt;120 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="96" width="100.93333333333334" height="40" as="geometry"/></mxCell><mxCell id="t-5" value="resolve the hostname" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="4" y="140" width="140.93333333333334" height="26" as="geometry"/></mxCell><mxCell id="t-6" value="120 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="86.93333333333334" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;TCP&lt;/b&gt;&lt;br/&gt;180 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="126.93333333333334" y="96" width="152.4" height="40" as="geometry"/></mxCell><mxCell id="t-8" value="SYN · SYN-ACK · ACK" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="106.93333333333334" y="140" width="192.4" height="26" as="geometry"/></mxCell><mxCell id="t-9" value="300 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="241.33333333333337" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;TLS&lt;/b&gt;&lt;br/&gt;180 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="281.33333333333337" y="96" width="152.4" height="40" as="geometry"/></mxCell><mxCell id="t-11" value="certificate and keys" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="261.33333333333337" y="140" width="192.4" height="26" as="geometry"/></mxCell><mxCell id="t-12" value="480 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="395.73333333333335" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;b&gt;request&lt;/b&gt;&lt;br/&gt;90 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="435.73333333333335" y="96" width="75.2" height="40" as="geometry"/></mxCell><mxCell id="t-14" value="your bytes leave" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="415.73333333333335" y="140" width="115.2" height="26" as="geometry"/></mxCell><mxCell id="t-15" value="570 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="472.9333333333334" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;TTFB&lt;/b&gt;&lt;br/&gt;130 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="512.9333333333334" y="96" width="109.5111111111111" height="40" as="geometry"/></mxCell><mxCell id="t-17" value="server thinks" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="492.9333333333334" y="140" width="149.51111111111112" height="26" as="geometry"/></mxCell><mxCell id="t-18" value="700 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="584.4444444444445" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-19" value="&lt;b&gt;download&lt;/b&gt;&lt;br/&gt;200 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="624.4444444444445" y="96" width="169.55555555555554" height="40" as="geometry"/></mxCell><mxCell id="t-20" value="the body streams in" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="604.4444444444445" y="140" width="209.55555555555554" height="26" as="geometry"/></mxCell><mxCell id="t-21" value="900 ms" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=7.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="740" y="172" width="76" height="12" as="geometry"/></mxCell><mxCell id="b-22" value="setup — nothing useful transferred" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="192" width="409.73333333333335" height="26" as="geometry"/></mxCell><mxCell id="b-23" value="actually moving your page" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="435.73333333333335" y="192" width="358.26666666666665" height="26" as="geometry"/></mxCell><mxCell id="a-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="236" as="sourcePoint"/><mxPoint x="796" y="236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-25" value="2 · The second request to the same origin" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="246" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-26" value="DNS&lt;br/&gt;skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="272" width="100.93333333333334" height="34" as="geometry"/></mxCell><mxCell id="b-27" value="TCP&lt;br/&gt;skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="126.93333333333334" y="272" width="152.4" height="34" as="geometry"/></mxCell><mxCell id="b-28" value="TLS&lt;br/&gt;skipped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1A1D26;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="281.33333333333337" y="272" width="152.4" height="34" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;b&gt;request&lt;/b&gt;&lt;br/&gt;90 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="435.73333333333335" y="272" width="75.2" height="34" as="geometry"/></mxCell><mxCell id="b-30" value="&lt;b&gt;TTFB&lt;/b&gt;&lt;br/&gt;130 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="512.9333333333334" y="272" width="109.5111111111111" height="34" as="geometry"/></mxCell><mxCell id="b-31" value="&lt;b&gt;download&lt;/b&gt;&lt;br/&gt;200 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="624.4444444444445" y="272" width="169.55555555555554" height="34" as="geometry"/></mxCell><mxCell id="t-32" value="Connection reuse removes 480 ms. This is why origin count is a performance decision, and why one &lt;span style=&quot;font-family: Courier New&quot;&gt;preconnect&lt;/span&gt; can beat a week of code splitting." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="312" width="772" height="14" as="geometry"/></mxCell><mxCell id="a-33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="336" as="sourcePoint"/><mxPoint x="796" y="336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-34" value="3 · What each phase actually responds to" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="346" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-35" value="DNS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="370" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-36" value="Fewer origins · &lt;span style=&quot;font-family: Courier New&quot;&gt;preconnect&lt;/span&gt; · sane record TTLs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="400" width="178" height="46" as="geometry"/></mxCell><mxCell id="b-37" value="TCP + TLS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="370" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-38" value="Connection reuse · TLS 1.3 · terminate at a nearby CDN PoP" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="400" width="178" height="46" as="geometry"/></mxCell><mxCell id="b-39" value="TTFB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="370" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-40" value="Server work, cache hits, and physical distance to the user" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="400" width="178" height="46" as="geometry"/></mxCell><mxCell id="b-41" value="Download" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="370" width="178" height="26" as="geometry"/></mxCell><mxCell id="t-42" value="Brotli · smaller payloads · the first 14 kB matter most" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="400" width="178" height="46" as="geometry"/></mxCell><mxCell id="b-43" value="Every extra origin pays DNS + TCP + TLS again — and cache partitioning means a &amp;quot;shared&amp;quot; CDN copy of a library is no longer shared between sites. Self-host, and &lt;span style=&quot;font-family: Courier New&quot;&gt;preconnect&lt;/span&gt; to what is left." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="452" width="772" height="32" as="geometry"/></mxCell><mxCell id="b-44" value="Split a slow TTFB before you theorise about it: DNS, connect, TLS and server time are four different problems with four different fixes, and the waterfall already tells you which one you have." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="494" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>