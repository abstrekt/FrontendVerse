<mxfile host="app.diagrams.net" type="device"><diagram name="Scope — localStorage is origin-locked, a cookie is not" id="Scope — localStorage is origin-locked, a cookie is not"><mxGraphModel dx="820" dy="590" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="590" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Scope — &lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt; is origin-locked, a cookie is not" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Everything below was set by one page: &lt;span style=&quot;font-family: Courier New&quot;&gt;https://shop.example.com/app&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="1 · Who can see it, from where" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="localStorage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="92" width="196" height="26" as="geometry"/></mxCell><mxCell id="b-5" value="sessionStorage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="92" width="196" height="26" as="geometry"/></mxCell><mxCell id="b-6" value="cookie" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="92" width="196" height="26" as="geometry"/></mxCell><mxCell id="t-7" value="scope tested →" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="92" width="170" height="26" as="geometry"/></mxCell><mxCell id="t-8" value="Another tab on the &lt;b&gt;same origin&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="126" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-9" value="✓  shared" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="126" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-10" value="—  tab-local, a fresh store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="126" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-11" value="✓  shared" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="126" width="196" height="30" as="geometry"/></mxCell><mxCell id="t-12" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;login.example.com&lt;/span&gt;&lt;br/&gt;(sibling subdomain)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="162" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-13" value="—  different origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="162" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-14" value="—  different origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="162" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-15" value="✓  with &lt;span style=&quot;font-family: Courier New&quot;&gt;Domain=example.com&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="162" width="196" height="30" as="geometry"/></mxCell><mxCell id="t-16" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;http://&lt;/span&gt; instead of &lt;span style=&quot;font-family: Courier New&quot;&gt;https://&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="198" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-17" value="—  scheme is part of the origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="198" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-18" value="—  scheme is part of the origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="198" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-19" value="✓  unless &lt;span style=&quot;font-family: Courier New&quot;&gt;Secure&lt;/span&gt; is set" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="198" width="196" height="30" as="geometry"/></mxCell><mxCell id="t-20" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;shop.example.com:3000&lt;/span&gt;&lt;br/&gt;(another port)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="234" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-21" value="—  port is part of the origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="234" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-22" value="—  port is part of the origin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="234" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-23" value="✓  cookies ignore the port" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="234" width="196" height="30" as="geometry"/></mxCell><mxCell id="t-24" value="Sent to the &lt;b&gt;server&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="270" width="170" height="30" as="geometry"/></mxCell><mxCell id="b-25" value="—  JS must attach it by hand" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="270" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-26" value="—  JS must attach it by hand" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="270" width="196" height="30" as="geometry"/></mxCell><mxCell id="b-27" value="✓  every request, automatically" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="270" width="196" height="30" as="geometry"/></mxCell><mxCell id="t-28" value="Origin = scheme + host + port. A cookie is scoped by none of those three — it is scoped by &lt;span style=&quot;font-family: Courier New&quot;&gt;Domain&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;Path&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="306" width="772" height="14" as="geometry"/></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="328" as="sourcePoint"/><mxPoint x="796" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-30" value="2 · &lt;span style=&quot;font-family: Courier New&quot;&gt;Path&lt;/span&gt; — an axis &lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt; does not have at all" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="338" width="772" height="16" as="geometry"/></mxCell><mxCell id="p-31" value="Cookie set with &lt;span style=&quot;font-family: Courier New&quot;&gt;Path=/admin&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="362" width="380" height="156" as="geometry"/></mxCell><mxCell id="b-32" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;GET /admin/users&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="400" width="176" height="28" as="geometry"/></mxCell><mxCell id="a-33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="218" y="414" as="sourcePoint"/><mxPoint x="236" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-34" value="sent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="240" y="400" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-35" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;GET /shop/cart&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="436" width="176" height="28" as="geometry"/></mxCell><mxCell id="a-36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="218" y="450" as="sourcePoint"/><mxPoint x="236" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-37" value="not sent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="240" y="436" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-38" value="The path prefix decides which requests carry it. Narrowing &lt;span style=&quot;font-family: Courier New&quot;&gt;Path&lt;/span&gt; shrinks the blast radius of a leak." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="474" width="352" height="32" as="geometry"/></mxCell><mxCell id="p-39" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt; on &lt;span style=&quot;font-family: Courier New&quot;&gt;example.com&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="362" width="380" height="156" as="geometry"/></mxCell><mxCell id="b-40" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;/admin/users&lt;/span&gt; page" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="400" width="176" height="28" as="geometry"/></mxCell><mxCell id="a-41" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0EA5E9;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="414" as="sourcePoint"/><mxPoint x="628" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-42" value="readable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="632" y="400" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-43" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;/shop/cart&lt;/span&gt; page" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="436" width="176" height="28" as="geometry"/></mxCell><mxCell id="a-44" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0EA5E9;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="450" as="sourcePoint"/><mxPoint x="628" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-45" value="readable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=9;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="632" y="436" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-46" value="Path is not part of an origin, so every page on the host reads the same store. There is no narrowing it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="430" y="474" width="352" height="32" as="geometry"/></mxCell><mxCell id="b-47" value="One sentence to say out loud: the Storage APIs are scoped to an &lt;b&gt;origin&lt;/b&gt; and never leave the browser; a cookie is scoped to a &lt;b&gt;domain and a path&lt;/b&gt; and is attached to every matching request. That is why the token lives in the cookie and the dark-mode flag lives in &lt;span style=&quot;font-family: Courier New&quot;&gt;localStorage&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="534" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>