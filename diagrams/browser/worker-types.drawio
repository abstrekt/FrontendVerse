n=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="302" width="210" height="34" as="geometry"/></mxCell><mxCell id="a-11" value="fetch" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236" y="258" as="sourcePoint"/><mxPoint x="322" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-12" value="1 : 1 — dies when its tab closes" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#0EA5E9;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="340" width="210" height="14" as="geometry"/></mxCell><mxCell id="b-13" value="Service Worker&lt;br/&gt;&lt;br/&gt;the network proxy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="324" y="104" width="180" height="232" as="geometry"/></mxCell><mxCell id="t-14" value="1 : many — outlives every tab" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#D97706;fontSize=8.5;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="324" y="340" width="180" height="14" as="geometry"/></mxCell><mxCell id="b-15" value="Cache Storage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="584" y="104" width="212" height="44" as="geometry"/></mxCell><mxCell id="b-16" value="Network" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="584" y="236" width="212" height="44" as="geometry"/></mxCell><mxCell id="a-17" value="hit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506" y="126" as="sourcePoint"/><mxPoint x="582" y="126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-18" value="miss" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=8.5;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506" y="258" as="sourcePoint"/><mxPoint x="582" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-19" value="Answered offline, with no network at all." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="584" y="152" width="212" height="28" as="geometry"/></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="362" as="sourcePoint"/><mxPoint x="796" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-21" value="Web worker — a compute worker" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="376" width="380" height="148" as="geometry"/></mxCell><mxCell id="pl-22" value="Purpose: move CPU work off the main thread" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="42" y="408" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-23" value="Lifetime: tied to the tab that spawned it" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="42" y="434" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-24" value="Network: cannot intercept a single request" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="42" y="460" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-25" value="Woken by: postMessage, and nothing else" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="42" y="486" width="344" height="20" as="geometry"/></mxCell><mxCell id="p-26" value="Service worker — a network worker" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="416" y="376" width="380" height="148" as="geometry"/></mxCell><mxCell id="pl-27" value="Purpose: cache, offline, background delivery" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="434" y="408" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-28" value="Lifetime: independent of tabs; wakes on events" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="434" y="434" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-29" value="Network: intercepts every fetch in its scope" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="434" y="460" width="344" height="20" as="geometry"/></mxCell><mxCell id="pl-30" value="Woken by: install, activate, fetch, push, sync" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="434" y="486" width="344" height="20" as="geometry"/></mxCell><mxCell id="b-31" value="Both run off the main thread with no DOM, and that is where the similarity ends. Reach for a web worker when the main thread is busy; reach for a service worker when the network is the problem." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="540" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>