<mxfile host="app.diagrams.net" type="device"><diagram name="Web worker vs service worker — same thread trick, opposite jobs" id="Web worker vs service worker — same thread trick, opposite jobs"><mxGraphModel dx="820" dy="606" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="606" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Web worker vs service worker — same thread trick, opposite jobs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="One moves computation off the main thread; the other sits on the network path" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="Two tabs of the same origin, two web workers, one service worker" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="74" width="772" height="16" as="geometry"/></mxCell><mxCell id="b-4" value="Tab A — page thread" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="104" width="210" height="44" as="geometry"/></mxCell><mxCell id="a-5" value="postMessage" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=blockThin;startFill=1;endArrow=blockThi