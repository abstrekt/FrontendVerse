<mxfile host="app.diagrams.net" type="device"><diagram name="HTTP/1.1, HTTP/2, HTTP/3 — where head-of-line blocking lives" id="HTTP/1.1, HTTP/2, HTTP/3 — where head-of-line blocking lives"><mxGraphModel dx="820" dy="616" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="616" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="HTTP/1.1, HTTP/2, HTTP/3 — one problem, pushed one layer down each time" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Head-of-line blocking: the request queue, then TCP, then nothing" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="t-3" value="HTTP/1.1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="96" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-4" value="One request at a time per connection. Browsers opened ~6 connections to compensate." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="84" width="646" height="14" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;app.js&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="104" width="291.6363636363636" height="30" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;style.css&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="443.6363636363636" y="104" width="203.54545454545462" height="30" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;logo.svg&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="649.1818181818182" y="104" width="115.45454545454538" height="30" as="geometry"/></mxCell><mxCell id="t-8" value="one connection" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="140" width="120" height="26" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="443.6363636363636" y="164" as="sourcePoint"/><mxPoint x="443.6363636363636" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-10" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;style.css&lt;/span&gt; queued behind it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="353.6363636363636" y="164" width="180" height="14" as="geometry"/></mxCell><mxCell id="b-11" value="Blocking is in the &lt;b&gt;HTTP queue&lt;/b&gt; — a slow response holds up everything behind it." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="180" width="646" height="26" as="geometry"/></mxCell><mxCell id="t-12" value="HTTP/2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D97706;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="240" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-13" value="One connection, many interleaved streams, compressed headers." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="228" width="646" height="14" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;app.js&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="248" width="86.09090909090907" height="30" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;style&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="238.09090909090907" y="248" width="71.40909090909093" height="30" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;logo&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="311.5" y="248" width="56.72727272727275" height="30" as="geometry"/></mxCell><mxCell id="b-17" value="all three streams stalled — TCP will not deliver out of order" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="370.22727272727275" y="248" width="203.5454545454545" height="30" as="geometry"/></mxCell><mxCell id="t-18" value="one connection" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="284" width="120" height="26" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.22727272727275" y="308" as="sourcePoint"/><mxPoint x="370.22727272727275" y="282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-20" value="packet lost here" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="280.22727272727275" y="308" width="180" height="14" as="geometry"/></mxCell><mxCell id="b-21" value="Blocking moved down to &lt;b&gt;TCP&lt;/b&gt; — one lost packet stalls &lt;i&gt;every&lt;/i&gt; stream until it is retransmitted." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="324" width="646" height="26" as="geometry"/></mxCell><mxCell id="t-22" value="HTTP/3" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="384" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-23" value="QUIC over UDP: independent streams, 1-RTT handshake, survives a network change." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=8.5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="150" y="372" width="646" height="14" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;app.js&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="392" width="86.09090909090907" height="30" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;style&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="238.09090909090907" y="392" width="71.40909090909093" height="30" as="geometry"/></mxCell><mxCell id="b-26" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;logo&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="311.5" y="392" width="56.72727272727275" height="30" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;app.js&lt;/span&gt; stalled" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="370.22727272727275" y="392" width="71.40909090909088" height="30" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;style&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="443.6363636363636" y="392" width="64.06818181818181" height="30" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;logo&lt;/span&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="509.70454545454544" y="392" width="64.06818181818181" height="30" as="geometry"/></mxCell><mxCell id="t-30" value="one connection" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="428" width="120" height="26" as="geometry"/></mxCell><mxCell id="a-31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.22727272727275" y="452" as="sourcePoint"/><mxPoint x="370.22727272727275" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-32" value="packet lost here" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="280.22727272727275" y="452" width="180" height="14" as="geometry"/></mxCell><mxCell id="b-33" value="A lost packet stalls &lt;b&gt;only its own stream&lt;/b&gt;. The other downloads keep going." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=8.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="150" y="468" width="646" height="26" as="geometry"/></mxCell><mxCell id="a-34" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="24" y="512" as="sourcePoint"/><mxPoint x="796" y="512" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-35" value="Concatenate everything" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="522" width="178" height="24" as="geometry"/></mxCell><mxCell id="t-36" value="One byte changed invalidates the whole file" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="548" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-37" value="Domain sharding" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="218" y="522" width="178" height="24" as="geometry"/></mxCell><mxCell id="t-38" value="Extra handshakes, no parallelism to win" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="548" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-39" value="Many small chunks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="412" y="522" width="178" height="24" as="geometry"/></mxCell><mxCell id="t-40" value="Fine — until per-request overhead eats the win" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="548" width="178" height="30" as="geometry"/></mxCell><mxCell id="b-41" value="Fewer origins" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="606" y="522" width="178" height="24" as="geometry"/></mxCell><mxCell id="t-42" value="Still right: connection reuse" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="606" y="548" width="178" height="30" as="geometry"/></mxCell><mxCell id="t-43" value="Concatenation and sharding were HTTP/1.1 workarounds. Keeping them today costs you cache hits and handshakes." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#D97706;fontSize=9;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="24" y="584" width="772" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>