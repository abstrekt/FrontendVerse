Cell id="t-12" value="Each fetch needs the previous response before it can start. 570 ms, and the network was idle for most of it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="148" y="214" width="600" height="16" as="geometry"/></mxCell><mxCell id="p-13" value="Hoisted — start everything that has no dependency at once" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="244" width="772" height="158" as="geometry"/></mxCell><mxCell id="t-14" value="User" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="284" width="92" height="26" as="geometry"/></mxCell><mxCell id="b-15" value="200 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="148" y="284" width="200" height="26" as="geometry"/></mxCell><mxCell id="t-16" value="Issues" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="318" width="92" height="26" as="geometry"/></mxCell><mxCell id="b-17" value="180 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="148" y="318" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-18" value="Comments" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="352" width="92" height="26" as="geometry"/></mxCell><mxCell id="b-19" value="190 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="148" y="352" width="190" height="26" as="geometry"/></mxCell><mxCell id="a-20" value="200 ms total" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="386" as="sourcePoint"/><mxPoint x="348" y="386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-21" value="Where waterfalls come from" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="418" width="772" height="100" as="geometry"/></mxCell><mxCell id="b-22" value="a fetch inside a child's effect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="450" width="246" height="22" as="geometry"/></mxCell><mxCell id="t-23" value="the child cannot mount until the parent has data — hoist or prefetch" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="450" width="476" height="22" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;await&lt;/span&gt; in sequence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="474" width="246" height="22" as="geometry"/></mxCell><mxCell id="t-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;Promise.all&lt;/span&gt; when neither depends on the other" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="474" width="476" height="22" as="geometry"/></mxCell><mxCell id="b-26" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;lazy()&lt;/span&gt; above a fetch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="498" width="246" height="22" as="geometry"/></mxCell><mxCell id="t-27" value="the chunk downloads, &lt;i&gt;then&lt;/i&gt; the request starts — preload on hover or route intent" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="498" width="476" height="22" as="geometry"/></mxCell><mxCell id="b-28" value="Open the network panel and look at the shape. A staircase is a waterfall; a block starting at the same x is not." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;s