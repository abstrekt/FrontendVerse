<mxfile host="app.diagrams.net" type="device"><diagram name="useId and hydration" id="useId and hydration"><mxGraphModel dx="820" dy="470" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="470" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="useId: ids that survive hydration" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="A counter is not stable across two runtimes" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="A module counter" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="200" as="geometry"/></mxCell><mxCell id="p-4" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useId()&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="200" as="geometry"/></mxCell><mxCell id="b-5" value="let n = 0;&lt;br/&gt;const id = &lt;span style=&quot;font-family: Courier New&quot;&gt;field-${n++}&lt;/span&gt;;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="43" as="geometry"/></mxCell><mxCell id="b-6" value="server renders  →  id=&amp;quot;field-0&amp;quot;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="156" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="client hydrates →  id=&amp;quot;field-3&amp;quot;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="188" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="The counter starts fresh in the browser and the components mount in a different order. React reports a hydration mismatch and the &lt;span style=&quot;font-family: Courier New&quot;&gt;htmlFor&lt;/span&gt; link is broken." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="220" width="346" height="48" as="geometry"/></mxCell><mxCell id="b-9" value="const id = useId();&lt;br/&gt;&amp;lt;label htmlFor={id}&amp;gt; … &amp;lt;input id={id} /&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="43" as="geometry"/></mxCell><mxCell id="b-10" value="server renders  →  id=&amp;quot;:r0:&amp;quot;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="156" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-11" value="client hydrates →  id=&amp;quot;:r0:&amp;quot;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="188" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-12" value="The id is derived from the component's position in the tree, which is identical on both sides. Same input, same output." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="220" width="346" height="48" as="geometry"/></mxCell><mxCell id="p-13" value="What it is not for" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="286" width="772" height="96" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;b&gt;Not a list key.&lt;/b&gt; It is per-component, not per-item — every row would get the same id." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="318" width="362" height="46" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;Not a database id.&lt;/b&gt; It is an opaque DOM string, and the format is React's to change." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="318" width="362" height="46" as="geometry"/></mxCell><mxCell id="b-16" value="One call can serve a whole form: &lt;span style=&quot;font-family: Courier New&quot;&gt;${id}-email&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;${id}-password&lt;/span&gt;. That is the intended use, not one &lt;span style=&quot;font-family: Courier New&quot;&gt;useId&lt;/span&gt; per field." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="412" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>