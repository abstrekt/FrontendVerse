p;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="96" y="188" width="122" height="28" as="geometry"/></mxCell><mxCell id="t-12" value="Context, state and &lt;b&gt;events still flow through Card&lt;/b&gt; — the Tooltip is its child as far as React is concerned." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="48" y="226" width="220" height="44" as="geometry"/></mxCell><mxCell id="a-13" value="createPortal" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="172" as="sourcePoint"/><mxPoint x="340" y="172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-14" value="DOM tree" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="366" y="104" width="180" height="16" as="geometry"/></mxCell><mxCell id="b-15" value="body" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="366" y="124" width="190" height="28" as="geometry"/></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="150" as="sourcePoint"/><mxPoint x="378" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="170" as="sourcePoint"/><mxPoint x="390" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-18" value="div#root" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="390" y="156" width="166" height="28" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="182" as="sourcePoint"/><mxPoint x="402" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="202" as="sourcePoint"/><mxPoint x="414" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-21" value="div.card" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="414" y="188" width="142" height="28" as="geometry"/></mxCell><mxCell id="t-22" value="overflow: hidden" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="564" y="188" width="150" height="28" as="geometry"/></mxCell><mxCell id="a-23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="214" as="sourcePoint"/><mxPoint x="378" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="234" as="sourcePoint"/><mxPoint x="390" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-25" value="div#portal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="390" y="220" width="166" height="28" as="geometry"/></mxCell><mxCell id="t-26" value="the tooltip lands here" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="564" y="220" width="150" height="28" as="geometry"/></mxCell><mxCell id="p-27" value="The problems it solves" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="378" height="138" as="geometry"/></mxCell><mxCell id="p-28" value="The one that surprises people" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="336" width="378" height="138" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;overflow: hidden&lt;/span&gt; on an ancestor clipping a dropdown" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="370" width="346" height="24" as="geometry"/></mxCell><mxCell id="b-30" value="a &lt;span style=&quot;font-family: Courier New&quot;&gt;z-index&lt;/span&gt; war with a positioned ancestor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="398" width="346" height="24" as="geometry"/></mxCell><mxCell id="b-31" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;transform&lt;/span&gt; on a parent creating a new containing block" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="426" width="346" height="24" as="geometry"/></mxCell><mxCell id="b-32" value="&lt;b&gt;Events still bubble through the React tree, not the DOM tree.&lt;/b&gt; A click inside a portal fires the &lt;span style=&quot;font-family: Courier New&quot;&gt;onClick&lt;/span&gt; on &lt;span style=&quot;font-family: Courier New&quot;&gt;Card&lt;/span&gt; — which is usually what you want, and is a genuine shock when your &amp;quot;click outside to close&amp;quot; handler lives on &lt;span style=&quot;font-family: Courier New&quot;&gt;Card&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="370" width="346" height="82" as="geometry"/></mxCell><mxCell id="b-33" value="A portal changes where the pixels are, not who owns the component. That split is the whole feature." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="502" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>