<mxfile host="app.diagrams.net" type="device"><diagram name="Test behaviour, not implementation" id="Test behaviour, not implementation"><mxGraphModel dx="820" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="500" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Test behaviour, not implementation" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Query the way a user looks, act the way a user acts" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Coupled to the implementation" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="196" as="geometry"/></mxCell><mxCell id="p-4" value="Coupled to the behaviour" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="196" as="geometry"/></mxCell><mxCell id="b-5" value="expect(wrapper.state(&amp;quot;open&amp;quot;)).toBe(true);&lt;br/&gt;expect(wrapper.find(&amp;quot;Modal&amp;quot;)).toHaveLength(1);&lt;br/&gt;wrapper.instance().handleClick();&lt;br/&gt;expect(useStore).toHaveBeenCalled();" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="76" as="geometry"/></mxCell><mxCell id="b-6" value="Renaming &lt;span style=&quot;font-family: Courier New&quot;&gt;open&lt;/span&gt; to &lt;span style=&quot;font-family: Courier New&quot;&gt;isOpen&lt;/span&gt; breaks every one of these, and none of them would have caught the button being invisible. &lt;b&gt;Refactors go red; bugs go green.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="192" width="346" height="62" as="geometry"/></mxCell><mxCell id="b-7" value="await user.click(screen.getByRole(&amp;quot;button&amp;quot;,&lt;br/&gt;  { name: /save/i }));&lt;br/&gt;expect(await screen.findByRole(&amp;quot;alert&amp;quot;))&lt;br/&gt;  .toHaveTextContent(&amp;quot;Saved&amp;quot;);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="76" as="geometry"/></mxCell><mxCell id="b-8" value="Survives any refactor that keeps the behaviour, and fails when the button loses its accessible name — which is a real bug for a real user." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="192" width="346" height="62" as="geometry"/></mxCell><mxCell id="p-9" value="Query priority — the earlier one is the better test" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="282" width="772" height="132" as="geometry"/></mxCell><mxCell id="b-10" value="getByRole" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="314" width="160" height="22" as="geometry"/></mxCell><mxCell id="t-11" value="how assistive tech sees it — the default choice" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="216" y="314" width="562" height="22" as="geometry"/></mxCell><mxCell id="b-12" value="getByLabelText" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="338" width="160" height="22" as="geometry"/></mxCell><mxCell id="t-13" value="form fields, exactly as a user finds them" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="216" y="338" width="562" height="22" as="geometry"/></mxCell><mxCell id="b-14" value="getByText" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="362" width="160" height="22" as="geometry"/></mxCell><mxCell id="t-15" value="non-interactive content" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="216" y="362" width="562" height="22" as="geometry"/></mxCell><mxCell id="b-16" value="getByTestId" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="386" width="160" height="22" as="geometry"/></mxCell><mxCell id="t-17" value="the escape hatch — invisible to users, so it proves nothing about them" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="216" y="386" width="562" height="22" as="geometry"/></mxCell><mxCell id="b-18" value="A good test is one you never have to open during a refactor, and that goes red the moment a user would notice." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="442" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>