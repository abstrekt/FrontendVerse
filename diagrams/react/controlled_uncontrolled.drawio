<mxfile host="app.diagrams.net" type="device"><diagram name="Controlled vs uncontrolled inputs" id="Controlled vs uncontrolled inputs"><mxGraphModel dx="820" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="500" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Controlled vs uncontrolled inputs" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Who holds the current value — React, or the DOM" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Controlled — React holds it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="250" as="geometry"/></mxCell><mxCell id="p-4" value="Uncontrolled — the DOM holds it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="250" as="geometry"/></mxCell><mxCell id="b-5" value="&amp;lt;input value={v}&lt;br/&gt;  onChange={e =&amp;gt; setV(e.target.value)} /&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="43" as="geometry"/></mxCell><mxCell id="pl-6" value="keypress" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="156" width="96" height="30" as="geometry"/></mxCell><mxCell id="a-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="171" as="sourcePoint"/><mxPoint x="154" y="171" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-8" value="setState" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="154" y="156" width="96" height="30" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="171" as="sourcePoint"/><mxPoint x="268" y="171" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-10" value="re-render" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="268" y="156" width="96" height="30" as="geometry"/></mxCell><mxCell id="t-11" value="every keystroke is a render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="192" width="346" height="16" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;b&gt;Buys you:&lt;/b&gt; validate or transform as they type, disable Submit live, force uppercase, drive the field from elsewhere.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Costs you:&lt;/b&gt; a render per character. Rarely matters — until the form is large or each render is expensive." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="212" width="346" height="100" as="geometry"/></mxCell><mxCell id="b-13" value="&amp;lt;input defaultValue={v} ref={r} /&amp;gt;&lt;br/&gt;// read r.current.value on submit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="43" as="geometry"/></mxCell><mxCell id="pl-14" value="keypress" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="434" y="156" width="96" height="30" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="171" as="sourcePoint"/><mxPoint x="548" y="171" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-16" value="DOM updates" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="548" y="156" width="96" height="30" as="geometry"/></mxCell><mxCell id="t-17" value="React is not involved until submit" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="434" y="192" width="346" height="16" as="geometry"/></mxCell><mxCell id="b-18" value="&lt;b&gt;Buys you:&lt;/b&gt; zero renders while typing, and less code for a plain form.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Costs you:&lt;/b&gt; the value is only readable on demand, so live validation and cross-field rules get awkward." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="212" width="346" height="100" as="geometry"/></mxCell><mxCell id="p-19" value="The warning everyone hits" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="772" height="92" as="geometry"/></mxCell><mxCell id="b-20" value="const [v, setV] = useState();   // undefined!&lt;br/&gt;&amp;lt;input value={v} onChange={…} /&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="368" width="362" height="44" as="geometry"/></mxCell><mxCell id="b-21" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;value={undefined}&lt;/span&gt; starts uncontrolled and becomes controlled on the first keystroke. Initialise to &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;quot;&amp;quot;&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="368" width="362" height="44" as="geometry"/></mxCell><mxCell id="b-22" value="Default to controlled — it is the one that composes. Reach for uncontrolled when the render cost is measured, or a file input leaves you no choice." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="442" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>