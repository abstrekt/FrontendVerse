<mxfile host="app.diagrams.net" type="device"><diagram name="One-way data flow" id="One-way data flow"><mxGraphModel dx="820" dy="470" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="470" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="One-way data flow" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Data falls down the tree; events climb back up as calls" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="State lives at the lowest common owner of everyone who needs it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="258" as="geometry"/></mxCell><mxCell id="b-4" value="&amp;lt;App&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="70" y="108" width="200" height="28" as="geometry"/></mxCell><mxCell id="t-5" value="owns  filter" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="278" y="108" width="130" height="28"