one;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="106" y="190" as="sourcePoint"/><mxPoint x="118" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="&amp;lt;SearchBox&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="118" y="176" width="152" height="28" as="geometry"/></mxCell><mxCell id="t-13" value="calls  onChange" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="278" y="176" width="130" height="28" as="geometry"/></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="82" y="202" as="sourcePoint"/><mxPoint x="82" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="82" y="224" as="sourcePoint"/><mxPoint x="94" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="&amp;lt;Results&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="94" y="210" width="176" height="28" as="geometry"/></mxCell><mxCell id="t-17" value="reads  filter" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="278" y="210" width="130" height="28" as="geometry"/></mxCell><mxCell id="a-18" value="props  ↓" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="126" as="sourcePoint"/><mxPoint x="420" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-19" value="&lt;b&gt;Down: props.&lt;/b&gt; A child receives a value it cannot change. Reading it is all it can do." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="120" width="330" height="46" as="geometry"/></mxCell><mxCell id="a-20" value="events  ↑" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="296" as="sourcePoint"/><mxPoint x="420" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-21" value="&lt;b&gt;Up: callbacks.&lt;/b&gt; The child does not set state; it reports an event. The owner decides what that means." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="252" width="330" height="60" as="geometry"/></mxCell><mxCell id="b-22" value="Move state &lt;i&gt;up&lt;/i&gt; only as far as the lowest node that contains every reader. Higher than that and you re-render half the app for nothing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="70" y="262" width="330" height="50" as="geometry"/></mxCell><mxCell id="b-23" value="Because data only ever flows one way, &amp;quot;who could have changed this?&amp;quot; has exactly one answer: the component that owns the state." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="346" width="772" height="46" as="geometry"/></mxCell><mxCell id="b-24" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="448" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-25" value="owns the state" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="444" width="93.39999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-26" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="147.39999999999998" y="448" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-27" value="reports an event" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="164.39999999999998" y="444" width="105.6" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>