;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="576" y="186" width="202" height="28" as="geometry"/></mxCell><mxCell id="b-20" value="ISR" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="218" width="80" height="28" as="geometry"/></mxCell><mxCell id="t-21" value="the build, then re-made in the background" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="132" y="218" width="214" height="28" as="geometry"/></mxCell><mxCell id="t-22" value="instant, occasionally one visit stale" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="354" y="218" width="214" height="28" as="geometry"/></mxCell><mxCell id="t-23" value="big catalogues that change slowly" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="576" y="218" width="202" height="28" as="geometry"/></mxCell><mxCell id="p-24" value="Hydration — the part everyone forgets" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="272" width="772" height="208" as="geometry"/></mxCell><mxCell id="pl-25" value="HTML arrives" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="308" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="172" y="323" as="sourcePoint"/><mxPoint x="192" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-27" value="paint — visible" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="192" y="308" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-28" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="323" as="sourcePoint"/><mxPoint x="340" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-29" value="JS downloads" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="340" y="308" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-30" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="468" y="323" as="sourcePoint"/><mxPoint x="488" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-31" value="hydrate" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="488" y="308" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="616" y="323" as="sourcePoint"/><mxPoint x="636" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-33" value="interactive" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="636" y="308" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-34" value="looks ready, ignores every click" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256" y="348" as="sourcePoint"/><mxPoint x="700" y="348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-35" value="&lt;b&gt;SSR is not free.&lt;/b&gt; The server renders, sends HTML, then React re-renders the whole tree in the browser to attach event handlers. Until that finishes, the page is a picture." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="374" width="362" height="86" as="geometry"/></mxCell><mxCell id="b-36" value="&lt;b&gt;A hydration mismatch&lt;/b&gt; — &lt;span style=&quot;font-family: Courier New&quot;&gt;Date.now()&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;window&lt;/span&gt;, a random id — makes React discard the server HTML for that subtree and re-render it. You paid for SSR and got CSR." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="374" width="362" height="86" as="geometry"/></mxCell><mxCell id="b-37" value="Pick by who owns the content and how fresh it must be. &amp;quot;SSR is faster&amp;quot; is wrong — SSR moves work, and hydration adds some back." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="500" width="772" height="46" as="geometry"/></mxCell><mxCell id="b-38" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="588" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-39" value="no JS needed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="584" width="81.19999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-40" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="135.2" y="588" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-41" value="waiting on JS" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="152.2" y="584" width="87.3" height="18" as="geometry"/></mxCell><mxCell id="b-42" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="252.5" y="588" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-43" value="interactive" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="269.5" y="584" width="75.1" height="18" as="geometry"/></mxCell><mxCell id="b-44" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="357.6" y="588" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-45" value="the trap" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="374.6" y="584" width="56.8" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>