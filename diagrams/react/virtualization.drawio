=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="448" y="246" width="318" height="16" as="geometry"/></mxCell><mxCell id="b-25" value="12 nodes · ~4 ms · constant memory" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="292" width="346" height="28" as="geometry"/></mxCell><mxCell id="a-26" value="viewport" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=2;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="756" y="132" as="sourcePoint"/><mxPoint x="756" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-27" value="The mechanism, and what it costs you" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="772" height="122" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;b&gt;How.&lt;/b&gt; Track &lt;span style=&quot;font-family: Courier New&quot;&gt;scrollTop&lt;/span&gt;, divide by row height to get the first visible index, render that slice, and hold the scrollbar at the right length with two spacer divs." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="370" width="362" height="74" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;b&gt;The cost.&lt;/b&gt; Ctrl-F finds nothing off-screen, and variable row heights need measurement. Reach for &lt;span style=&quot;font-family: Courier New&quot;&gt;@tanstack/virtual&lt;/span&gt; rather than writing it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="370" width="362" height="74" as="geometry"/></mxCell><mxCell id="b-30" value="Virtualise when the list is unbounded. For 200 rows, pagination or a plain list is simpler and the user cannot tell." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="462" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>