<mxfile host="app.diagrams.net" type="device"><diagram name="Custom hooks share logic, not state" id="Custom hooks share logic, not state"><mxGraphModel dx="820" dy="530" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="530" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Custom hooks share logic, never state" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Two components calling the same hook get two separate stores" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="One hook, two independent copies" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="202" as="geometry"/></mxCell><mxCell id="b-4" value="function useCounter(start) {&lt;br/&gt;  const [n, setN] = useState(start);&lt;br/&gt;  return [n, () =&amp;gt; setN(c =&amp;gt; c + 1)];&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="106" width="300" height="92" as="geometry"/></mxCell><mxCell id="b-5" value="ComponentA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="372" y="106" width="190" height="28" as="geometry"/></mxCell><mxCell id="b-6" value="ComponentB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="588" y="106" width="190" height="28" as="geometry"/></mxCell><mxCell id="a-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="194" y="202" as="sourcePoint"/><mxPoint x="467" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.3;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="194" y="202" as="sourcePoint"/><mxPoint x="683" y="142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-9" value="its own slot · n = 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="372" y="146" width="190" height="28" as="geometry"/></mxCell><mxCell id="b-10" value="its own slot · n = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="588" y="146" width="190" height="28" as="geometry"/></mxCell><mxCell id="t-11" value="The hook is inlined into each caller's own slot list. Sharing the &lt;i&gt;value&lt;/i&gt; needs context or a store — a hook alone never does it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="372" y="186" width="406" height="34" as="geometry"/></mxCell><mxCell id="p-12" value="A plain function is enough" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="292" width="378" height="150" as="geometry"/></mxCell><mxCell id="p-13" value="It has to be a hook" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="292" width="378" height="150" as="geometry"/></mxCell><mxCell id="b-14" value="formatting a date" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="326" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-15" value="sorting an array" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="352" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-16" value="validating an email" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="378" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-17" value="any pure input → output" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="404" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-18" value="it calls useState or useRef" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="326" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-19" value="it subscribes in useEffect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="352" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-20" value="it reads context" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="378" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-21" value="it must re-render on change" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="404" width="346" height="22" as="geometry"/></mxCell><mxCell id="b-22" value="Name it &lt;span style=&quot;font-family: Courier New&quot;&gt;useX&lt;/span&gt; only if it calls a hook. A &lt;span style=&quot;font-family: Courier New&quot;&gt;useFormatPrice&lt;/span&gt; that touches nothing React-shaped is a helper wearing a costume, and the linter will hold it to rules it does not need." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="472" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>