<mxfile host="app.diagrams.net" type="device"><diagram name="Hooks are positional slots" id="Hooks are positional slots"><mxGraphModel dx="820" dy="566" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="566" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Hooks are positional slots" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Why the rules of hooks are not a style guide" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="React stores hook state in call order on the fiber, not by name" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="172" as="geometry"/></mxCell><mxCell id="b-4" value="function Profile() {&lt;br/&gt;  const [name, setName] = useState(&amp;quot;&amp;quot;);&lt;br/&gt;  const [age,  setAge ] = useState(0);&lt;br/&gt;  useEffect(fn, [name]);&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="106" width="300" height="104" as="geometry"/></mxCell><mxCell id="t-5" value="fiber.memoizedState  —  a linked list" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="368" y="106" width="410" height="16" as="geometry"/></mxCell><mxCell id="b-6" value="0" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="368" y="126" width="40" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="useState" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="414" y="126" width="150" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="&amp;quot;&amp;quot;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="570" y="126" width="208" height="26" as="geometry"/></mxCell><mxCell id="b-9" value="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="368" y="156" width="40" height="26" as="geometry"/></mxCell><mxCell id="b-10" value="useState" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="414" y="156" width="150" height="26" as="geometry"/></mxCell><mxCell id="b-11" value="0" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="570" y="156" width="208" height="26" as="geometry"/></mxCell><mxCell id="a-12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="388" y="152" as="sourcePoint"/><mxPoint x="388" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-13" value="2" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="368" y="186" width="40" height="26" as="geometry"/></mxCell><mxCell id="b-14" value="useEffect" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="414" y="186" width="150" height="26" as="geometry"/></mxCell><mxCell id="b-15" value="[name]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="570" y="186" width="208" height="26" as="geometry"/></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="388" y="182" as="sourcePoint"/><mxPoint x="388" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-17" value="There is no name here — only position." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="368" y="216" width="410" height="16" as="geometry"/></mxCell><mxCell id="p-18" value="A conditional hook shifts every slot after it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="258" width="378" height="200" as="geometry"/></mxCell><mxCell id="p-19" value="Move the condition inside" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="258" width="378" height="200" as="geometry"/></mxCell><mxCell id="b-20" value="if (show) {&lt;br/&gt;  const [a] = useState(1);   // slot 0 …or not&lt;br/&gt;}&lt;br/&gt;const [b] = useState(2);     // slot 0 or 1?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="292" width="346" height="72" as="geometry"/></mxCell><mxCell id="b-21" value="Render 1 with &lt;span style=&quot;font-family: Courier New&quot;&gt;show&lt;/span&gt; true: &lt;span style=&quot;font-family: Courier New&quot;&gt;b&lt;/span&gt; is slot 1. Render 2 with &lt;span style=&quot;font-family: Courier New&quot;&gt;show&lt;/span&gt; false: &lt;span style=&quot;font-family: Courier New&quot;&gt;b&lt;/span&gt; reads &lt;b&gt;slot 0&lt;/b&gt; — &lt;span style=&quot;font-family: Courier New&quot;&gt;a&lt;/span&gt;'s value. React sees the count change and throws &amp;quot;rendered fewer hooks than expected&amp;quot;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="386" width="346" height="64" as="geometry"/></mxCell><mxCell id="b-22" value="const [a] = useState(1);     // always slot 0&lt;br/&gt;const [b] = useState(2);     // always slot 1&lt;br/&gt;useEffect(() =&amp;gt; {&lt;br/&gt;  if (show) { … }            // branch in here&lt;br/&gt;}, [show]);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="292" width="346" height="86" as="geometry"/></mxCell><mxCell id="b-23" value="The call order is now identical on every render. The branch still happens — it just happens &lt;b&gt;inside&lt;/b&gt; the hook, where the slot count cannot see it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="386" width="346" height="64" as="geometry"/></mxCell><mxCell id="b-24" value="The rule is &amp;quot;same hooks, same order, every render&amp;quot;. Loops, conditions, early returns and nested functions all break it; a custom hook does not, because it is inlined into the same call order." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="470" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>