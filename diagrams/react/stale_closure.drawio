<mxfile host="app.diagrams.net" type="device"><diagram name="The stale closure" id="The stale closure"><mxGraphModel dx="820" dy="580" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="580" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="The stale closure" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Every render is a separate function call with its own frozen variables" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="One component, three renders, three different &lt;span style=&quot;font-family: Courier New&quot;&gt;count&lt;/span&gt; variables" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="196" as="geometry"/></mxCell><mxCell id="b-4" value="render 1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="104" width="228" height="24" as="geometry"/></mxCell><mxCell id="b-5" value="function Counter() {&lt;br/&gt;  const count = 0;&lt;br/&gt;  …&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="134" width="228" height="72" as="geometry"/></mxCell><mxCell id="b-6" value="the closure captured  count = 0" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="204" width="228" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="render 2" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="292" y="104" width="228" height="24" as="geometry"/></mxCell><mxCell id="b-8" value="function Counter() {&lt;br/&gt;  const count = 1;&lt;br/&gt;  …&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="292" y="134" width="228" height="72" as="geometry"/></mxCell><mxCell id="b-9" value="the closure captured  count = 1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="292" y="204" width="228" height="26" as="geometry"/></mxCell><mxCell id="b-10" value="render 3" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="540" y="104" width="228" height="24" as="geometry"/></mxCell><mxCell id="b-11" value="function Counter() {&lt;br/&gt;  const count = 2;&lt;br/&gt;  …&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="540" y="134" width="228" height="72" as="geometry"/></mxCell><mxCell id="b-12" value="the closure captured  count = 2" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="540" y="204" width="228" height="26" as="geometry"/></mxCell><mxCell id="t-13" value="Nothing &amp;quot;updates&amp;quot; count. Each render creates a brand-new variable, and any function defined in that render sees only that one, forever." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="236" width="734" height="18" as="geometry"/></mxCell><mxCell id="p-14" value="An interval set up once, capturing render 1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="282" width="378" height="212" as="geometry"/></mxCell><mxCell id="p-15" value="The two escapes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="282" width="378" height="212" as="geometry"/></mxCell><mxCell id="b-16" value="useEffect(() =&amp;gt; {&lt;br/&gt;  const id = setInterval(() =&amp;gt; {&lt;br/&gt;    setCount(count + 1);   // count is always 0&lt;br/&gt;  }, 1000);&lt;br/&gt;  return () =&amp;gt; clearInterval(id);&lt;br/&gt;}, []);                    // ← set up once" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="316" width="346" height="100" as="geometry"/></mxCell><mxCell id="b-17" value="The empty array means the effect runs in render 1 and never again, so the callback keeps render 1's &lt;span style=&quot;font-family: Courier New&quot;&gt;count = 0&lt;/span&gt;. It sets 1, then 1, then 1 forever." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="424" width="346" height="62" as="geometry"/></mxCell><mxCell id="b-18" value="// 1 · updater — never reads the closure&lt;br/&gt;setCount(c =&amp;gt; c + 1);&lt;br/&gt;&lt;br/&gt;// 2 · a ref — one mutable box, shared&lt;br/&gt;//     by every render&lt;br/&gt;countRef.current += 1;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="316" width="346" height="100" as="geometry"/></mxCell><mxCell id="b-19" value="The updater form asks React for the latest value instead of remembering one. A ref works too, but it is invisible to rendering — use it only when the value is not displayed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="424" width="346" height="62" as="geometry"/></mxCell><mxCell id="b-20" value="A stale closure is never a React bug — it is JavaScript working correctly. The dependency array is the list of captured values you promise are still current." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="508" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>