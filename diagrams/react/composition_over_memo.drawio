dth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="64" y="224" width="146" height="28" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="250" as="sourcePoint"/><mxPoint x="52" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="268" as="sourcePoint"/><mxPoint x="64" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-13" value="VerySlowChart" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="64" y="254" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-14" value="re-renders" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="218" y="254" width="120" height="28" as="geometry"/></mxCell><mxCell id="t-15" value="Every toggle re-runs App, so a fresh &amp;lt;VerySlowChart/&amp;gt; element is created and the chart re-renders." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="288" width="346" height="28" as="geometry"/></mxCell><mxCell id="b-16" value="function App() {&lt;br/&gt;  return (&lt;br/&gt;    &amp;lt;ModalHost&amp;gt;            {/&lt;i&gt; owns open &lt;/i&gt;/}&lt;br/&gt;      &amp;lt;VerySlowChart /&amp;gt;    {/&lt;i&gt; made HERE &lt;/i&gt;/}&lt;br/&gt;    &amp;lt;/ModalHost&amp;gt;);&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="100" as="geometry"/></mxCell><mxCell id="b-17" value="App" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="194" width="170" height="28" as="geometry"/></mxCell><mxCell id="t-18" value="no state" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="194" width="120" height="28" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="220" as="sourcePoint"/><mxPoint x="446" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="238" as="sourcePoint"/><mxPoint x="458" y="238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-21" value="ModalHost" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="458" y="224" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-22" value="setOpen" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="224" width="120" height="28" as="geometry"/></mxCell><mxCell id="a-23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="250" as="sourcePoint"/><mxPoint x="470" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="268" as="sourcePoint"/><mxPoint x="482" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-25" value="{children}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="482" y="254" width="122" height="28" as="geometry"/></mxCell><mxCell id="t-26" value="same element" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="254" width="120" height="28" as="geometry"/></mxCell><mxCell id="t-27" value="ModalHost re-renders, but &lt;span style=&quot;font-family: Courier New&quot;&gt;children&lt;/span&gt; is the identical element object App made — React bails out." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="434" y="288" width="346" height="28" as="geometry"/></mxCell><mxCell id="p-28" value="Why it works — no memo, no dependency array" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="772" height="106" as="geometry"/></mxCell><mxCell id="b-29" value="An element is a plain object. &lt;span style=&quot;font-family: Courier New&quot;&gt;ModalHost&lt;/span&gt; re-rendering does not re-run &lt;span style=&quot;font-family: Courier New&quot;&gt;App&lt;/span&gt;, so &lt;span style=&quot;font-family: Courier New&quot;&gt;props.children&lt;/span&gt; is &lt;b&gt;the same object reference&lt;/b&gt; as last time. React compares it, sees no change, and skips that subtree — the exact bail-out &lt;span style=&quot;font-family: Courier New&quot;&gt;memo&lt;/span&gt; buys you, for free and with nothing to keep in sync." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="370" width="732" height="56" as="geometry"/></mxCell><mxCell id="p-30" value="The same move, four names" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="458" width="772" height="106" as="geometry"/></mxCell><mxCell id="b-31" value="children" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="492" width="174" height="24" as="geometry"/></mxCell><mxCell id="b-32" value="&amp;lt;Panel&amp;gt;{slow}&amp;lt;/Panel&amp;gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="520" width="174" height="30" as="geometry"/></mxCell><mxCell id="b-33" value="elements as props" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="230" y="492" width="174" height="24" as="geometry"/></mxCell><mxCell id="b-34" value="&amp;lt;Layout left={&amp;lt;Nav/&amp;gt;} /&amp;gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="230" y="520" width="174" height="30" as="geometry"/></mxCell><mxCell id="b-35" value="render props" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="492" width="174" height="24" as="geometry"/></mxCell><mxCell id="b-36" value="&amp;lt;Fetch&amp;gt;{d =&amp;gt; &amp;lt;Row d={d}/&amp;gt;}&amp;lt;/Fetch&amp;gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="520" width="174" height="30" as="geometry"/></mxCell><mxCell id="b-37" value="HOC" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="602" y="492" width="174" height="24" as="geometry"/></mxCell><mxCell id="b-38" value="withAuth(Page)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=9;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="602" y="520" width="174" height="30" as="geometry"/></mxCell><mxCell id="b-39" value="Before reaching for memo, ask where the element is created. Moving state down or content up fixes most re-render problems with no API at all." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="562" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>