"edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84" y="190" as="sourcePoint"/><mxPoint x="96" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="&amp;quot;use client&amp;quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="96" y="176" width="212" height="28" as="geometry"/></mxCell><mxCell id="t-13" value="the boundary" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="316" y="176" width="140" height="28" as="geometry"/></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="202" as="sourcePoint"/><mxPoint x="108" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="224" as="sourcePoint"/><mxPoint x="120" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="AddToCart     client" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="120" y="210" width="188" height="28" as="geometry"/></mxCell><mxCell id="t-17" value="in the bundle" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="316" y="210" width="140" height="28" as="geometry"/></mxCell><mxCell id="a-18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132" y="236" as="sourcePoint"/><mxPoint x="132" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132" y="258" as="sourcePoint"/><mxPoint x="144" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-20" value="Price         server" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="144" y="244" width="164" height="28" as="geometry"/></mxCell><mxCell id="t-21" value="passed as children" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="316" y="244" width="140" height="28" as="geometry"/></mxCell><mxCell id="b-22" value="A server component runs &lt;b&gt;only&lt;/b&gt; on the server. It can &lt;span style=&quot;font-family: Courier New&quot;&gt;await&lt;/span&gt; a query directly, and its code is never sent to the browser — a 300 KB markdown parser costs the user nothing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="468" y="112" width="310" height="80" as="geometry"/></mxCell><mxCell id="b-23" value="Everything below &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;quot;use client&amp;quot;&lt;/span&gt; is bundled. Note the last row: a server component can still appear &lt;i&gt;under&lt;/i&gt; a client one, if it is passed through as &lt;span style=&quot;font-family: Courier New&quot;&gt;children&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="468" y="200" width="310" height="80" as="geometry"/></mxCell><mxCell id="p-24" value="What crosses the boundary" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="310" width="772" height="128" as="geometry"/></mxCell><mxCell id="b-25" value="props must be serialisable" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="344" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-26" value="strings, numbers, arrays, plain objects, and elements — &lt;b&gt;not&lt;/b&gt; functions or class instances" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="344" width="496" height="26" as="geometry"/></mxCell><mxCell id="b-27" value="no hooks on the server" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="374" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-28" value="no &lt;span style=&quot;font-family: Courier New&quot;&gt;useState&lt;/span&gt;, no &lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect&lt;/span&gt;, no event handlers — there is no interaction to handle" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="374" width="496" height="26" as="geometry"/></mxCell><mxCell id="b-29" value="server actions go the other way" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="404" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-30" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;quot;use server&amp;quot;&lt;/span&gt; lets a client component call a server function directly, as a form action" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="404" width="496" height="26" as="geometry"/></mxCell><mxCell id="p-31" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;use()&lt;/span&gt; — read a promise or a context during render" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="454" width="772" height="80" as="geometry"/></mxCell><mxCell id="b-32" value="const user = use(userPromise);&lt;br/&gt;// suspends until it resolves" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="484" width="362" height="43" as="geometry"/></mxCell><mxCell id="b-33" value="Unlike every other hook, &lt;span style=&quot;font-family: Courier New&quot;&gt;use()&lt;/span&gt; may be called conditionally." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="484" width="362" height="36" as="geometry"/></mxCell><mxCell id="b-34" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="570" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-35" value="server only" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="566" width="75.1" height="18" as="geometry"/></mxCell><mxCell id="b-36" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="129.1" y="570" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-37" value="the boundary" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="146.1" y="566" width="81.19999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-38" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="240.29999999999998" y="570" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-39" value="shipped to the browser" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="257.29999999999995" y="566" width="142.2" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>