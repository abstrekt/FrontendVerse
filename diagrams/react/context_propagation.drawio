<mxfile host="app.diagrams.net" type="device"><diagram name="Context and re-renders" id="Context and re-renders"><mxGraphModel dx="820" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="640" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Context and re-renders" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Every consumer re-renders when &lt;span style=&quot;font-family: Courier New&quot;&gt;value&lt;/span&gt; is a new reference — memo cannot stop it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="A consumer subscribes to the provider, not to its parent" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="208" as="geometry"/></mxCell><mxCell id="b-4" value="ThemeProvider" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="48" y="108" width="220" height="28" as="geometry"/></mxCell><mxCell id="t-5" value="value changed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="276" y="108" width="150" height="28" as="geometry"/></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="134" as="sourcePoint"/><mxPoint x="60" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="156" as="sourcePoint"/><mxPoint x="72" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-8" value="Layout" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="72" y="142" width="196" height="28" as="geometry"/></mxCell><mxCell id="t-9" value="not a consumer" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="276" y="142" width="150" height="28" as="geometry"/></mxCell><mxCell id="a-10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84" y="168" as="sourcePoint"/><mxPoint x="84" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84" y="190" as="sourcePoint"/><mxPoint x="96" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-12" value="memo(Sidebar)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="96" y="176" width="172" height="28" as="geometry"/></mxCell><mxCell id="t-13" value="bails out" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="276" y="176" width="150" height="28" as="geometry"/></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="202" as="sourcePoint"/><mxPoint x="108" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="224" as="sourcePoint"/><mxPoint x="120" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="Avatar  useContext" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="120" y="210" width="148" height="28" as="geometry"/></mxCell><mxCell id="t-17" value="re-renders anyway" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="276" y="210" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-18" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;memo(Sidebar)&lt;/span&gt; bails out, and React still walks &lt;i&gt;past&lt;/i&gt; it to reach &lt;span style=&quot;font-family: Courier New&quot;&gt;Avatar&lt;/span&gt;. A consumer is subscribed directly — nothing in between can shield it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="112" width="334" height="72" as="geometry"/></mxCell><mxCell id="b-19" value="That is the point of context: it skips the props chain. The cost is that it also skips every optimisation living on that chain." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="192" width="334" height="72" as="geometry"/></mxCell><mxCell id="p-20" value="A new value object on every render" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="294" width="378" height="148" as="geometry"/></mxCell><mxCell id="p-21" value="A stable value" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="294" width="378" height="148" as="geometry"/></mxCell><mxCell id="b-22" value="function App() {&lt;br/&gt;  const [user, setUser] = useState(null);&lt;br/&gt;  return &amp;lt;Ctx.Provider value={{ user, setUser }}&amp;gt;&lt;br/&gt;    …&lt;br/&gt;  &amp;lt;/Ctx.Provider&amp;gt;;&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="328" width="346" height="100" as="geometry"/></mxCell><mxCell id="t-23" value="The object literal is new on every App render, so every consumer in the app re-renders — even when &lt;span style=&quot;font-family: Courier New&quot;&gt;user&lt;/span&gt; never changed." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="396" width="346" height="32" as="geometry"/></mxCell><mxCell id="b-24" value="const value = useMemo(&lt;br/&gt;  () =&amp;gt; ({ user, setUser }),&lt;br/&gt;  [user]);&lt;br/&gt;return &amp;lt;Ctx.Provider value={value}&amp;gt;…&amp;lt;/Ctx.Provider&amp;gt;;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="328" width="346" height="86" as="geometry"/></mxCell><mxCell id="t-25" value="Same reference until &lt;span style=&quot;font-family: Courier New&quot;&gt;user&lt;/span&gt; actually changes. This is the minimum — do it every time you build a provider value inline." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="434" y="396" width="346" height="32" as="geometry"/></mxCell><mxCell id="p-26" value="The real fix for a busy context: split it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="462" width="772" height="112" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;b&gt;One context, two concerns.&lt;/b&gt; &lt;span style=&quot;font-family: Courier New&quot;&gt;{ user, theme }&lt;/span&gt; means a theme toggle re-renders every component that only reads &lt;span style=&quot;font-family: Courier New&quot;&gt;user&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="496" width="362" height="64" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;b&gt;Two contexts.&lt;/b&gt; &lt;span style=&quot;font-family: Courier New&quot;&gt;UserContext&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;ThemeContext&lt;/span&gt; — a consumer re-renders only for the one it actually reads. Splitting state from setters is the same trick." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="496" width="362" height="64" as="geometry"/></mxCell><mxCell id="b-29" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="618" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-30" value="provider" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="614" width="56.8" height="18" as="geometry"/></mxCell><mxCell id="b-31" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="110.8" y="618" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-32" value="bailed out" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="127.8" y="614" width="69" height="18" as="geometry"/></mxCell><mxCell id="b-33" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="209.8" y="618" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-34" value="forced to re-render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="226.8" y="614" width="123.89999999999999" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>