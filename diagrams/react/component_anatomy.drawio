<mxfile host="app.diagrams.net" type="device"><diagram name="Anatomy of a component" id="Anatomy of a component"><mxGraphModel dx="820" dy="606" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="606" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Anatomy of a component you build in an interview" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The four decisions, in the order the interviewer scores them" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="b-3" value="1 · the API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="76" width="186" height="62" as="geometry"/></mxCell><mxCell id="b-4" value="What does the parent pass, and what does it get back? Write the call site &lt;i&gt;first&lt;/i&gt; — &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;Collapsible items={…} defaultOpen={0} /&amp;gt;&lt;/span&gt; decides everything below it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="76" width="576" height="62" as="geometry"/></mxCell><mxCell id="b-5" value="2 · the state shape" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="146" width="186" height="62" as="geometry"/></mxCell><mxCell id="b-6" value="The smallest thing that cannot be derived. One &lt;span style=&quot;font-family: Courier New&quot;&gt;openId&lt;/span&gt;, not an &lt;span style=&quot;font-family: Courier New&quot;&gt;isOpen&lt;/span&gt; per row — two sources of truth is the bug they are looking for." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="146" width="576" height="62" as="geometry"/></mxCell><mxCell id="b-7" value="3 · controlled or not" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="216" width="186" height="62" as="geometry"/></mxCell><mxCell id="b-8" value="Accept &lt;span style=&quot;font-family: Courier New&quot;&gt;value&lt;/span&gt; + &lt;span style=&quot;font-family: Courier New&quot;&gt;onChange&lt;/span&gt; &lt;b&gt;and&lt;/b&gt; fall back to internal state, so it works both ways. This is the senior answer." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="216" width="576" height="62" as="geometry"/></mxCell><mxCell id="b-9" value="4 · the keyboard and the roles" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="286" width="186" height="62" as="geometry"/></mxCell><mxCell id="b-10" value="A row that only responds to a click is not finished. &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;button&amp;gt;&lt;/span&gt;, &lt;span style=&quot;font-family: Courier New&quot;&gt;aria-expanded&lt;/span&gt;, Enter and Space." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="220" y="286" width="576" height="62" as="geometry"/></mxCell><mxCell id="p-11" value="The derived-state trap, which is the same trap every time" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="362" width="772" height="164" as="geometry"/></mxCell><mxCell id="b-12" value="// two sources of truth&lt;br/&gt;const [items, setItems] = useState(props.items);&lt;br/&gt;const [count, setCount] = useState(props.items.length);&lt;br/&gt;// props.items changes → both are now stale" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="396" width="362" height="86" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;b&gt;Derive, do not copy.&lt;/b&gt; &lt;span style=&quot;font-family: Courier New&quot;&gt;const count = items.length&lt;/span&gt; cannot go stale.&lt;br/&gt;&lt;br/&gt;If a prop really must seed state, &lt;span style=&quot;font-family: Courier New&quot;&gt;key&lt;/span&gt; it from outside so React remounts the component instead of you syncing it in an effect." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="396" width="362" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>