try></mxCell><mxCell id="b-11" value="Dashboard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="96" y="176" width="252" height="28" as="geometry"/></mxCell><mxCell id="a-12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="202" as="sourcePoint"/><mxPoint x="108" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="224" as="sourcePoint"/><mxPoint x="120" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-14" value="lazy(Chart)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="120" y="210" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-15" value="suspends" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="356" y="210" width="120" height="28" as="geometry"/></mxCell><mxCell id="b-16" value="While the chunk is loading, React shows &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;Skeleton/&amp;gt;&lt;/span&gt; &lt;b&gt;in place of the whole boundary&lt;/b&gt; — not in place of &lt;span style=&quot;font-family: Courier New&quot;&gt;Chart&lt;/span&gt; alone." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="500" y="112" width="278" height="74" as="geometry"/></mxCell><mxCell id="b-17" value="So the boundary goes where the loading state makes visual sense. One boundary around the page means the whole page blinks." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="500" y="194" width="278" height="74" as="geometry"/></mxCell><mxCell id="p-18" value="What actually suspends" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="300" width="772" height="132" as="geometry"/></mxCell><mxCell id="b-19" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;React.lazy(() =&amp;gt; import(&amp;quot;./Chart&amp;quot;))&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="334" width="306" height="22" as="geometry"/></mxCell><mxCell id="t-20" value="the chunk request" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="362" y="334" width="416" height="22" as="geometry"/></mxCell><mxCell id="b-21" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;use(promise)&lt;/span&gt; — React 19" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="358" width="306" height="22" as="geometry"/></mxCell><mxCell id="t-22" value="any promise read during render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="362" y="358" width="416" height="22" as="geometry"/></mxCell><mxCell id="b-23" value="a framework data hook (RSC, Router)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="382" width="306" height="22" as="geometry"/></mxCell><mxCell id="t-24" value="built on the same mechanism" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="362" y="382" width="416" height="22" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(() =&amp;gt; fetch(…))&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="406" width="306" height="22" as="geometry"/></mxCell><mxCell id="t-26" value="&lt;b&gt;does not suspend&lt;/b&gt; — the effect runs after render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="362" y="406" width="416" height="22" as="geometry"/></mxCell><mxCell id="p-27" value="What lazy buys" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="448" width="772" height="74" as="geometry"/></mxCell><mxCell id="b-28" value="one bundle · 820 KB · everything up front" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="478" width="362" height="32" as="geometry"/></mxCell><mxCell id="a-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="494" as="sourcePoint"/><mxPoint x="438" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-30" value="shell 180 KB + chart 640 KB on demand" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="478" width="334" height="32" as="geometry"/></mxCell><mxCell id="b-31" value="Split on routes first — a user who never opens the dashboard should never download the charting library." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="530"