<mxfile host="app.diagrams.net" type="device"><diagram name="memo and the reference trap" id="memo and the reference trap"><mxGraphModel dx="820" dy="670" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="670" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="React.memo and the reference trap" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Memoisation compares by identity, and every render makes new objects" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;memo&lt;/span&gt; runs a shallow &lt;span style=&quot;font-family: Courier New&quot;&gt;Object.is&lt;/span&gt; over every prop" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="128" as="geometry"/></mxCell><mxCell id="b-4" value="title=&amp;quot;Inbox&amp;quot;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="106" width="246" height="20" as="geometry"/></mxCell><mxCell id="t-5" value="string" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="106" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-6" value="equal every render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="106" width="358" height="20" as="geometry"/></mxCell><mxCell id="b-7" value="count={3}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="128" width="246" height="20" as="geometry"/></mxCell><mxCell id="t-8" value="number" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="128" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-9" value="equal every render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="128" width="358" height="20" as="geometry"/></mxCell><mxCell id="b-10" value="style={{ top: 0 }}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="150" width="246" height="20" as="geometry"/></mxCell><mxCell id="t-11" value="new object" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="150" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-12" value="&lt;b&gt;never&lt;/b&gt; equal" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="150" width="358" height="20" as="geometry"/></mxCell><mxCell id="b-13" value="onSelect={() =&amp;gt; …}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="172" width="246" height="20" as="geometry"/></mxCell><mxCell id="t-14" value="new function" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="300" y="172" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-15" value="&lt;b&gt;never&lt;/b&gt; equal" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="172" width="358" height="20" as="geometry"/></mxCell><mxCell id="p-16" value="memo defeated by one prop" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="214" width="378" height="238" as="geometry"/></mxCell><mxCell id="p-17" value="memo actually working" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="214" width="378" height="238" as="geometry"/></mxCell><mxCell id="b-18" value="function Page() {&lt;br/&gt;  const [q, setQ] = useState(&amp;quot;&amp;quot;);&lt;br/&gt;  return &amp;lt;List&lt;br/&gt;    items={items.filter(f)}   // new array&lt;br/&gt;    onPick={x =&amp;gt; open(x)} /&amp;gt;;  // new fn&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="248" width="346" height="100" as="geometry"/></mxCell><mxCell id="b-19" value="Typing one character re-renders &lt;span style=&quot;font-family: Courier New&quot;&gt;Page&lt;/span&gt;, which builds a new array and a new function, so &lt;span style=&quot;font-family: Courier New&quot;&gt;memo(List)&lt;/span&gt; compares two objects that are never &lt;span style=&quot;font-family: Courier New&quot;&gt;Object.is&lt;/span&gt; equal and re-renders anyway.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;You pay for the comparison and get nothing.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="356" width="346" height="92" as="geometry"/></mxCell><mxCell id="b-20" value="const shown = useMemo(&lt;br/&gt;  () =&amp;gt; items.filter(f), [items]);&lt;br/&gt;const onPick = useCallback(&lt;br/&gt;  x =&amp;gt; open(x), []);&lt;br/&gt;return &amp;lt;List items={shown} onPick={onPick} /&amp;gt;;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="248" width="346" height="86" as="geometry"/></mxCell><mxCell id="b-21" value="Both props keep the &lt;i&gt;same reference&lt;/i&gt; until &lt;span style=&quot;font-family: Courier New&quot;&gt;items&lt;/span&gt; changes, so the shallow compare succeeds and &lt;span style=&quot;font-family: Courier New&quot;&gt;List&lt;/span&gt; — plus its whole subtree — is skipped.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;All three have to agree, or none of them help.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="356" width="346" height="92" as="geometry"/></mxCell><mxCell id="p-22" value="When memoising is the slower option" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="466" width="772" height="130" as="geometry"/></mxCell><mxCell id="b-23" value="the comparison is not free" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="500" width="234" height="26" as="geometry"/></mxCell><mxCell id="t-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;memo&lt;/span&gt; walks every prop on every render; for a component that renders three spans, that is the expensive half" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="290" y="500" width="488" height="26" as="geometry"/></mxCell><mxCell id="b-25" value="useMemo caches forever-cheap work" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="530" width="234" height="26" as="geometry"/></mxCell><mxCell id="t-26" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useMemo(() =&amp;gt; a + b, [a, b])&lt;/span&gt; costs a dependency compare and an array allocation to avoid an addition" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="290" y="530" width="488" height="26" as="geometry"/></mxCell><mxCell id="b-27" value="memory is held until unmount" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="560" width="234" height="26" as="geometry"/></mxCell><mxCell id="t-28" value="every cached value keeps its inputs alive — a memoised list of 10,000 rows keeps two copies" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="290" y="560" width="488" height="26" as="geometry"/></mxCell><mxCell id="b-29" value="Reach for memo when a heavy subtree re-renders with unchanged props — measure first. Composition (passing children through) usually beats all three of these and costs nothing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="610" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>