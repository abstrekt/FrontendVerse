<mxfile host="app.diagrams.net" type="device"><diagram name="Reconciliation and keys" id="Reconciliation and keys"><mxGraphModel dx="820" dy="612" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="612" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Reconciliation: diff by position, then by type" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="And what &lt;span style=&quot;font-family: Courier New&quot;&gt;key&lt;/span&gt; changes about it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="The heuristic — O(n), not a real tree diff" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="100" as="geometry"/></mxCell><mxCell id="b-4" value="same position, same type" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="104" width="236" height="20" as="geometry"/></mxCell><mxCell id="t-5" value="keep the fiber, keep the state, update props" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="292" y="104" width="486" height="20" as="geometry"/></mxCell><mxCell id="b-6" value="same position, different type" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="126" width="236" height="20" as="geometry"/></mxCell><mxCell id="t-7" value="unmount the whole subtree, mount a new one" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="292" y="126" width="486" height="20" as="geometry"/></mxCell><mxCell id="b-8" value="different &lt;span style=&quot;font-family: Courier New&quot;&gt;key&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="148" width="236" height="20" as="geometry"/></mxCell><mxCell id="t-9" value="treated as a different element — state is discarded" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="292" y="148" width="486" height="20" as="geometry"/></mxCell><mxCell id="p-10" value="Removing the first row of a list keyed by index" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="186" width="772" height="250" as="geometry"/></mxCell><mxCell id="t-11" value="before" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="220" width="120" height="18" as="geometry"/></mxCell><mxCell id="b-12" value="Ada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="160" y="214" width="118" height="32" as="geometry"/></mxCell><mxCell id="b-13" value="Grace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="282" y="214" width="118" height="32" as="geometry"/></mxCell><mxCell id="b-14" value="Linus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="404" y="214" width="118" height="32" as="geometry"/></mxCell><mxCell id="t-15" value="key=0" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="160" y="248" width="118" height="14" as="geometry"/></mxCell><mxCell id="t-16" value="key=1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="282" y="248" width="118" height="14" as="geometry"/></mxCell><mxCell id="t-17" value="key=2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="404" y="248" width="118" height="14" as="geometry"/></mxCell><mxCell id="t-18" value="each row owns an uncontrolled &amp;lt;input&amp;gt; with text in it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="160" y="266" width="360" height="16" as="geometry"/></mxCell><mxCell id="a-19" value="remove &amp;quot;Ada&amp;quot;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="288" as="sourcePoint"/><mxPoint x="410" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-20" value="after" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="322" width="120" height="18" as="geometry"/></mxCell><mxCell id="b-21" value="Grace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="160" y="316" width="118" height="32" as="geometry"/></mxCell><mxCell id="b-22" value="Linus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="282" y="316" width="118" height="32" as="geometry"/></mxCell><mxCell id="t-23" value="key=0" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="160" y="350" width="118" height="14" as="geometry"/></mxCell><mxCell id="t-24" value="key=1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="282" y="350" width="118" height="14" as="geometry"/></mxCell><mxCell id="b-25" value="Position 0 still says &lt;span style=&quot;font-family: Courier New&quot;&gt;key=0&lt;/span&gt; and still says &lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;Row&amp;gt;&lt;/span&gt;, so React &lt;b&gt;reuses&lt;/b&gt; the fiber: it changes the label prop and keeps everything else. Ada's typed text is now sitting in Grace's row." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="410" y="316" width="368" height="74" as="geometry"/></mxCell><mxCell id="t-26" value="The DOM is not &amp;quot;wrong&amp;quot; — it is exactly what you asked for. The key said these are the same row." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="160" y="398" width="600" height="16" as="geometry"/></mxCell><mxCell id="p-27" value="A stable id fixes it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="452" width="378" height="96" as="geometry"/></mxCell><mxCell id="p-28" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;key&lt;/span&gt; as a deliberate state reset" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="452" width="378" height="96" as="geometry"/></mxCell><mxCell id="b-29" value="items.map(i =&amp;gt;&lt;br/&gt;  &amp;lt;Row key={i.id} … /&amp;gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="486" width="346" height="52" as="geometry"/></mxCell><mxCell id="b-30" value="&amp;lt;Form key={userId} /&amp;gt;&lt;br/&gt;// switch user → fresh form state" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="486" width="346" height="52" as="geometry"/></mxCell><mxCell id="b-31" value="A key is an identity claim, not a loop counter. Index keys are safe only for a list that never reorders, filters or grows from the front." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="536" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>