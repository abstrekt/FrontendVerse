<mxfile host="app.diagrams.net" type="device"><diagram name="Race conditions in data fetching" id="Race conditions in data fetching"><mxGraphModel dx="820" dy="588" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="588" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Race conditions in data fetching" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The slow answer to the old question arrives last" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Typing &amp;quot;re&amp;quot; then &amp;quot;react&amp;quot; — two requests in flight" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="196" as="geometry"/></mxCell><mxCell id="t-4" value="fetch(&amp;quot;re&amp;quot;)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="44" y="108" width="92" height="26" as="geometry"/></mxCell><mxCell id="b-5" value="slow — 600 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="148" y="108" width="480" height="26" as="geometry"/></mxCell><mxCell id="t-6" value="fetch(&amp;quot;react&amp;quot;)" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="44" y="146" width="92" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="fast — 150 ms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="238" y="146" width="200" height="26" as="geometry"/></mxCell><mxCell id="a-8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="172" as="sourcePoint"/><mxPoint x="438" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-9" value="setResults(react results)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="340" y="196" width="196" height="24" as="geometry"/></mxCell><mxCell id="a-10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="628" y="134" as="sourcePoint"/><mxPoint x="628" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-11" value="setResults(re results)  ← overwrites" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="560" y="226" width="218" height="24" as="geometry"/></mxCell><mxCell id="t-12" value="The box now shows results for &amp;quot;re&amp;quot; while the field says &amp;quot;react&amp;quot;. Nothing errored." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="232" width="500" height="28" as="geometry"/></mxCell><mxCell id="p-13" value="Ignore the stale response" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="286" width="378" height="230" as="geometry"/></mxCell><mxCell id="p-14" value="Abort it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="286" width="378" height="230" as="geometry"/></mxCell><mxCell id="b-15" value="useEffect(() =&amp;gt; {&lt;br/&gt;  let current = true;&lt;br/&gt;  fetch(url).then(r =&amp;gt; r.json()).then(d =&amp;gt; {&lt;br/&gt;    if (current) setResults(d);   // last one wins&lt;br/&gt;  });&lt;br/&gt;  return () =&amp;gt; { current = false; };&lt;br/&gt;}, [url]);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="320" width="346" height="129" as="geometry"/></mxCell><mxCell id="t-16" value="The cleanup for the old effect runs before the new one, so the flag is already false by the time the slow response lands." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="474" width="346" height="34" as="geometry"/></mxCell><mxCell id="b-17" value="useEffect(() =&amp;gt; {&lt;br/&gt;  const ac = new AbortController();&lt;br/&gt;  fetch(url, { signal: ac.signal })&lt;br/&gt;    .then(r =&amp;gt; r.json())&lt;br/&gt;    .then(setResults)&lt;br/&gt;    .catch(e =&amp;gt; { if (e.name !== &amp;quot;AbortError&amp;quot;) throw e; });&lt;br/&gt;  return () =&amp;gt; ac.abort();&lt;br/&gt;}, [url]);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="320" width="346" height="143" as="geometry"/></mxCell><mxCell id="t-18" value="Also frees the connection — better for a real search box, but you must swallow the AbortError." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="434" y="474" width="346" height="34" as="geometry"/></mxCell><mxCell id="b-19" value="Any effect that sets state from an async result needs one of these. A query library does it for you, which is most of why they exist." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="530" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>