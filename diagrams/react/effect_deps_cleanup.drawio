<mxfile host="app.diagrams.net" type="device"><diagram name="Effect dependencies and cleanup" id="Effect dependencies and cleanup"><mxGraphModel dx="820" dy="616" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="616" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="useEffect: dependencies and cleanup" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The cleanup runs before the next effect, not only on unmount" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="The dependency array picks one of three behaviours" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="148" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(fn)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="106" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-5" value="no array" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="136" width="228" height="14" as="geometry"/></mxCell><mxCell id="b-6" value="Runs after &lt;b&gt;every&lt;/b&gt; render.&lt;br/&gt;Usually a bug." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="152" width="228" height="52" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(fn, [])&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="292" y="106" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-8" value="empty array" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="292" y="136" width="228" height="14" as="geometry"/></mxCell><mxCell id="b-9" value="Runs &lt;b&gt;once&lt;/b&gt; after mount.&lt;br/&gt;Cleanup runs on unmount." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="292" y="152" width="228" height="52" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(fn, [a, b])&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="540" y="106" width="228" height="28" as="geometry"/></mxCell><mxCell id="t-11" value="watched values" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="540" y="136" width="228" height="14" as="geometry"/></mxCell><mxCell id="b-12" value="Re-runs when &lt;span style=&quot;font-family: Courier New&quot;&gt;a&lt;/span&gt; or &lt;span style=&quot;font-family: Courier New&quot;&gt;b&lt;/span&gt; change&lt;br/&gt;by &lt;span style=&quot;font-family: Courier New&quot;&gt;Object.is&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="540" y="152" width="228" height="52" as="geometry"/></mxCell><mxCell id="p-13" value="Cleanup order over a value change — &lt;span style=&quot;font-family: Courier New&quot;&gt;[roomId]&lt;/span&gt; goes &amp;quot;general&amp;quot; → &amp;quot;music&amp;quot;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="234" width="772" height="246" as="geometry"/></mxCell><mxCell id="t-14" value="mount" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="274" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-15" value="connect(&amp;quot;general&amp;quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="274" width="226" height="28" as="geometry"/></mxCell><mxCell id="t-16" value="roomId → &amp;quot;music&amp;quot;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="318" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-17" value="disconnect(&amp;quot;general&amp;quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="318" width="226" height="28" as="geometry"/></mxCell><mxCell id="b-18" value="connect(&amp;quot;music&amp;quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="438" y="318" width="226" height="28" as="geometry"/></mxCell><mxCell id="a-19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="426" y="332" as="sourcePoint"/><mxPoint x="438" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-20" value="unmount" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="362" width="150" height="28" as="geometry"/></mxCell><mxCell id="b-21" value="disconnect(&amp;quot;music&amp;quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="362" width="226" height="28" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;The old cleanup runs first.&lt;/b&gt; That is what makes an effect safe to re-run: subscribe/unsubscribe, connect/disconnect and add/removeEventListener always pair up, so a changed dependency can never leave two live subscriptions behind." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="410" width="732" height="62" as="geometry"/></mxCell><mxCell id="p-23" value="The trap: a dependency that is a new value every render" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="492" width="772" height="66" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(fn, [{ id }])&lt;/span&gt; — new object, runs every time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="520" width="354" height="30" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect(fn, [id])&lt;/span&gt; — a primitive, compares by value" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="520" width="354" height="30" as="geometry"/></mxCell><mxCell id="b-26" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="594" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-27" value="setup" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="590" width="38.5" height="18" as="geometry"/></mxCell><mxCell id="b-28" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="92.5" y="594" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-29" value="teardown then setup" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="109.5" y="590" width="123.89999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-30" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="246.39999999999998" y="594" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-31" value="the bug" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="263.4" y="590" width="50.699999999999996" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>