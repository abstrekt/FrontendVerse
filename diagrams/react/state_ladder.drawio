<mxfile host="app.diagrams.net" type="device"><diagram name="Where state should live" id="Where state should live"><mxGraphModel dx="820" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="600" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Where should this state live?" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Climb one rung only when the rung below actually fails" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="b-3" value="1 · local &lt;span style=&quot;font-family: Courier New&quot;&gt;useState&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="76" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-4" value="one component needs it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="76" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-5" value="A toggle, an input, a hovered row. Most state stops here." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="76" width="296" height="46" as="geometry"/></mxCell><mxCell id="b-6" value="2 · lifted to a parent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="130" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-7" value="two siblings need it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="130" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-8" value="Move it to their lowest common owner and pass it down. Still no library." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="130" width="296" height="46" as="geometry"/></mxCell><mxCell id="b-9" value="3 · &lt;span style=&quot;font-family: Courier New&quot;&gt;useReducer&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="184" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-10" value="several fields change together" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="184" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-11" value="When transitions matter more than values — a wizard, a form with validation." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="184" width="296" height="46" as="geometry"/></mxCell><mxCell id="b-12" value="4 · context" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="238" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-13" value="passed through 3+ levels, changes rarely" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="238" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-14" value="Theme, locale, the signed-in user. Split it and memoise the value." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="238" width="296" height="46" as="geometry"/></mxCell><mxCell id="b-15" value="5 · a store (Redux / Zustand)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="292" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-16" value="many writers, needs devtools or middleware" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="292" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-17" value="Cross-cutting client state with real complexity. Selectors keep renders narrow." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="292" width="296" height="46" as="geometry"/></mxCell><mxCell id="b-18" value="6 · a server cache (React Query)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="346" width="252" height="46" as="geometry"/></mxCell><mxCell id="b-19" value="the data belongs to a server" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="286" y="346" width="200" height="46" as="geometry"/></mxCell><mxCell id="t-20" value="Not state at all — a cache. Gets you refetch, dedupe and staleness for free." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="500" y="346" width="296" height="46" as="geometry"/></mxCell><mxCell id="a-21" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="80" as="sourcePoint"/><mxPoint x="14" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-22" value="The two questions that answer it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="406" width="772" height="96" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;Who reads it?&lt;/b&gt; Put it at the lowest node that contains all of them — no higher." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="440" width="362" height="46" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;b&gt;Who owns the truth?&lt;/b&gt; If the answer is &amp;quot;a server&amp;quot;, it is a cache with a staleness policy, not state." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="440" width="362" height="46" as="geometry"/></mxCell><mxCell id="b-25" value="Most &amp;quot;we need state management&amp;quot; problems are a prop drilled four levels or a fetch pretending to be state. Reach for rung 5 last, not first." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="514" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>