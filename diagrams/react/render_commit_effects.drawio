<mxfile host="app.diagrams.net" type="device"><diagram name="Render, commit, paint, effects" id="Render, commit, paint, effects"><mxGraphModel dx="820" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="560" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Render → Commit → Paint → Effects" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Where your code runs, and what the user can see when it does" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="pl-3" value="render" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="84" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="166" y="99" as="sourcePoint"/><mxPoint x="192" y="99" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-5" value="commit DOM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="192" y="84" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="99" as="sourcePoint"/><mxPoint x="346" y="99" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-7" value="useLayoutEffect" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="346" y="84" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="99" as="sourcePoint"/><mxPoint x="500" y="99" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-9" value="paint" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="500" y="84" width="128" height="30" as="geometry"/></mxCell><mxCell id="a-10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="628" y="99" as="sourcePoint"/><mxPoint x="654" y="99" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-11" value="useEffect" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="654" y="84" width="128" height="30" as="geometry"/></mxCell><mxCell id="b-12" value="Your component function body runs.&lt;br/&gt;Must be &lt;b&gt;pure&lt;/b&gt; — no DOM reads, no&lt;br/&gt;mutations, no fetches." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=9;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="132" width="138" height="92" as="geometry"/></mxCell><mxCell id="b-13" value="React mutates the real DOM.&lt;br/&gt;Refs are attached here.&lt;br/&gt;Nothing is on screen yet." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=9;shadow=0" vertex="1" parent="1"><mxGeometry x="192" y="132" width="138" height="92" as="geometry"/></mxCell><mxCell id="b-14" value="Runs &lt;b&gt;before paint&lt;/b&gt;. Measure and&lt;br/&gt;re-set layout here and the user&lt;br/&gt;never sees the first position." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=9;shadow=0" vertex="1" parent="1"><mxGeometry x="346" y="132" width="138" height="92" as="geometry"/></mxCell><mxCell id="b-15" value="The browser draws.&lt;br/&gt;Everything above this line is&lt;br/&gt;blocking it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=9;shadow=0" vertex="1" parent="1"><mxGeometry x="500" y="132" width="138" height="92" as="geometry"/></mxCell><mxCell id="b-16" value="Runs &lt;b&gt;after paint&lt;/b&gt;. Fetches,&lt;br/&gt;subscriptions, logging — anything&lt;br/&gt;the user need not wait for." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=9;shadow=0" vertex="1" parent="1"><mxGeometry x="654" y="132" width="138" height="92" as="geometry"/></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="38" y="244" as="sourcePoint"/><mxPoint x="782" y="244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-18" value="everything left of &amp;quot;paint&amp;quot; blocks the pixels" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="38" y="248" width="400" height="16" as="geometry"/></mxCell><mxCell id="p-19" value="useEffect — the user sees the wrong frame" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="278" width="378" height="172" as="geometry"/></mxCell><mxCell id="p-20" value="useLayoutEffect — the user never does" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="278" width="378" height="172" as="geometry"/></mxCell><mxCell id="b-21" value="render → commit → &lt;b&gt;paint (wrong position)&lt;/b&gt; → effect → paint again" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="314" width="346" height="40" as="geometry"/></mxCell><mxCell id="b-22" value="A tooltip mounted at 0,0 and then moved in &lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect&lt;/span&gt; is painted at 0,0 first. One frame of visible jump." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="362" width="346" height="66" as="geometry"/></mxCell><mxCell id="b-23" value="render → commit → &lt;b&gt;layout effect (move it)&lt;/b&gt; → paint once" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="314" width="346" height="40" as="geometry"/></mxCell><mxCell id="b-24" value="Correct position in the first painted frame — paid for by blocking the browser, so use it only when a measurement decides the layout." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="362" width="346" height="66" as="geometry"/></mxCell><mxCell id="b-25" value="Rendering is not painting. A component can render ten times and the user never sees a frame — the cost you can see is the commit." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="456" width="772" height="46" as="geometry"/></mxCell><mxCell id="b-26" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="538" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-27" value="React work" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="534" width="69" height="18" as="geometry"/></mxCell><mxCell id="b-28" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="123" y="538" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-29" value="blocks paint" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="140" y="534" width="81.19999999999999" height="18" as="geometry"/></mxCell><mxCell id="b-30" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="234.2" y="538" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-31" value="painted" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="251.2" y="534" width="50.699999999999996" height="18" as="geometry"/></mxCell><mxCell id="b-32" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#0EA5E9;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="314.9" y="538" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-33" value="after paint" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="331.9" y="534" width="75.1" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>