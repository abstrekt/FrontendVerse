<mxfile host="app.diagrams.net" type="device"><diagram name="Batching and the update queue" id="Batching and the update queue"><mxGraphModel dx="820" dy="552" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="552" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Batching and the update queue" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;setState&lt;/span&gt; schedules; it does not assign" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Three calls with the value form" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="224" as="geometry"/></mxCell><mxCell id="p-4" value="Three calls with the updater form" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="224" as="geometry"/></mxCell><mxCell id="b-5" value="// count is 0 in this render&lt;br/&gt;setCount(count + 1);&lt;br/&gt;setCount(count + 1);&lt;br/&gt;setCount(count + 1);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="72" as="geometry"/></mxCell><mxCell id="b-6" value="set 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="b-7" value="set 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="160" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="b-8" value="set 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="280" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="t-9" value="queue — every entry read the same frozen count" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="40" y="204" width="340" height="16" as="geometry"/></mxCell><mxCell id="b-10" value="one re-render  ·  count = 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="224" width="346" height="30" as="geometry"/></mxCell><mxCell id="b-11" value="Three calls, one render, and two of them did nothing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="262" width="346" height="24" as="geometry"/></mxCell><mxCell id="b-12" value="// ask for the latest, do not capture&lt;br/&gt;setCount(c =&amp;gt; c + 1);&lt;br/&gt;setCount(c =&amp;gt; c + 1);&lt;br/&gt;setCount(c =&amp;gt; c + 1);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="72" as="geometry"/></mxCell><mxCell id="b-13" value="0 → 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="b-14" value="1 → 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="554" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="186" as="sourcePoint"/><mxPoint x="554" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="2 → 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="674" y="172" width="108" height="28" as="geometry"/></mxCell><mxCell id="a-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="662" y="186" as="sourcePoint"/><mxPoint x="674" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-18" value="queue — each function receives the previous result" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="434" y="204" width="340" height="16" as="geometry"/></mxCell><mxCell id="b-19" value="one re-render  ·  count = 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="224" width="346" height="30" as="geometry"/></mxCell><mxCell id="b-20" value="Still one render — batching is not the problem, capturing was." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="262" width="346" height="24" as="geometry"/></mxCell><mxCell id="p-21" value="React 18 batches everywhere — that changed" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="312" width="772" height="152" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;React 17 and earlier:&lt;/b&gt; only inside React event handlers. A &lt;span style=&quot;font-family: Courier New&quot;&gt;setTimeout&lt;/span&gt; or a &lt;span style=&quot;font-family: Courier New&quot;&gt;.then()&lt;/span&gt; re-rendered once &lt;i&gt;per&lt;/i&gt; call." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="348" width="362" height="44" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;React 18 (automatic batching):&lt;/b&gt; timers, promises and native handlers batch too. Fewer renders, same result." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="348" width="362" height="44" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;flushSync(() =&amp;gt; setX(1))&lt;/span&gt; opts one update out and re-renders synchronously — for the rare case where you must read the DOM before the next line runs. It costs you the batch." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="402" width="732" height="44" as="geometry"/></mxCell><mxCell id="b-25" value="State is not a variable you assign — it is a request. Between the call and the next render, &lt;span style=&quot;font-family: Courier New&quot;&gt;count&lt;/span&gt; is still the old number." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="476" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>