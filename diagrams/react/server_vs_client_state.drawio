<mxfile host="app.diagrams.net" type="device"><diagram name="Server state is a cache" id="Server state is a cache"><mxGraphModel dx="820" dy="520" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="520" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Server state is a cache, not state" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="The moment you fetch it, someone else owns the truth" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Client state — you own it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="224" as="geometry"/></mxCell><mxCell id="p-4" value="Server state — you borrowed it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="224" as="geometry"/></mxCell><mxCell id="b-5" value="is this modal open" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-6" value="which tab is selected" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="134" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-7" value="what is typed in the form" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="164" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="light or dark theme" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="194" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-9" value="Synchronous, always correct, and nobody else can change it. &lt;span style=&quot;font-family: Courier New&quot;&gt;useState&lt;/span&gt; is the whole answer." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="228" width="346" height="58" as="geometry"/></mxCell><mxCell id="b-10" value="the list of orders" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-11" value="the current user profile" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="134" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-12" value="search results" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="164" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-13" value="anything from an endpoint" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="194" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-14" value="Asynchronous, possibly stale the instant it arrives, and shared with every other tab and user." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="228" width="346" height="58" as="geometry"/></mxCell><mxCell id="p-15" value="What &lt;span style=&quot;font-family: Courier New&quot;&gt;useState&lt;/span&gt; + &lt;span style=&quot;font-family: Courier New&quot;&gt;useEffect&lt;/span&gt; makes you write yourself" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="314" width="772" height="140" as="geometry"/></mxCell><mxCell id="b-16" value="loading / error flags" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="350" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-17" value="cancel on unmount" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="230" y="350" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-18" value="dedupe concurrent calls" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="350" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-19" value="refetch on focus" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="602" y="350" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-20" value="retry with backoff" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="382" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-21" value="cache across components" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="230" y="382" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-22" value="invalidate after a write" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="382" width="174" height="28" as="geometry"/></mxCell><mxCell id="b-23" value="keep previous data" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="602" y="382" width="174" height="28" as="geometry"/></mxCell><mxCell id="t-24" value="A server-cache library (React Query, SWR, RTK Query) is these eight things. That is the whole pitch — not &amp;quot;a nicer fetch&amp;quot;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="416" width="732" height="30" as="geometry"/></mxCell><mxCell id="b-25" value="Never copy fetched data into useState &amp;quot;so we can edit it&amp;quot;. Keep the cache as the source and hold only the edits locally." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="462" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>