<mxfile host="app.diagrams.net" type="device"><diagram name="The accessibility tree" id="The accessibility tree"><mxGraphModel dx="820" dy="570" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="570" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="The accessibility tree" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="What a screen reader gets is not what you wrote" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Same pixels, different tree" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="198" as="geometry"/></mxCell><mxCell id="t-4" value="a div dressed as a button" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="104" width="340" height="16" as="geometry"/></mxCell><mxCell id="b-5" value="&amp;lt;div className=&amp;quot;btn&amp;quot; onClick={save}&amp;gt;&lt;br/&gt;  Save&lt;br/&gt;&amp;lt;/div&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="48" y="124" width="340" height="57" as="geometry"/></mxCell><mxCell id="b-6" value="role: &lt;b&gt;generic&lt;/b&gt;  ·  name: &amp;quot;Save&amp;quot;&lt;br/&gt;&lt;br/&gt;Not focusable · not in the tab order · Enter and Space do nothing · announced as plain text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="48" y="182" width="340" height="68" as="geometry"/></mxCell><mxCell id="t-7" value="a button" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="432" y="104" width="346" height="16" as="geometry"/></mxCell><mxCell id="b-8" value="&amp;lt;button onClick={save}&amp;gt;&lt;br/&gt;  Save&lt;br/&gt;&amp;lt;/button&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="432" y="124" width="346" height="57" as="geometry"/></mxCell><mxCell id="b-9" value="role: &lt;b&gt;button&lt;/b&gt;  ·  name: &amp;quot;Save&amp;quot;&lt;br/&gt;&lt;br/&gt;Focusable · in the tab order · Enter and Space fire it · announced as &amp;quot;Save, button&amp;quot;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="432" y="182" width="346" height="68" as="geometry"/></mxCell><mxCell id="p-10" value="The parts React makes you think about" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="288" width="772" height="190" as="geometry"/></mxCell><mxCell id="b-11" value="label every control" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="322" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-12" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;&amp;lt;label htmlFor&amp;gt;&lt;/span&gt; or &lt;span style=&quot;font-family: Courier New&quot;&gt;aria-label&lt;/span&gt;. &lt;span style=&quot;font-family: Courier New&quot;&gt;useId()&lt;/span&gt; gives you an id that is stable across server and client." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="322" width="542" height="26" as="geometry"/></mxCell><mxCell id="b-13" value="announce what changed" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="352" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-14" value="a route change or an async result needs &lt;span style=&quot;font-family: Courier New&quot;&gt;role=&amp;quot;status&amp;quot;&lt;/span&gt; / &lt;span style=&quot;font-family: Courier New&quot;&gt;aria-live&lt;/span&gt; — the DOM moved, the reader did not." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="352" width="542" height="26" as="geometry"/></mxCell><mxCell id="b-15" value="manage focus" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="382" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-16" value="on open, move focus into the dialog and trap it; on close, return it to the trigger." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="382" width="542" height="26" as="geometry"/></mxCell><mxCell id="b-17" value="keep the tab order" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="412" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-18" value="a portal is elsewhere in the DOM, so its tab position is elsewhere too — trap or re-order deliberately." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="412" width="542" height="26" as="geometry"/></mxCell><mxCell id="b-19" value="respect the OS" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="442" width="180" height="26" as="geometry"/></mxCell><mxCell id="t-20" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;prefers-reduced-motion&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;prefers-color-scheme&lt;/span&gt; are user settings, not preferences to override." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="236" y="442" width="542" height="26" as="geometry"/></mxCell><mxCell id="b-21" value="The first rule of ARIA is not to use it: a native element already has the role, the focus behaviour and the keyboard handling you would otherwise rebuild." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="512" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>