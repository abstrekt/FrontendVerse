x="200" y="131" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-6" value="dispatch(action)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="200" y="116" width="132" height="30" as="geometry"/></mxCell><mxCell id="a-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="332" y="131" as="sourcePoint"/><mxPoint x="354" y="131" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-8" value="reducer" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="354" y="116" width="132" height="30" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="131" as="sourcePoint"/><mxPoint x="508" y="131" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-10" value="new state" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="508" y="116" width="132" height="30" as="geometry"/></mxCell><mxCell id="a-11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="131" as="sourcePoint"/><mxPoint x="662" y="131" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pl-12" value="selector" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="662" y="116" width="132" height="30" as="geometry"/></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="146" as="sourcePoint"/><mxPoint x="728" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-14" value="re-render only the subscribed components" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="178" as="sourcePoint"/><mxPoint x="112" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112" y="178" as="sourcePoint"/><mxPoint x="112" y="146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-16" value="action" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="46" y="200" width="116" height="20" as="geometry"/></mxCell><mxCell id="t-17" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;{ type: &amp;quot;cart/add&amp;quot;, payload: id }&lt;/span&gt; — a plain object describing &lt;i&gt;what happened&lt;/i&gt;, never &lt;i&gt;what to set&lt;/i&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="174" y="200" width="604" height="20" as="geometry"/></mxCell><mxCell id="b-18" value="reducer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="46" y="222" width="116" height="20" as="geometry"/></mxCell><mxCell id="t-19" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;(state, action) =&amp;gt; newState&lt;/span&gt;. Pure: no fetches, no &lt;span style=&quot;font-family: Courier New&quot;&gt;Date.now()&lt;/span&gt;, no mutation. Same inputs, same output." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="174" y="222" width="604" height="20" as="geometry"/></mxCell><mxCell id="b-20" value="store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="46" y="244" width="116" height="20" as="geometry"/></mxCell><mxCell id="t-21" value="One object tree for the whole app. The only way in is &lt;span style=&quot;font-family: Courier New&quot;&gt;dispatch&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="174" y="244" width="604" height="20" as="geometry"/></mxCell><mxCell id="b-22" value="selector" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="46" y="266" width="116" height="20" as="geometry"/></mxCell><mxCell id="t-23" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;useSelector(s =&amp;gt; s.cart.total)&lt;/span&gt; subscribes to a &lt;i&gt;slice&lt;/i&gt;. Change something else and this component does not re-render." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="174" y="266" width="604" height="20" as="geometry"/></mxCell><mxCell id="p-24" value="Redux Toolkit — what it removes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="312" width="772" height="178" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;b&gt;By hand you wrote:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;· action type string constants&lt;br/&gt;· an action creator per type&lt;br/&gt;· a switch with manual spreading&lt;br/&gt;· &lt;span style=&quot;font-family: Courier New&quot;&gt;combineReducers&lt;/span&gt; wiring&lt;br/&gt;· thunk + devtools setup&lt;br/&gt;· deep-copy discipline everywhere" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="346" width="352" height="128" as="geometry"/></mxCell><mxCell id="b-26" value="const cart = createSlice({&lt;br/&gt;  name: &amp;quot;cart&amp;quot;,&lt;br/&gt;  initialState: { items: [] },&lt;br/&gt;  reducers: {&lt;br/&gt;    // Immer — safe to &amp;quot;mutate&amp;quot;&lt;br/&gt;    add: (s, a) =&amp;gt; { s.items.push(a.payload) }&lt;br/&gt;  }&lt;br/&gt;});" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="346" width="362" height="129" as="geometry"/></mxCell><mxCell id="b-27" value="The value is not the store — it is that every change is a serialisable object, so you can log it, replay it, and time-travel through it. Pay that cost only when you need it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="512" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>