<mxfile host="app.diagrams.net" type="device"><diagram name="useReducer vs useState" id="useReducer vs useState"><mxGraphModel dx="820" dy="540" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="540" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="useReducer vs useState" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Move from &amp;quot;set this field&amp;quot; to &amp;quot;this happened&amp;quot;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="Four useState calls" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="246" as="geometry"/></mxCell><mxCell id="p-4" value="One reducer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="246" as="geometry"/></mxCell><mxCell id="b-5" value="const [data, setData]       = useState(null);&lt;br/&gt;const [loading, setLoading] = useState(false);&lt;br/&gt;const [error, setError]     = useState(null);&lt;br/&gt;const [page, setPage]       = useState(1);" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="84" as="geometry"/></mxCell><mxCell id="b-6" value="Every call site must remember to update &lt;b&gt;all four&lt;/b&gt; consistently. Forget one and you get &lt;span style=&quot;font-family: Courier New&quot;&gt;loading: true&lt;/span&gt; with data already on screen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="196" width="346" height="46" as="geometry"/></mxCell><mxCell id="b-7" value="16 combinations exist.&lt;br/&gt;&lt;b&gt;4 of them are legal.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="250" width="346" height="56" as="geometry"/></mxCell><mxCell id="b-8" value="function reducer(s, action) {&lt;br/&gt;  switch (action.type) {&lt;br/&gt;    case &amp;quot;fetch&amp;quot;:   return { …s, loading: true };&lt;br/&gt;    case &amp;quot;success&amp;quot;: return { data: action.d, loading: false };&lt;br/&gt;    case &amp;quot;failure&amp;quot;: return { error: action.e, loading: false };&lt;br/&gt;  }&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="143" as="geometry"/></mxCell><mxCell id="b-9" value="Each transition is written once, in one place. An illegal combination is not reachable because no action produces it." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="196" width="346" height="46" as="geometry"/></mxCell><mxCell id="b-10" value="The reducer is a pure function.&lt;br/&gt;&lt;b&gt;Testable without React.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="250" width="346" height="56" as="geometry"/></mxCell><mxCell id="p-11" value="Reach for a reducer when…" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="772" height="122" as="geometry"/></mxCell><mxCell id="b-12" value="the next state depends on the previous one in a non-obvious way" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="370" width="732" height="20" as="geometry"/></mxCell><mxCell id="b-13" value="several fields have to move together to stay consistent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="392" width="732" height="20" as="geometry"/></mxCell><mxCell id="b-14" value="the same update is dispatched from many places" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="414" width="732" height="20" as="geometry"/></mxCell><mxCell id="b-15" value="you want to hand a stable &lt;span style=&quot;font-family: Courier New&quot;&gt;dispatch&lt;/span&gt; down instead of five callbacks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="436" width="732" height="20" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;dispatch&lt;/span&gt; is stable for the life of the component, so passing it through context never invalidates a memo — unlike a fresh setter closure." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="472" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>