<mxfile host="app.diagrams.net" type="device"><diagram name="Error boundaries" id="Error boundaries"><mxGraphModel dx="820" dy="592" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="592" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Error boundaries" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="A try/catch for rendering — and only for rendering" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="The error climbs to the nearest boundary above it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="214" as="geometry"/></mxCell><mxCell id="b-4" value="App" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="48" y="108" width="250" height="28" as="geometry"/></mxCell><mxCell id="a-5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="134" as="sourcePoint"/><mxPoint x="60" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="156" as="sourcePoint"/><mxPoint x="72" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-7" value="&amp;lt;ErrorBoundary&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="72" y="142" width="226" height="28" as="geometry"/></mxCell><mxCell id="t-8" value="catches · shows fallback" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="306" y="142" width="160" height="28" as="geometry"/></mxCell><mxCell id="a-9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84" y="168" as="sourcePoint"/><mxPoint x="84" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84" y="190" as="sourcePoint"/><mxPoint x="96" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-11" value="Dashboard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="96" y="176" width="202" height="28" as="geometry"/></mxCell><mxCell id="t-12" value="unmounted with it" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="306" y="176" width="160" height="28" as="geometry"/></mxCell><mxCell id="a-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="202" as="sourcePoint"/><mxPoint x="108" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="108" y="224" as="sourcePoint"/><mxPoint x="120" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-15" value="Chart" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="120" y="210" width="178" height="28" as="geometry"/></mxCell><mxCell id="t-16" value="throws" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="306" y="210" width="160" height="28" as="geometry"/></mxCell><mxCell id="a-17" value="throws upward" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="210" as="sourcePoint"/><mxPoint x="300" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-18" value="The &lt;b&gt;whole subtree under the boundary&lt;/b&gt; is unmounted and replaced by the fallback — so a page-level boundary turns one broken chart into a blank page." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="490" y="112" width="288" height="78" as="geometry"/></mxCell><mxCell id="b-19" value="Put a boundary around each independently-failing region: a widget, a route, a panel. Then one failure costs one widget." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="490" y="198" width="288" height="72" as="geometry"/></mxCell><mxCell id="p-20" value="Not caught by a boundary" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="300" width="378" height="220" as="geometry"/></mxCell><mxCell id="p-21" value="Caught" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="300" width="378" height="220" as="geometry"/></mxCell><mxCell id="b-22" value="event handlers" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="334" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-23" value="use a plain &lt;span style=&quot;font-family: Courier New&quot;&gt;try/catch&lt;/span&gt; — the render already finished" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="196" y="334" width="208" height="28" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;setTimeout&lt;/span&gt; / promises" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="366" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-25" value="async work escapes the render; catch it yourself" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="196" y="366" width="208" height="28" as="geometry"/></mxCell><mxCell id="b-26" value="server-side rendering" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="398" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-27" value="no boundary runs; handle it in the framework" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="196" y="398" width="208" height="28" as="geometry"/></mxCell><mxCell id="b-28" value="the boundary's own render" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="430" width="146" height="28" as="geometry"/></mxCell><mxCell id="t-29" value="nothing above it means the whole app unmounts" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="196" y="430" width="208" height="28" as="geometry"/></mxCell><mxCell id="b-30" value="class Boundary extends React.Component {&lt;br/&gt;  static getDerivedStateFromError(e) {&lt;br/&gt;    return { failed: true };   // show fallback&lt;br/&gt;  }&lt;br/&gt;  componentDidCatch(e, info) {&lt;br/&gt;    report(e, info.componentStack);&lt;br/&gt;  }&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="334" width="346" height="129" as="geometry"/></mxCell><mxCell id="t-31" value="Still class-only — there is no hook equivalent. Use &lt;span style=&quot;font-family: Courier New&quot;&gt;react-error-boundary&lt;/span&gt; rather than writing it again." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="434" y="470" width="346" height="40" as="geometry"/></mxCell><mxCell id="b-32" value="A boundary needs a way out: a Retry button that resets its state, or the user is stuck on the fallback until a reload." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="534" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>