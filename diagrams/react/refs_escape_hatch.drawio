<mxfile host="app.diagrams.net" type="device"><diagram name="Refs, the escape hatch" id="Refs, the escape hatch"><mxGraphModel dx="820" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="640" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Refs: the box React does not watch" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="A value that survives renders without causing one" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="state — React watches it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="378" height="132" as="geometry"/></mxCell><mxCell id="p-4" value="ref — React ignores it" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="70" width="378" height="132" as="geometry"/></mxCell><mxCell id="b-5" value="setCount(1)  →  re-render  →  new value on screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="104" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-6" value="Changing it is how you ask for a new frame. Reading it during render is always safe." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="138" width="346" height="52" as="geometry"/></mxCell><mxCell id="b-7" value="ref.current = 1  →  nothing happens" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="104" width="346" height="26" as="geometry"/></mxCell><mxCell id="b-8" value="One mutable box shared by every render. Reading or writing it &lt;b&gt;during&lt;/b&gt; render is not safe — do it in effects and handlers." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="138" width="346" height="52" as="geometry"/></mxCell><mxCell id="p-9" value="The four honest uses" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="218" width="772" height="158" as="geometry"/></mxCell><mxCell id="b-10" value="a DOM node" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="252" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-11" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;inputRef.current.focus()&lt;/span&gt;, measuring, scrolling into view" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="252" width="496" height="26" as="geometry"/></mxCell><mxCell id="b-12" value="a timer or subscription id" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="282" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-13" value="the thing cleanup has to cancel — it must survive renders and must not cause one" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="282" width="496" height="26" as="geometry"/></mxCell><mxCell id="b-14" value="the latest value for a callback" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="312" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-15" value="the escape from a stale closure inside a debounce or an interval" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="312" width="496" height="26" as="geometry"/></mxCell><mxCell id="b-16" value="previous props / render count" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="342" width="226" height="26" as="geometry"/></mxCell><mxCell id="t-17" value="written in an effect, read next render — never during this one" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="282" y="342" width="496" height="26" as="geometry"/></mxCell><mxCell id="p-18" value="Exposing an imperative API without exposing the DOM" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="392" width="772" height="176" as="geometry"/></mxCell><mxCell id="b-19" value="const Input = forwardRef((props, ref) =&amp;gt; {&lt;br/&gt;  const dom = useRef(null);&lt;br/&gt;  useImperativeHandle(ref, () =&amp;gt; ({&lt;br/&gt;    focus: () =&amp;gt; dom.current.focus(),&lt;br/&gt;    clear: () =&amp;gt; { dom.current.value = &amp;quot;&amp;quot;; }&lt;br/&gt;  }), []);&lt;br/&gt;  return &amp;lt;input ref={dom} {…props} /&amp;gt;;&lt;br/&gt;});" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="426" width="362" height="129" as="geometry"/></mxCell><mxCell id="b-20" value="The parent gets exactly &lt;span style=&quot;font-family: Courier New&quot;&gt;focus&lt;/span&gt; and &lt;span style=&quot;font-family: Courier New&quot;&gt;clear&lt;/span&gt; — not the node, so it cannot reach in and restyle it.&lt;br/&gt;&lt;br/&gt;Use it for focus, scroll, select and media controls. If you are reaching for it to push &lt;i&gt;data&lt;/i&gt; down, the data should have been a prop." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="416" y="426" width="362" height="86" as="geometry"/></mxCell><mxCell id="b-21" value="If a value is shown on screen, it is state. A ref is for things the user sees the effect of, never the value of." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="582" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>