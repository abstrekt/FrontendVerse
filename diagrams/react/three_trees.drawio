<mxfile host="app.diagrams.net" type="device"><diagram name="Elements, Fiber and the DOM" id="Elements, Fiber and the DOM"><mxGraphModel dx="820" dy="576" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="576" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="Elements → Fiber → DOM: the three trees" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Three representations of one UI, each with a different job" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="1 · Element tree" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="242" height="250" as="geometry"/></mxCell><mxCell id="b-4" value="{&lt;br/&gt;  type: List,&lt;br/&gt;  props: { items },&lt;br/&gt;  key: null&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="104" width="214" height="92" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;b&gt;Plain objects.&lt;/b&gt; Thrown away and rebuilt on &lt;i&gt;every&lt;/i&gt; render — creating them is cheap.&lt;br/&gt;&lt;br/&gt;This is what JSX compiles to." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="38" y="206" width="214" height="100" as="geometry"/></mxCell><mxCell id="p-6" value="2 · Fiber tree" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="281" y="70" width="242" height="250" as="geometry"/></mxCell><mxCell id="b-7" value="{&lt;br/&gt;  stateNode, memoizedState,&lt;br/&gt;  child, sibling, return,&lt;br/&gt;  alternate, flags&lt;br/&gt;}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="295" y="104" width="214" height="92" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;Persistent.&lt;/b&gt; Survives renders and holds your state, your hooks and the work still to do.&lt;br/&gt;&lt;br/&gt;A linked list, not a call stack — so React can pause." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="295" y="206" width="214" height="100" as="geometry"/></mxCell><mxCell id="p-9" value="3 · Host tree (DOM)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="538" y="70" width="242" height="250" as="geometry"/></mxCell><mxCell id="b-10" value="&amp;lt;ul&amp;gt;&lt;br/&gt;  &amp;lt;li&amp;gt;Ada&amp;lt;/li&amp;gt;&lt;br/&gt;  &amp;lt;li&amp;gt;Grace&amp;lt;/li&amp;gt;&lt;br/&gt;&amp;lt;/ul&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=0" vertex="1" parent="1"><mxGeometry x="552" y="104" width="214" height="92" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;Real nodes.&lt;/b&gt; The only tree the browser paints, and the expensive one to touch.&lt;br/&gt;&lt;br/&gt;Mutated only in the commit phase." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="552" y="206" width="214" height="100" as="geometry"/></mxCell><mxCell id="a-12" value="reconcile" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="266" y="150" as="sourcePoint"/><mxPoint x="281" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-13" value="commit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="523" y="150" as="sourcePoint"/><mxPoint x="538" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p-14" value="Why the middle tree exists" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D97706;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#6B3A05;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="336" width="772" height="156" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;Without fibers&lt;/b&gt; (the old stack reconciler) rendering was one recursive call. Once it started it ran to the end — a 3,000-row list froze the tab." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="372" width="352" height="54" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;With fibers&lt;/b&gt; the work is a list of units React owns. It can do some, yield to a click, and resume — or throw the half-done tree away." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="372" width="354" height="54" as="geometry"/></mxCell><mxCell id="t-17" value="Two fiber trees exist at once: &lt;b&gt;current&lt;/b&gt; (on screen) and &lt;b&gt;work-in-progress&lt;/b&gt; (being built). &lt;span style=&quot;font-family: Courier New&quot;&gt;alternate&lt;/span&gt; links each node to its twin, and committing is a pointer swap — which is why a render that is thrown away costs nothing on screen." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="436" width="734" height="40" as="geometry"/></mxCell><mxCell id="b-18" value="State lives on the fiber, not in your component. That is why a component function can run twice and still see one state." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="504" width="772" height="46" as="geometry"/></mxCell><mxCell id="b-19" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#0EA5E9;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="554" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-20" value="element" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="41" y="550" width="50.699999999999996" height="18" as="geometry"/></mxCell><mxCell id="b-21" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#5145E5;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="104.69999999999999" y="554" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-22" value="fiber" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="121.69999999999999" y="550" width="38.5" height="18" as="geometry"/></mxCell><mxCell id="b-23" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="173.2" y="554" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-24" value="DOM" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="190.2" y="550" width="26.299999999999997" height="18" as="geometry"/></mxCell><mxCell id="b-25" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="229.5" y="554" width="11" height="11" as="geometry"/></mxCell><mxCell id="t-26" value="the old cost" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="246.5" y="550" width="81.19999999999999" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>