<mxfile host="app.diagrams.net" type="device"><diagram name="What triggers a re-render" id="What triggers a re-render"><mxGraphModel dx="820" dy="596" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="596" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="What actually triggers a re-render" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-2" value="Three causes — and &amp;quot;my props changed&amp;quot; is not one of them" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-3" value="The complete list" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="118" as="geometry"/></mxCell><mxCell id="b-4" value="1 · its own state changed" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="104" width="246" height="24" as="geometry"/></mxCell><mxCell id="t-5" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;setState&lt;/span&gt; with a value &lt;span style=&quot;font-family: Courier New&quot;&gt;Object.is&lt;/span&gt; says is different" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="104" width="476" height="24" as="geometry"/></mxCell><mxCell id="b-6" value="2 · its parent re-rendered" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="130" width="246" height="24" as="geometry"/></mxCell><mxCell id="t-7" value="and did not bail out — this is the one that surprises people" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="130" width="476" height="24" as="geometry"/></mxCell><mxCell id="b-8" value="3 · a context it reads changed" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="156" width="246" height="24" as="geometry"/></mxCell><mxCell id="t-9" value="the provider's &lt;span style=&quot;font-family: Courier New&quot;&gt;value&lt;/span&gt; is a new reference" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="302" y="156" width="476" height="24" as="geometry"/></mxCell><mxCell id="p-10" value="The myth: &amp;quot;props changed, so it re-rendered&amp;quot;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#7A1414;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="204" width="378" height="212" as="geometry"/></mxCell><mxCell id="p-11" value="What actually happens" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="418" y="204" width="378" height="212" as="geometry"/></mxCell><mxCell id="b-12" value="A component with &lt;b&gt;no props at all&lt;/b&gt; still re-renders when its parent does. Props are not the trigger." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="240" width="346" height="46" as="geometry"/></mxCell><mxCell id="b-13" value="&amp;lt;Page&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="40" y="296" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-14" value="setState" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="198" y="296" width="152" height="28" as="geometry"/></mxCell><mxCell id="a-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="322" as="sourcePoint"/><mxPoint x="52" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;end