;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="482" y="360" width="102" height="28" as="geometry"/></mxCell><mxCell id="t-33" value="never reached" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="360" width="152" height="28" as="geometry"/></mxCell><mxCell id="p-34" value="What does &lt;i&gt;not&lt;/i&gt; cause a re-render" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="432" width="772" height="96" as="geometry"/></mxCell><mxCell id="b-35" value="mutating a ref (&lt;span style=&quot;font-family: Courier New&quot;&gt;ref.current = x&lt;/span&gt;)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="466" width="362" height="26" as="geometry"/></mxCell><mxCell id="b-36" value="mutating state in place (&lt;span style=&quot;font-family: Courier New&quot;&gt;arr.push(x)&lt;/span&gt;)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="422" y="466" width="362" height="26" as="geometry"/></mxCell><mxCell id="b-37" value="setting state to the same value" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" paren