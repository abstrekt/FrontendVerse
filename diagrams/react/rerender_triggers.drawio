><mxGeometry x="88" y="360" width="102" height="28" as="geometry"/></mxCell><mxCell id="t-22" value="re-renders" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="198" y="360" width="152" height="28" as="geometry"/></mxCell><mxCell id="b-23" value="React re-renders the &lt;b&gt;whole subtree&lt;/b&gt; below the state that changed, then diffs the result. Props only matter to &lt;span style=&quot;font-family: Courier New&quot;&gt;memo&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="240" width="346" height="46" as="geometry"/></mxCell><mxCell id="b-24" value="&amp;lt;Page&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="434" y="296" width="150" height="28" as="geometry"/></mxCell><mxCell id="t-25" value="setState" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="296" width="152" height="28" as="geometry"/></mxCell><mxCell id="a-26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="446" y="322" as="sourcePoint"/><mxPoint x="446" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-27" value="" style="edgeStyle=none;rounded=0;html=1;