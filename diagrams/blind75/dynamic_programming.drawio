vetica;fontStyle=2" vertex="1" parent="1"><mxGeometry x="44" y="342" width="356" height="16" as="geometry"/></mxCell><mxCell id="p-24" value="Fill a table once, left to right" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="436" y="70" width="360" height="296" as="geometry"/></mxCell><mxCell id="pl-25" value="O(n)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="716" y="76" width="66" height="20" as="geometry"/></mxCell><mxCell id="t-26" value="dp[i] = dp[i − 1] + dp[i − 2]" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="456" y="108" width="320" height="16" as="geometry"/></mxCell><mxCell id="b-27" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="456" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-28" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="512" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-29" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="568" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-30" value="2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="624" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-31" value="3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="680" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-32" value="5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="736" y="138" width="52" height="38" as="geometry"/></mxCell><mxCell id="t-33" value="0" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="456" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-34" value="1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="512" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-35" value="2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="568" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-36" value="3" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="624" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-37" value="4" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="680" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-38" value="5" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="736" y="177" width="52" height="14" as="geometry"/></mxCell><mxCell id="t-39" value="base cases fixed — then each cell only ever looks back" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="456" y="196" width="320" height="16" as="geometry"/></mxCell><mxCell id="a-40" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;curved=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="762" y="132" as="sourcePoint"/><mxPoint x="650" y="132" as="targetPoint"/><Array as="points"><mxPoint x="706" y="118"/></Array></mxGeometry></mxCell><mxCell id="b-41" value="Because each cell only needs the last two, the whole array collapses to two variables — O(1) space." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="456" y="222" width="320" height="54" as="geometry"/></mxCell><mxCell id="b-42" value="&lt;b&gt;Top-down&lt;/b&gt; memoisation gets the same result: keep the recursion, add a cache, return early on a hit." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="456" y="288" width="320" height="62" as="geometry"/></mxCell><mxCell id="p-43" value="The four questions, in this order" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="384" width="772" height="178" as="geometry"/></mxCell><mxCell id="pl-44" value="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="418" width="22" height="22" as="geometry"/></mxCell><mxCell id="t-45" value="State" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="76" y="418" width="100" height="22" as="geometry"/></mxCell><mxCell id="t-46" value="What does &lt;span style=&quot;font-family: Courier New&quot;&gt;dp[i]&lt;/span&gt; mean in one plain sentence?" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="184" y="418" width="330" height="22" as="geometry"/></mxCell><mxCell id="b-47" value="“fewest coins that make i”" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="522" y="418" width="256" height="22" as="geometry"/></mxCell><mxCell id="pl-48" value="2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="452" width="22" height="22" as="geometry"/></mxCell><mxCell id="t-49" value="Base case" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="76" y="452" width="100" height="22" as="geometry"/></mxCell><mxCell id="t-50" value="The smallest input you can answer outright." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="184" y="452" width="330" height="22" as="geometry"/></mxCell><mxCell id="b-51" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;dp[0] = 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="522" y="452" width="256" height="22" as="geometry"/></mxCell><mxCell id="pl-52" value="3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="486" width="22" height="22" as="geometry"/></mxCell><mxCell id="t-53" value="Recurrence" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="76" y="486" width="100" height="22" as="geometry"/></mxCell><mxCell id="t-54" value="How &lt;span style=&quot;font-family: Courier New&quot;&gt;dp[i]&lt;/span&gt; is built from earlier entries." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="184" y="486" width="330" height="22" as="geometry"/></mxCell><mxCell id="b-55" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;dp[i] = min(dp[i − c] + 1)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="522" y="486" width="256" height="22" as="geometry"/></mxCell><mxCell id="pl-56" value="4" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="520" width="22" height="22" as="geometry"/></mxCell><mxCell id="t-57" value="Order &amp;amp; space" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="76" y="520" width="100" height="22" as="geometry"/></mxCell><mxCell id="t-58" value="Iterate so inputs exist before you need them." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="184" y="520" width="330" height="22" as="geometry"/></mxCell><mxCell id="b-59" value="keep 2 vars, not N" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="522" y="520" width="256" height="22" as="geometry"/></mxCell><mxCell id="b-60" value="&lt;b&gt;The tell:&lt;/b&gt; a recursion that keeps asking the same question. If the tree repeats a node, cache it — exponential collapses to linear." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="578" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>