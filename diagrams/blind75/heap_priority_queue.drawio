ly=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="688" y="214" width="44" height="24" as="geometry"/></mxCell><mxCell id="b-30" value="↑ 3" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="740" y="158" width="60" height="24" as="geometry"/></mxCell><mxCell id="t-31" value="evicted" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#DC2626;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="740" y="182" width="76" height="14" as="geometry"/></mxCell><mxCell id="t-32" value="top →" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#5145E5;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="158" width="76" height="18" as="geometry"/></mxCell><mxCell id="b-33" value="The &lt;b&gt;smallest&lt;/b&gt; is always on top, so the heap evicts exactly the item least likely to belong in the answer. Whatever survives is the top K." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="254" width="360" height="62" as="geometry"/></mxCell><mxCell id="b-34" value="Sorting the whole stream is O(N log N) and throws away most of the work. Bounding the heap at K keeps each insert at log K." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="424" y="254" width="354" height="62" as="geometry"/></mxCell><mxCell id="p-35" value="Two heaps facing each other — the running median" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="358" width="772" height="168" as="geometry"/></mxCell><mxCell id="b-36" value="max-heap  ·  the smaller half" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="56" y="398" width="250" height="34" as="geometry"/></mxCell><mxCell id="b-37" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="56" y="440" width="56" height="34" as="geometry"/></mxCell><mxCell id="b-38" value="3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="116" y="440" width="56" height="34" as="geometry"/></mxCell><mxCell id="b-39" value="5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="176" y="440" width="56" height="34" as="geometry"/></mxCell><mxCell id="t-40" value="largest of the small half on top →" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="56" y="478" width="250" height="