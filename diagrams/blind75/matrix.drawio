#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="388" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-540" value="walk down along &lt;span style=&quot;font-family: Courier New&quot;&gt;right&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="420" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-541" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;right--&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="420" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-542" value="walk left along &lt;span style=&quot;font-family: Courier New&quot;&gt;bottom&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="452" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-543" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;bottom--&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="452" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-544" value="walk up along &lt;span style=&quot;font-family: Courier New&quot;&gt;left&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=