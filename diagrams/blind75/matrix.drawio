y"/></mxCell><mxCell id="b-48" value="10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=14;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="104" y="480" width="44" height="44" as="geometry"/></mxCell><mxCell id="b-49" value="11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=14;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="152" y="480" width="44" height="44" as="geometry"/></mxCell><mxCell id="b-50" value="12" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=14;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="200" y="480" width="44" height="44" as="geometry"/></mxCell><mxCell id="t-51" value="outer ring first, then tighten the walls" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="56" y="528" width="240" height="14" as="geometry"/></mxCell><mxCell id="b-52" value="walk right along &lt;span style=&quot;font-family: Courier New&quot;&gt;top&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="388" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-53" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;top++&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="388" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-54" value="walk down along &lt;span style=&quot;font-family: Courier New&quot;&gt;right&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="420" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-55" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;right--&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="420" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-56" value="walk left along &lt;span style=&quot;font-family: Courier New&quot;&gt;bottom&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="452" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-57" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;bottom--&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="452" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-58" value="walk up along &lt;span style=&quot;font-family: Courier New&quot;&gt;left&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="484" width="230" height="24" as="geometry"/></mxCell><mxCell id="t-59" value="then &lt;span style=&quot;font-family: Courier New&quot;&gt;left++&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="542" y="484" width="220" height="24" as="geometry"/></mxCell><mxCell id="b-60" value="&lt;b&gt;Stop when the walls cross.&lt;/b&gt; &lt;span style=&quot;font-family: Courier New&quot;&gt;while (top &amp;lt;= bottom &amp;amp;&amp;amp; left &amp;lt;= right)&lt;/span&gt; — forgetting the second check re-walks the middle row of an odd-sized grid." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="564" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>