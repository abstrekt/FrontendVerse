<mxfile host="app.diagrams.net" type="device"><diagram name="Linked Lists — pointer rewiring and fast/slow traversal" id="Linked Lists — pointer rewiring and fast/slow traversal"><mxGraphModel dx="820" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="820" pageHeight="700" math="0" shadow="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-137" value="Linked Lists" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1A1D26;fontSize=15;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0" y="14" width="820" height="24" as="geometry"/></mxCell><mxCell id="t-138" value="Two moves that cover most list questions" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=12;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="0" y="39" width="820" height="18" as="geometry"/></mxCell><mxCell id="p-139" value="In-place reversal — the three-pointer dance" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5145E5;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#1B1E5C;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="70" width="772" height="300" as="geometry"/></mxCell><mxCell id="b-140" value="null" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5F667A;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="116" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-141" value="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="130" y="116" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-142" value="2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="216" y="116" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-143" value="3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="302" y="116" width="52" height="38" as="geometry"/></mxCell><mxCell id="t-144" value="prev" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="122" y="94" width="68" height="16" as="geometry"/></mxCell><mxCell id="t-145" value="curr" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="208" y="94" width="68" height="16" as="geometry"/></mxCell><mxCell id="t-146" value="next" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="294" y="94" width="68" height="16" as="geometry"/></mxCell><mxCell id="a-147" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="182" y="135" as="sourcePoint"/><mxPoint x="216" y="135" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-148" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="268" y="135" as="sourcePoint"/><mxPoint x="302" y="135" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-149" value="Before — &lt;span style=&quot;font-family: Courier New&quot;&gt;prev&lt;/span&gt; trails, &lt;span style=&quot;font-family: Courier New&quot;&gt;curr&lt;/span&gt; is where you are" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="166" width="340" height="16" as="geometry"/></mxCell><mxCell id="b-150" value="null" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5F667A;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="214" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-151" value="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="130" y="214" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-152" value="2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="216" y="214" width="52" height="38" as="geometry"/></mxCell><mxCell id="b-153" value="3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=13;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="302" y="214" width="52" height="38" as="geometry"/></mxCell><mxCell id="t-154" value="prev" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="122" y="192" width="68" height="16" as="geometry"/></mxCell><mxCell id="t-155" value="curr" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="208" y="192" width="68" height="16" as="geometry"/></mxCell><mxCell id="t-156" value="next" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="294" y="192" width="68" height="16" as="geometry"/></mxCell><mxCell id="a-157" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5145E5;strokeWidth=2;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="216" y="233" as="sourcePoint"/><mxPoint x="182" y="233" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-158" value="rewired backwards" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5145E5;fontSize=10;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="140" y="174" width="120" height="14" as="geometry"/></mxCell><mxCell id="a-159" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.6;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="268" y="233" as="sourcePoint"/><mxPoint x="302" y="233" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-160" value="After one turn — &lt;span style=&quot;font-family: Courier New&quot;&gt;curr.next&lt;/span&gt; now points backwards" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="264" width="340" height="16" as="geometry"/></mxCell><mxCell id="pl-161" value="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="116" width="22" height="22" as="geometry"/></mxCell><mxCell id="b-162" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;const next = curr.next&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="462" y="112" width="316" height="30" as="geometry"/></mxCell><mxCell id="t-163" value="Save the rest of the list first." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="462" y="144" width="316" height="16" as="geometry"/></mxCell><mxCell id="pl-164" value="2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="178" width="22" height="22" as="geometry"/></mxCell><mxCell id="b-165" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;curr.next = prev&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="462" y="174" width="316" height="30" as="geometry"/></mxCell><mxCell id="t-166" value="Flip this one arrow." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="462" y="206" width="316" height="16" as="geometry"/></mxCell><mxCell id="pl-167" value="3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="240" width="22" height="22" as="geometry"/></mxCell><mxCell id="b-168" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;prev = curr; curr = next&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=middle;spacingLeft=10;shadow=0" vertex="1" parent="1"><mxGeometry x="462" y="236" width="316" height="30" as="geometry"/></mxCell><mxCell id="t-169" value="Shuffle both pointers forward." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="462" y="268" width="316" height="16" as="geometry"/></mxCell><mxCell id="b-170" value="&lt;b&gt;Order matters.&lt;/b&gt; Overwrite &lt;span style=&quot;font-family: Courier New&quot;&gt;curr.next&lt;/span&gt; before saving it and the rest of the list is gone." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7A1414;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="430" y="306" width="348" height="46" as="geometry"/></mxCell><mxCell id="b-171" value="Three pointers, one arrow flipped per turn, no extra memory." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="306" width="366" height="46" as="geometry"/></mxCell><mxCell id="p-172" value="Fast &amp; slow pointers — Floyd’s tortoise and hare" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="390" width="772" height="218" as="geometry"/></mxCell><mxCell id="c-173" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="56" y="452" width="40" height="40" as="geometry"/></mxCell><mxCell id="c-174" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="116" y="452" width="40" height="40" as="geometry"/></mxCell><mxCell id="a-175" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96" y="472" as="sourcePoint"/><mxPoint x="116" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c-176" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="176" y="452" width="40" height="40" as="geometry"/></mxCell><mxCell id="a-177" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="156" y="472" as="sourcePoint"/><mxPoint x="176" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c-178" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="246" y="452" width="40" height="40" as="geometry"/></mxCell><mxCell id="c-179" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="316" y="424" width="40" height="40" as="geometry"/></mxCell><mxCell id="c-180" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="372" y="472" width="40" height="40" as="geometry"/></mxCell><mxCell id="c-181" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="512" width="40" height="40" as="geometry"/></mxCell><mxCell id="a-182" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="216" y="472" as="sourcePoint"/><mxPoint x="246" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-183" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282" y="458" as="sourcePoint"/><mxPoint x="316" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-184" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="352" y="450" as="sourcePoint"/><mxPoint x="386" y="472" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-185" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="506" as="sourcePoint"/><mxPoint x="340" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-186" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A0B8;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="520" as="sourcePoint"/><mxPoint x="266" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-187" value="slow +1 · fast +2" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="56" y="418" width="180" height="16" as="geometry"/></mxCell><mxCell id="t-188" value="they must meet inside the loop" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="246" y="552" width="180" height="16" as="geometry"/></mxCell><mxCell id="b-189" value="Find the middle" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="424" width="334" height="30" as="geometry"/></mxCell><mxCell id="t-190" value="When &lt;span style=&quot;font-family: Courier New&quot;&gt;fast&lt;/span&gt; reaches the end, &lt;span style=&quot;font-family: Courier New&quot;&gt;slow&lt;/span&gt; is standing on it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="444" y="454" width="334" height="18" as="geometry"/></mxCell><mxCell id="b-191" value="Detect a cycle" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="480" width="334" height="30" as="geometry"/></mxCell><mxCell id="t-192" value="If a loop exists, &lt;span style=&quot;font-family: Courier New&quot;&gt;fast&lt;/span&gt; laps &lt;span style=&quot;font-family: Courier New&quot;&gt;slow&lt;/span&gt; — they collide." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="444" y="510" width="334" height="18" as="geometry"/></mxCell><mxCell id="b-193" value="No cycle" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="444" y="536" width="334" height="30" as="geometry"/></mxCell><mxCell id="t-194" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;fast&lt;/span&gt; or &lt;span style=&quot;font-family: Courier New&quot;&gt;fast.next&lt;/span&gt; hits &lt;span style=&quot;font-family: Courier New&quot;&gt;null&lt;/span&gt; and you are done." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="444" y="566" width="334" height="18" as="geometry"/></mxCell><mxCell id="b-195" value="&lt;b&gt;The sentinel trick:&lt;/b&gt; when the head itself might be removed or replaced, start from &lt;span style=&quot;font-family: Courier New&quot;&gt;const dummy = { next: head }&lt;/span&gt; and return &lt;span style=&quot;font-family: Courier New&quot;&gt;dummy.next&lt;/span&gt;. It deletes most of the null-checking." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="622" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>