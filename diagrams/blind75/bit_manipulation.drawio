endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="172" y="418" as="sourcePoint"/><mxPoint x="172" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-105" value="n &amp;= n − 1" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="184" y="416" width="140" height="16" as="geometry"/></mxCell><mxCell id="b-106" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="160" y="432" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-107" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="193" y="432" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-108" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="226" y="432" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-109" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="259" y="432" width="30" height="30" as="geometry"/></mxCell><mxCell id="t-110" value="n = 0" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="64" y="432" width="88" height="30" as="geometry"/></mxCell><mxCell id="t-111" value="count 2 — done" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="301" y="432" width="220" height="30" as="geometry"/></mxCell><mxCell id="b-112" value="Subtracting 1 flips the lowest &lt;span style=&quot;font-family: Courier New&quot;&gt;1&lt;/span&gt; and fills the zeros below it. ANDing puts every one of those bits back to &lt;span style=&quot;font-family: Courier New&quot;&gt;0&lt;/span&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="448" y="340" width="336" height="60" as="geometry"/></mxCell><mxCell id="b-113" value="The loop runs once per &lt;b&gt;set bit&lt;/b&gt;, not once per the 32 bits in the word." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="448" y="412" width="336" height="60" as="geometry"/></mxCell><mxCell id="p-114" value="Worth memorising" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="512" width="772" height="74" as="geometry"/></mxCell><mxCell id="b-115" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;n &amp; 1&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="546" width="104" height="24" as="geometry"/></mxCell><mxCell id="t-116" value="odd?" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="570" width="168" height="14" as="geometry"/></mxCell><mxCell id="b-117" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;n &gt;&gt; 1&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="232" y="546" width="104" height="24" as="geometry"/></mxCell><mxCell id="t-118" value="halve" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="232" y="570" width="168" height="14" as="geometry"/></mxCell><mxCell id="b-119" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;n &amp; (1 &lt;&lt; k)&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="420" y="546" width="104" height="24" as="geometry"/></mxCell><mxCell id="t-120" value="is bit k set?" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="570" width="168" height="14" as="geometry"/></mxCell><mxCell id="b-121" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;n &amp; -n&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="608" y="546" width="104" height="24" as="geometry"/></mxCell><mxCell id="t-122" value="lowest set bit" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="570" width="168" height="14" as="geometry"/></mxCell><mxCell id="b-123" value="&lt;b&gt;JavaScript caveat:&lt;/b&gt; every bitwise operator truncates to 32 signed bits, and &lt;span style=&quot;font-family: Courier New&quot;&gt;&gt;&gt;&lt;/span&gt; keeps the sign. Use &lt;span style=&quot;font-family: Courier New&quot;&gt;&gt;&gt;&gt;&lt;/span&gt; when you want the unsigned result." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="602" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>