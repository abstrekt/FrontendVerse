        <UserObject label="1. XOR Cancellation (Single Number):&#xa;x ^ x = 0 and x ^ 0 = x&#xa;XOR-ing an entire array cancels all pairs, leaving the unique element!" mermaidId="n:B_XOR" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="1. XOR Cancellation (Single Number):&#xa;x ^ x = 0 and x ^ 0 = x&#xa;XOR-ing an entire array cancels all pairs, leaving the unique element!" id="3">
