int x="140" y="240" as="sourcePoint"/><mxPoint x="280" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-25" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="140" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-26" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=12;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="173" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-27" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="206" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-28" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=12;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="239" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="t-29" value="result" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="44" y="248" width="88" height="30" as="geometry"/></mxCell><mxCell id="t-30" value="4 survives" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="281" y="248" width="220" height="30" as="geometry"/></mxCell><mxCell id="b-31" value="&lt;span style=&quot;font-family: Courier New&quot;&gt;x ^ x = 0&lt;/span&gt;  and  &lt;span style=&quot;font-family: Courier New&quot;&gt;x ^ 0 = x&lt;/span&gt;.&lt;br/&gt;XOR is order-independent, so every duplicate annihilates itself no matter where it sits." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="448" y="132" width="336" height="60" as="geometry"/></mxCell><mxCell id="b-32" value="That means one integer of memory replaces a whole hash map — and one pass replaces a sort." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="448" y="204" width="336" height="64" as="geometry"/></mxCell><mxCell id="p-33" value="n &amp;amp; (n − 1) clears the lowest 1 — counting set bits" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="302" width="772" height="196" as="geometry"/></mxCell><mxCell id="b-34" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="160" y="340" width="30" height="30" as="geometry"/></mxCell><mxCell id="b-35" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1"