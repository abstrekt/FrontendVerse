or=#94A0B8;strokeWidth=0.8;dashed=1;dashPattern=5 4;startArrow=none;startFill=0;endArrow=none;endFill=0;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458" y="124" as="sourcePoint"/><mxPoint x="458" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-18" value="12" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="446" y="104" width="24" height="14" as="geometry"/></mxCell><mxCell id="t-19" value="Disjoint" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="132" width="118" height="22" as="geometry"/></mxCell><mxCell id="b-20" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F6FE;strokeColor=#0EA5E9;strokeWidth=1.5;fontColor=#084C68;fontSize=11;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="170" y="132" width="96" height="20" as="geometry"/></mxCell><mxCell id="b-21" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="314" y="156" width="120" height="20" as="geometry"/></mxCell><mxCell id="t-22" value="startB &amp;gt; endA" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="476" y="132" width="130" height="20" as="geometry"/></mxCell><mxCell id="t-23" value="keep both" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="476" y="156" width="150" height="20" as="geometry"/></mxCell><mxCell id="t-24" value="Overlapping" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="192" width="118" height="22" as="geometry"/></mxCell><mxCell id="b-25" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="170" y="192" width="144" height="20" as="geometry"/></mxCell><mxCell id="b-26" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="266" y="216" width="168" height="20" as="geometry"/></mxCell><mxCell id="t-27" value="startB ≤ endA" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="476" y="192" width="130" height="20" as="geometry"/></mxCell><mxCell id="t-28" value="merge into one" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="476" y="216" width="150" height="20" as="geometry"/></mxCell><mxCell id="t-29" value="Contained" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=12;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="266" width="118" height="22" as="geometry"/></mxCell><mxCell id="b-30" value="A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=11;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="170" y="266" width="264" height="20" as="geometry"/></mxCell><mxCell id="b-31" value="B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="242" y="290" width="96" height="20" as="geometry"/></mxCell><mxCell id="t-32" value="endB ≤ endA" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="476" y="266" width="130" height="20" as="geometry"/></mxCell><mxCell id="t-33" value="B is swallowed" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=10;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="476" y="290" width="150" height="20" as="geometry"/></mxCell><mxCell id="b-34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.4;dashed=1;dashPattern=6 4;fontColor=#5F667A;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="266" y="188" width="48" height="52" as="geometry"/></mxCell><mxCell id="t-35" value="the overlap" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="236" y="242" width="108" height="14" as="geometry"/></mxCell><mxCell id="b-36" value="Because A starts first, B can only begin &lt;b&gt;inside&lt;/b&gt; A or &lt;b&gt;after&lt;/b&gt; it. There is no third possibility — and that is the whole algorithm." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="44" y="320" width="732" height="38" as="geometry"/></mxCell><mxCell id="p-37" value="The sweep — one pass, after sorting" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#16A34A;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#0A4A25;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="394" width="772" height="210" as="geometry"/></mxCell><mxCell id="t-38" value="sorted input" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="430" width="96" height="22" as="geometry"/></mxCell><mxCell id="b-39" value="[1,3]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="180" y="430" width="60" height="20" as="geometry"/></mxCell><mxCell id="b-40" value="[2,6]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="210" y="452" width="120" height="20" as="geometry"/></mxCell><mxCell id="b-41" value="[8,10]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="390" y="430" width="60" height="20" as="geometry"/></mxCell><mxCell id="b-42" value="[15,18]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="600" y="430" width="90" height="20" as="geometry"/></mxCell><mxCell id="t-43" value="result" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="494" width="96" height="22" as="geometry"/></mxCell><mxCell id="b-44" value="[1,6]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="180" y="494" width="150" height="20" as="geometry"/></mxCell><mxCell id="b-45" value="[8,10]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="390" y="494" width="60" height="20" as="geometry"/></mxCell><mxCell id="b-46" value="[15,18]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=10;fontFamily=Courier New;fontStyle=1;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="600" y="494" width="90" height="20" as="geometry"/></mxCell><mxCell id="a-47" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=1.5;startArrow=none;startFill=0;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#5F667A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="474" as="sourcePoint"/><mxPoint x="270" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-48" value="merged" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#16A34A;fontSize=10;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="278" y="474" width="110" height="16" as="geometry"/></mxCell><mxCell id="pl-49" value="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="526" width="20" height="20" as="geometry"/></mxCell><mxCell id="t-50" value="Sort by start: &lt;span style=&quot;font-family: Courier New&quot;&gt;intervals.sort((a, b) =&amp;gt; a[0] - b[0])&lt;/span&gt;" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="74" y="526" width="700" height="20" as="geometry"/></mxCell><mxCell id="pl-51" value="2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="550" width="20" height="20" as="geometry"/></mxCell><mxCell id="t-52" value="Seed the result with the first interval." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="74" y="550" width="700" height="20" as="geometry"/></mxCell><mxCell id="pl-53" value="3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="574" width="20" height="20" as="geometry"/></mxCell><mxCell id="t-54" value="For each next one: overlaps the last result? extend its end. Otherwise push it." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="74" y="574" width="700" height="20" as="geometry"/></mxCell><mxCell id="b-55" value="&lt;b&gt;Sorting is the algorithm.&lt;/b&gt; Unsorted, a new meeting could clash with anything — O(N²). Sorted, it can only clash with its immediate predecessor." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF6E7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#6B3A05;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=14;shadow=0" vertex="1" parent="1"><mxGeometry x="24" y="618" width="772" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>