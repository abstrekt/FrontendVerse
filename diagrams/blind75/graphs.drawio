;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="148" width="190" height="60" as="geometry"/></mxCell><mxCell id="b-463" value="DFS — recursion or a stack" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#5145E5;strokeWidth=1.5;fontColor=#1B1E5C;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;shadow=0" vertex="1" parent="1"><mxGeometry x="456" y="268" width="320" height="28" as="geometry"/></mxCell><mxCell id="t-464" value="Goes deep before wide. Connected components, cycle detection, flood fill — anything where reaching everything matters more than reaching it first." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="456" y="300" width="326" height="56" as="geometry"/></mxCell><mxCell id="p-465" value="Topological sort — resolving prerequisites" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0EA5E9;strokeWidth=1.5;verticalAlign=top;align=left;fontColor=#084C68;fontSize=13;fontFamily=Helvetica;fontStyle=1;spacingLeft=12;spacingTop=6" vertex="1" parent="1"><mxGeometry x="24" y="388" width="772" height="182" as="geometry"/></mxCell><mxCell id="c-466" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=13;fontFamily=Courier New;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="432" width="44" height="44" as="geometry"/></mxCell><mxCell id="t-467" value="in-degree 0" style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F667A;fontSize=9;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="54" y="478" width="56" height="14" as="geometry"/></mxCell><mxCell id="c-468" v