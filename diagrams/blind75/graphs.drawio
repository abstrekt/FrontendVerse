Courier New&quot;&gt;islands++&lt;/span&gt;." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="288" y="158" width="120" height="36" as="geometry"/></mxCell><mxCell id="pl-451" value="3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="258" y="206" width="20" height="20" as="geometry"/></mxCell><mxCell id="t-452" value="Run &lt;span style=&quot;font-family: Courier New&quot;&gt;dfs&lt;/span&gt; from it and sink everything connected." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="288" y="202" width="120" height="36" as="geometry"/></mxCell><mxCell id="pl-453" value="4" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9FBF0;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0A4A25;fontSize=11;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="258" y="250" width="20" height="20" as="geometry"/></mxCell><mxCell id="t-454" value="Sunken land is never counted twice." style="html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5F667A;fontSize=11;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="288" y="246" width="120" height="36" as="geometry"/></mxCell><mxCell id="b-455" value="const DIRS = [[0,1],[1,0],[0,-1],[-1,0]]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6FA;strokeColor=#94A0B8;strokeWidth=1.5;fontColor=#1A1D26;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;shadow=0" vertex="1" parent="1"><mxGeometry x="48" y="322" width="356" height="34" as="geometry"/></mxCell><mxCell id="p-456" value="Which traversal, and why" style="