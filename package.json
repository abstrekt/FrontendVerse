{
  "name": "js-mcq-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "build:diagrams": "node scripts/generate-blind75-diagrams.mjs",
    "build:traces": "node scripts/apply-blind75-traces.mjs",
    "build:output-questions": "node scripts/build-output-questions.mjs",
    "format:snippets": "node scripts/format-code-snippets.mjs",
    "scan:mcq-duplicates": "node scripts/scan-mcq-duplicates.mjs",
    "validate:learning-ids": "node scripts/validate-learning-ids.mjs",
    "audit:mcq-explanations": "node scripts/audit-mcq-explanations.mjs",
    "test": "node --test 'src/**/*.test.js' && node scripts/validate-learning-ids.mjs && node scripts/apply-blind75-traces.mjs --check",
    "build:data-manifest": "node scripts/build-data-manifest.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.5.3",
    "vite": "^6.3.5"
  }
}
